# Never commit keypair files, anywhere in the repo, even disposable/devnet ones.
*-keypair.json
*keypair*.json
deployer*.json

# Never commit anything under a folder or file named like wallet/key storage.
Wallets/
wallets/
*wallet*keys*
*Wallet*Keys*
*.env
*seed*phrase*
*private*key*

# Dependencies
node_modules/

# Anchor/Rust build output (regeneratable, not source; program keypairs
# under target/deploy/ are covered by the *-keypair.json rule above too)
program/*/target/
program/*/.anchor/
program/*/Cargo.lock

# Local Solana test validator data (large, regeneratable, not source)
devnet/test-ledger/
*.log

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
