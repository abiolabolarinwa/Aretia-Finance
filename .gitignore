# Never commit keypair files, anywhere in the repo, even disposable/devnet ones.
*-keypair.json
*keypair*.json
deployer*.json

# Never commit anything under a folder or file named like wallet/key storage.
Wallets/
wallets/
*wallet*keys*
*Wallet*Keys*
*.env
*seed*phrase*
*private*key*

# Dependencies
node_modules/

# Anchor/Rust build output (regeneratable, not source; program keypairs
# under target/deploy/ are covered by the *-keypair.json rule above too)
program/*/target/
program/*/.anchor/
program/*/Cargo.lock

# SDK build output (regeneratable via `npm run build`, not source)
sdk/*/dist/

# Local Solana test validator data (large, regeneratable, not source)
devnet/test-ledger/
*.log

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Astro website build
website/node_modules/
website/dist/
website/.astro/

# TradingView's licensed charting library. It may not be redistributed and this repository is public, so it is
# fetched at build time (website/scripts/fetch-charting-library.ts) and never committed.
website/public/charting_library/

# Local env files (API keys, provider secrets). .env.example is allowed.
.env
.env.*
!.env.example
program/*/tests/Cargo.lock
program/*/curve-math/proptest-regressions/

# Mainnet curve creation data (generated by website/scripts/curve-mainnet.mjs; deploy by hand, never commit)
deploy-out/
