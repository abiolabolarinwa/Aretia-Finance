# Copy to .env (or run `node bin/make-keys.mjs`, which writes a .env with fresh random secrets) and then:  chmod 600 .env
# .env is in .gitignore. Never commit it, never paste it into chat. Every value below is a placeholder.

# ---- Database (make-keys.mjs generates these) ----
POSTGRES_PASSWORD=CHANGE_ME
AUTHENTICATOR_PASSWORD=CHANGE_ME
# Signs the keys the site presents. 32+ random characters.
JWT_SECRET=CHANGE_ME
# A signed key with role service_role, made by make-keys.mjs from JWT_SECRET. This is what the site and the worker send.
SERVICE_ROLE_KEY=CHANGE_ME

# ---- Public address ----
# A name you own that points (DNS "A" record) at this server, e.g. data.aretiafinance.org. Caddy gets the https certificate for it.
DATA_HOSTNAME=data.example.org
ACME_EMAIL=you@example.org
# Requests per minute per IP address that Caddy allows, and the largest request body.
RATE_PER_MINUTE=1200
MAX_BODY=2MB

# ---- Scheduler (replaces pg_cron + pg_net) ----
SITE_URL=https://aretiafinance.org
# The same secrets the site has as CRON_SECRET / MI_CRON_SECRET on Vercel.
CRON_SECRET=
MI_CRON_SECRET=
# Which scheduled site endpoints to call: alerts (every minute), launchbox (every 5 minutes), mi (the old HTTP indexer run, every minute).
# Leave `mi` out once the worker runs.
SCHEDULER_JOBS=alerts,launchbox
# Optional: a dead-man's-switch URL (e.g. from healthchecks.io); pinged after each alerts run succeeds.
SCHEDULER_PING_URL=

# ---- Indexer worker (phase 2) ----
MI_ADAPTERS=
MI_RPC_BNB=
MI_RPC_ETHEREUM=
MI_RPC_POLYGON=
MI_RPC_BASE=
SOLANA_RPC_URL=

# ---- Backups (read by bin/backup.sh; the private key never goes on this server) ----
# Public age recipient (starts with "age1"). Make the pair on your own computer with `age-keygen`.
AGE_RECIPIENT=
# rclone remote name and folder, e.g. onedrive:aretia-backups  (set up once with `rclone config`)
RCLONE_REMOTE=onedrive:aretia-backups
KEEP_DAILY=14
KEEP_WEEKLY=8
# Pinged when a backup finishes (append /fail on failure). Same idea as SCHEDULER_PING_URL.
BACKUP_PING_URL=

# ---- Monitoring (read by bin/check-disk.sh) ----
DISK_ALERT_PERCENT=80
DISK_PING_URL=
