# Copy to .env (or run `node bin/make-keys.mjs`, which writes a .env with fresh random secrets) and then:  chmod 600 .env
# .env is in .gitignore. Never commit it, never paste it into chat. Every value below is a placeholder.

# ---- Database (make-keys.mjs generates these) ----
POSTGRES_PASSWORD=CHANGE_ME
AUTHENTICATOR_PASSWORD=CHANGE_ME
# Signs the keys the site presents. 32+ random characters.
JWT_SECRET=CHANGE_ME
# A signed key with role service_role, made by make-keys.mjs from JWT_SECRET. This is what the site and the worker send.
SERVICE_ROLE_KEY=CHANGE_ME

# ---- Public address ----
# A name you own that points (DNS "A" record) at this server, e.g. data.aretiafinance.org. Caddy gets the https certificate for it.
DATA_HOSTNAME=data.example.org
ACME_EMAIL=you@example.org
# Requests per minute per IP address that Caddy allows, and the largest request body.
RATE_PER_MINUTE=1200
MAX_BODY=2MB

# ---- Scheduler (replaces pg_cron + pg_net) ----
SITE_URL=https://aretiafinance.org
# The same secrets the site has as CRON_SECRET / MI_CRON_SECRET on Vercel.
CRON_SECRET=
MI_CRON_SECRET=
# Which scheduled site endpoints to call: alerts (every minute), launchbox (every 5 minutes), mi (the old HTTP indexer run, every minute).
# Leave `mi` out once the worker runs.
SCHEDULER_JOBS=alerts,launchbox
# Optional: a dead-man's-switch URL (e.g. from healthchecks.io); pinged after each alerts run succeeds.
SCHEDULER_PING_URL=

# ---- Indexer worker (phase 2) ----
MI_ADAPTERS=
# Walk each BNB Chain V2/V3 factory's creation events back this many days (0 = off) and register pools with real liquidity.
MI_BACKFILL_DAYS=0
MI_BACKFILL_ADAPTERS=
MI_BACKFILL_MIN_LIQUIDITY_USD=
# Reserves refresher (liquidity from the pools' on-chain reserves): on unless set to 0.
# A pool with no stored trade stays "active" only until MI_INACTIVE_AFTER_HOURS (default 168 = 7 days) after its creation:
# set it to at least MI_BACKFILL_DAYS x 24 or the backfilled pools older than a week will be listed as inactive.
MI_REFRESH=1
MI_MIN_LIQUIDITY_USD=
MI_INACTIVE_AFTER_HOURS=
MI_FOLLOW_NEWEST=
MI_FOLLOW_RECENT=
# Chains (comma list, e.g. ethereum,base) whose V2/V3 swaps are read chain-wide by event instead of by pool address: covers every registered
# pool with a few requests per block range instead of hundreds. Empty = off. See website/docs/market-indexer-worker.md.
MI_SWAP_SCAN=
# Swap-history backfill: how many days of past swaps to read for the pools already held, on the chains in MI_SWAP_SCAN, so quiet pools have
# 24-hour figures. 0/empty = off. Capped to MI_TRADE_RETENTION_DAYS (default 14): older trades would be pruned. MI_SWAP_BACKFILL_ADAPTERS
# (comma list of adapter ids) limits which adapters do it. See website/docs/market-indexer-worker.md.
MI_SWAP_BACKFILL_DAYS=
MI_SWAP_BACKFILL_ADAPTERS=
# Solana: list the pools a venue already has (getProgramAccounts, filtered to SOL/USDC/USDT pools) and keep their liquidity current. `*` for all
# venues or a comma list of adapter ids (raydium-cpmm-solana, orca-whirlpool-solana, pumpswap-solana, ...). Empty = off. Needs a Solana node that
# allows getProgramAccounts (public nodes refuse it). See website/docs/market-indexer-worker.md.
MI_SOLANA_DISCOVERY=
MI_SOLANA_DISCOVERY_MAX=
MI_TRADE_RETENTION_DAYS=
MI_RPC_BNB=
MI_RPC_ETHEREUM=
MI_RPC_POLYGON=
MI_RPC_BASE=
SOLANA_RPC_URL=

# ---- Backups (read by bin/backup.sh; the private key never goes on this server) ----
# Public age recipient (starts with "age1"). Make the pair on your own computer with `age-keygen`.
AGE_RECIPIENT=
# rclone remote name and folder, e.g. onedrive:aretia-backups  (set up once with `rclone config`)
RCLONE_REMOTE=onedrive:aretia-backups
KEEP_DAILY=14
KEEP_WEEKLY=8
# Pinged when a backup finishes (append /fail on failure). Same idea as SCHEDULER_PING_URL.
BACKUP_PING_URL=

# ---- Monitoring (read by bin/check-disk.sh) ----
DISK_ALERT_PERCENT=80
DISK_PING_URL=
