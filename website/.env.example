# Copy to .env.local (git-ignored) for local work. In production set these in Vercel as Sensitive variables.
# Never commit real values. Names only here.

ZEROX_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
EVM_RPC_ETHEREUM=
EVM_RPC_BNB=
EVM_RPC_POLYGON=
EVM_RPC_BASE=

# WalletConnect project id (public, from the WalletConnect Cloud dashboard). Leave empty to hide WalletConnect.
PUBLIC_WALLETCONNECT_PROJECT_ID=

# Wallet sign-in (favourites, referrals, alerts, ramp links). Set SWINGS_SESSION_SECRET to its own long random value
# (e.g. `openssl rand -hex 32`); until it is set, sessions are signed with a key derived from SUPABASE_SERVICE_ROLE_KEY and a
# warning is logged. Changing it signs everyone out. It also signs referral captures and recovery-record write tokens.
SWINGS_SESSION_SECRET=
# Hosts a sign-in message may name, comma-separated (e.g. aretiafinance.org,www.aretiafinance.org). Empty: the hosts of the
# allowed origins (aretiafinance.org, www.aretiafinance.org and RPC_ALLOWED_ORIGINS).
SWINGS_LOGIN_DOMAINS=
# Launch pictures and token details (website/docs/LAUNCH_ASSETS.md): the name of the public Supabase Storage bucket. Empty: launch-assets.
# Until that bucket exists, the Launch page says image upload is not set up yet and everything else works.
LAUNCH_ASSETS_BUCKET=

# Owner admin page (/owner-admin, docs/admin-page.md). Wallet addresses allowed to see it, comma-separated: 0x... or a Solana
# address. Empty: the page's API answers 404 to everyone. Also needs migration 0016_admin_counters.sql.
ADMIN_WALLETS=
