# Copy to .env.local (git-ignored) for local work. In production set these in Vercel as Sensitive variables.
# Never commit real values. Names only here.

ZEROX_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
EVM_RPC_ETHEREUM=
EVM_RPC_BNB=
EVM_RPC_POLYGON=
EVM_RPC_BASE=

# WalletConnect project id (public, from the WalletConnect Cloud dashboard). Leave empty to hide WalletConnect.
PUBLIC_WALLETCONNECT_PROJECT_ID=

# The address that receives the 0.58% Aretia fee on EVM networks (a public value, read at BUILD time: set it in the deployment
# environment and redeploy after any change). Without it every EVM swap is paused with a plain message instead of being let through
# without the fee. Solana's fee goes to the fee wallet in src/swings/core/solanaTools.ts and needs no setting.
PUBLIC_ARETIA_EVM_FEE_ADDRESS=
