<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Status and navigation bars in the page colour: light grey with dark icons, or near-black with light icons in night mode (values-night). -->
        <item name="android:windowBackground">@color/aretia_bars</item>
        <item name="android:statusBarColor">@color/aretia_bars</item>
        <item name="android:navigationBarColor">@color/aretia_bars</item>
        <item name="android:windowLightStatusBar">@bool/aretia_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/aretia_light_bars</item>
    </style>


    <!-- The launch screen: the app icon on indigo (not the default white), leading into the indigo opening the page plays. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/aretia_indigo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/aretia_indigo</item>
        <item name="android:statusBarColor">@color/aretia_indigo</item>
        <item name="android:navigationBarColor">@color/aretia_indigo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>