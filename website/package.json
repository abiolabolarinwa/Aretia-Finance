{
  "name": "aretia-finance-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-charting-library.ts && astro dev",
    "build": "node scripts/fetch-charting-library.ts && astro build",
    "fetch:charting-library": "node scripts/fetch-charting-library.ts",
    "preview": "astro preview",
    "typecheck": "astro check",
    "app:sync": "cap sync",
    "app:android": "cap open android",
    "app:ios": "cap open ios",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:curve-devnet": "vitest run --config vitest.devnet.config.ts src/scripts/walletCurve.devnet.ts",
    "test:orders-devnet": "vitest run --config vitest.devnet.config.ts src/scripts/walletOrders.devnet.ts",
    "test:curve-fork": "vitest run --config vitest.devnet.config.ts src/scripts/walletCurveEvm.fork.ts",
    "db:migrate": "node scripts/apply-migrations.ts",
    "readiness": "node scripts/readiness.ts",
    "alerts:check": "node scripts/alerts-check.ts"
  },
  "dependencies": {
    "@bonfida/spl-name-service": "^4.0.1",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@meteora-ag/cp-amm-sdk": "1.4.9",
    "@noble/curves": "1.9.7",
    "@solana/web3.js": "^1.99.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "@walletconnect/universal-provider": "^2.25.0",
    "astro": "^7.3.5",
    "bn.js": "5.2.5",
    "buffer": "^6.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "bigint-buffer": "npm:@trufflesuite/bigint-buffer@1.1.10",
    "uuid": "11.1.1"
  }
}
