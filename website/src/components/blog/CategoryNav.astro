---
import { BLOG_CATEGORIES } from '../../content.config';
import { categorySlug } from '../../lib/blog';

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<nav class="cats" aria-label="Blog categories" data-reveal>
  <a href="/blog" aria-current={!active ? 'page' : undefined}>All</a>
  {
    BLOG_CATEGORIES.map((c) => (
      <a href={`/blog/category/${categorySlug(c)}`} aria-current={active === c ? 'page' : undefined}>
        {c}
      </a>
    ))
  }
</nav>

<style>
  .cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--space-xl); }
  .cats a { padding: 0.5rem 1rem; border-radius: var(--radius-pill); border: 1px solid var(--color-border); font-size: var(--text-small); color: var(--color-muted); transition: color var(--duration-fast), border-color var(--duration-fast), background-color var(--duration-fast); min-height: 40px; display: inline-flex; align-items: center; }
  .cats a[aria-current='page'] { color: var(--color-bg); background: var(--color-strong); border-color: var(--color-strong); }
  @media (hover: hover) and (pointer: fine) {
    .cats a:hover { color: var(--color-strong); border-color: var(--color-border-strong); }
  }
</style>
