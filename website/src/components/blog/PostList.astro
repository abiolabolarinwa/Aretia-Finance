---
import type { CollectionEntry } from 'astro:content';
import { paperClass, twoDigits } from '../../lib/paper';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

{
  posts.length === 0 ? (
    <p class="empty">No articles in this category yet.</p>
  ) : (
    <ul class="posts">
      {posts.map((post, i) => (
        <li data-reveal class:list={[{ 'posts__feature': i === 0 }]}>
          <a href={`/blog/${post.id}`} class="post">
            <div class:list={['post__art', paperClass(i, ['brand', 'mint', 'ink', 'bright'])]} data-n={twoDigits(i + 1)} aria-hidden="true">
              <span class="post__art-cat">{post.data.category}</span>
            </div>
            <div class="post__body">
              <div class="post__meta">
                <span class="post__cat">{post.data.category}</span>
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              </div>
              <h2 class="post__title">{post.data.title}</h2>
              <p class="post__desc">{post.data.description}</p>
              <span class="post__read">Read article →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  .posts__feature { grid-column: 1 / -1; }
  .post { display: grid; gap: var(--space-md); height: 100%; }
  .posts__feature .post { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: var(--space-xl); }
  .post__art { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-lg); --mark-size: clamp(8rem, 18vw, 13rem); transition: transform var(--duration-base) var(--ease-out); }
  .post__art-cat { position: absolute; left: 20px; bottom: 16px; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 600; letter-spacing: -0.03em; color: var(--c-fg); }
  .post__body { display: grid; gap: 0.7rem; align-content: start; }
  .post__meta { display: flex; gap: 1rem; font-size: var(--text-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-faint); }
  .post__cat { color: var(--color-gold); }
  .post__title { font-size: clamp(1.4rem, 2.4vw, 2rem); letter-spacing: -0.025em; line-height: 1.15; transition: color var(--duration-base); }
  .post__desc { color: var(--color-muted); }
  .post__read { font-size: var(--text-small); font-weight: 600; color: var(--color-strong); }
  .empty { color: var(--color-faint); padding-block: var(--space-xl); }
  @media (max-width: 800px) {
    .posts { grid-template-columns: minmax(0, 1fr); }
    .posts__feature .post { grid-template-columns: minmax(0, 1fr); }
  }
  @media (hover: hover) and (pointer: fine) {
    .post:hover .post__art { transform: translateY(-3px); }
    .post:hover .post__title { color: var(--color-gold-bright); }
  }
</style>
