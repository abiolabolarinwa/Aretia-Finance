---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'gold' | 'ghost';
  size?: 'md' | 'lg';
  arrow?: boolean;
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', arrow = false, external = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span class="btn__label"><slot /></span>
  {
    arrow && (
      <span class="btn__arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    )
  }
</a>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    border-radius: var(--radius-pill); font-weight: 500; letter-spacing: -0.01em; white-space: nowrap;
    border: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .btn--md { height: 44px; padding: 0 1.25rem; font-size: 0.9375rem; }
  .btn--lg { height: 52px; padding: 0 1.5rem; font-size: 1.0625rem; }
  .btn--primary { background: var(--color-brand-bright); color: #fff; }
  .btn--secondary { border-color: var(--color-border-strong); color: var(--color-strong); }
  .btn--gold { background: var(--color-gold-bright); color: #fff; }
  .btn--ghost { color: var(--color-brand-bright); padding-inline: 0.25rem; }
  .btn__arrow { display: inline-flex; transition: transform var(--duration-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover { background: var(--color-brand); }
    .btn--secondary:hover { border-color: var(--color-strong); background: rgba(0, 0, 0, 0.03); }
    .btn--gold:hover { background: var(--color-gold); }
    .btn--ghost:hover .btn__label { text-decoration: underline; }
    .btn:hover .btn__arrow { transform: translateX(2px); }
  }
</style>
