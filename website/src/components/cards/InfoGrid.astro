---
import StatusBadge from '../ui/StatusBadge.astro';
import type { Status } from '../../data/site';
import { paperClass, twoDigits } from '../../lib/paper';

interface Item {
  title: string;
  detail: string;
  status?: Status;
  href?: string;
}
interface Props {
  items: Item[];
  columns?: 2 | 3;
}
const { items, columns = 3 } = Astro.props;
---

<ul class:list={['ig', `ig--${columns}`]}>
  {
    items.map((item, i) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li data-reveal>
          <Tag class:list={['ig__card', paperClass(i)]} data-n={twoDigits(i + 1)} {...(item.href ? { href: item.href } : {})}>
            <h3 class="ig__title">{item.title}</h3>
            <p class="ig__detail">{item.detail}</p>
            {item.status && <StatusBadge status={item.status} class="ig__badge" />}
            {item.href && (
              <span class="ig__go" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            )}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  /* Each card is its own sheet of coloured paper with its number printed in
     (see .paper in global.css), laid out as separate cards rather than one
     hairline-divided table. */
  .ig { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ig--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ig--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ig li { display: flex; }
  .ig__card {
    flex: 1; display: grid; align-content: start; gap: 0.75rem; min-height: 230px;
    padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .ig__title { font-size: 1.25rem; letter-spacing: -0.02em; line-height: 1.25; color: var(--c-fg); }
  .ig__detail { color: var(--c-muted); font-size: var(--text-small); line-height: 1.6; max-width: 34ch; }
  .ig__card :global(.ig__badge) { justify-self: start; margin-top: 0.25rem; }
  .ig__go { position: absolute; top: 1.25rem; right: 1.25rem; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: var(--c-accent-fg); background: var(--c-accent); transition: transform var(--duration-fast) var(--ease-out); }
  @media (max-width: 960px) { .ig--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ig--3, .ig--2 { grid-template-columns: minmax(0, 1fr); } .ig__card { min-height: 0; } }
  @media (hover: hover) and (pointer: fine) {
    a.ig__card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -22px rgba(14, 11, 43, 0.35); }
    a.ig__card:hover .ig__go { transform: translateX(3px); }
  }
</style>
