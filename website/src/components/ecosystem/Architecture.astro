---
import { PRODUCTS, STATUS_LABEL, ACT } from '../../data/site';

export interface MapNode {
  id: string;
  label: string;
  x: number;
  /** 0–72, in the map's coordinate space. */
  y: number;
  kind: 'core' | 'product' | 'act' | 'chain' | 'climate';
  text: string;
  status: string;
}

interface Props {
  id?: string;
  nodes?: MapNode[];
  edges?: [string, string][];
  intro?: { title: string; text: string };
}

const byId = Object.fromEntries(PRODUCTS.map((p) => [p.slug, p]));

const defaultNodes: MapNode[] = [
  { id: 'wallet', label: 'Aretia Wallet', x: 50, y: 12, kind: 'core', text: byId.wallet!.summary, status: STATUS_LABEL[byId.wallet!.status] },
  { id: 'universal', label: 'Aretia Universal', x: 50, y: 44, kind: 'core', text: byId.universal!.summary, status: STATUS_LABEL[byId.universal!.status] },
  { id: 'shield', label: 'Shield', x: 14, y: 22, kind: 'product', text: byId.shield!.summary, status: STATUS_LABEL[byId.shield!.status] },
  { id: 'intent', label: 'Intent', x: 86, y: 22, kind: 'product', text: byId.intent!.summary, status: STATUS_LABEL[byId.intent!.status] },
  { id: 'pay', label: 'Pay', x: 86, y: 44, kind: 'product', text: byId.pay!.summary, status: STATUS_LABEL[byId.pay!.status] },
  { id: 'act', label: 'ACT', x: 14, y: 44, kind: 'act', text: 'Aretia’s token, live on Solana mainnet. Its 1.5% transfer fee funds the Climate Treasury and operations.', status: 'Live' },
  { id: 'climate', label: 'Climate Treasury', x: 19, y: 56, kind: 'climate', text: `${ACT.transferFee.split.find((s) => s.label === 'Climate Treasury')!.percent}% of every ACT transfer, routed to a 2-of-3 multisig and disbursed against verified milestones.`, status: 'Live' },
  { id: 'solana', label: 'Solana', x: 20, y: 64, kind: 'chain', text: 'Where ACT is minted and where the NTT hub locks it when bridging.', status: 'Supported' },
  { id: 'ethereum', label: 'Ethereum', x: 50, y: 64, kind: 'chain', text: 'EVM home of bridged ACT (Sepolia testnet today) and ENS names for Aretia Pay.', status: 'Supported' },
  { id: 'evm', label: 'Base · BNB · Polygon', x: 80, y: 64, kind: 'chain', text: 'Additional EVM networks the wallet supports from the same account.', status: 'Supported' },
];

const defaultEdges: [string, string][] = [
  ['wallet', 'universal'], ['wallet', 'shield'], ['wallet', 'intent'], ['wallet', 'pay'],
  ['universal', 'solana'], ['universal', 'ethereum'], ['wallet', 'evm'],
  ['act', 'solana'], ['act', 'universal'], ['act', 'climate'], ['pay', 'ethereum'],
];

const {
  id = 'architecture',
  nodes = defaultNodes,
  edges = defaultEdges,
  intro = { title: 'Aretia architecture', text: 'Every Aretia product plugs into one wallet; Universal carries ACT between chains.' },
} = Astro.props;
const pos = Object.fromEntries(nodes.map((n) => [n.id, n]));
---

<div class="arch" data-arch>
  <div class="arch__map">
    <svg class="arch__lines" viewBox="0 0 100 72" preserveAspectRatio="none" aria-hidden="true">
      {
        edges.map(([a, b]) => (
          <line data-edge={`${a} ${b}`} x1={pos[a]!.x} y1={pos[a]!.y} x2={pos[b]!.x} y2={pos[b]!.y} vector-effect="non-scaling-stroke" />
        ))
      }
    </svg>
    {
      nodes.map((n) => (
        <button
          type="button"
          class:list={['arch__node', `arch__node--${n.kind}`]}
          style={`left:${n.x}%;top:${(n.y / 72) * 100}%`}
          data-node={n.id}
          data-text={n.text}
          data-status={n.status}
          aria-describedby={`${id}-detail`}
        >
          {n.label}
        </button>
      ))
    }
  </div>
  <div class="arch__detail" id={`${id}-detail`} aria-live="polite">
    <span class="arch__detail-status" data-detail-status>Hover or tap a component</span>
    <b data-detail-title>{intro.title}</b>
    <p data-detail-text>{intro.text}</p>
  </div>
</div>

<style>
  .arch { display: grid; gap: var(--space-lg); }
  .arch__map { position: relative; aspect-ratio: 100 / 72; }
  .arch__lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* Bold by default -- the connections are the point of this diagram, not a
     faint hint under the nodes. Lit state goes bolder still, not just gold. */
  .arch__lines line { stroke: rgba(11, 61, 46, 0.4); stroke-width: 2.5; stroke-linecap: round; transition: stroke var(--duration-base), stroke-width var(--duration-base); }
  .arch__lines line.is-lit { stroke: var(--color-gold); stroke-width: 3.5; }
  .arch.has-focus .arch__lines line:not(.is-lit) { stroke: rgba(11, 61, 46, 0.12); }
  .arch__node { position: absolute; translate: -50% -50%; padding: 10px 16px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; color: var(--color-text); background: var(--color-surface-2); border: 1px solid var(--color-border-strong); transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base), background-color var(--duration-base), opacity var(--duration-base), box-shadow var(--duration-base); }
  .arch__node--core { padding: 14px 22px; font-size: 14px; background: var(--color-brand); border-color: rgba(15, 107, 75, 0.5); color: #ffffff; box-shadow: 0 0 40px -10px rgba(15, 107, 75, 0.7); }
  .arch__node--act { color: var(--color-gold-bright); border-color: rgba(160, 122, 44, 0.5); background: var(--color-gold-soft); }
  .arch__node--chain { background: var(--color-bg-alt); }
  .arch__node--climate { color: #86efac; border-color: rgba(27, 138, 75, 0.4); background: rgba(27, 138, 75, 0.08); }
  .arch.has-focus .arch__node:not(.is-active):not(.is-linked) { opacity: 0.4; }
  .arch__detail { display: grid; gap: 6px; padding: 20px 22px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-bg-alt); min-height: 118px; }
  .arch__detail-status { font-size: var(--text-micro); font-weight: 600; color: var(--color-gold); }
  .arch__detail b { font-family: var(--font-display); font-size: 1.25rem; color: var(--color-strong); letter-spacing: -0.02em; }
  .arch__detail p { color: var(--color-muted); font-size: var(--text-small); }
  @media (max-width: 720px) {
    .arch__map { aspect-ratio: 100 / 110; }
    /* padding alone gave these pills ~27px of tap height; min-height brings
       every node up to the 44px touch-target floor without growing the label text. */
    .arch__node { font-size: 11px; padding: 7px 10px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
    .arch__node--core { font-size: 12px; padding: 9px 13px; min-height: 44px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .arch__node:hover, .arch__node:focus-visible, .arch__node.is-active { transform: scale(1.08); border-color: var(--color-gold); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-arch]').forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const lines = [...root.querySelectorAll<SVGLineElement>('[data-edge]')];
    const status = root.querySelector<HTMLElement>('[data-detail-status]')!;
    const title = root.querySelector<HTMLElement>('[data-detail-title]')!;
    const text = root.querySelector<HTMLElement>('[data-detail-text]')!;
    const initial = { status: status.textContent, title: title.textContent, text: text.textContent };

    const focus = (node: HTMLButtonElement | null) => {
      root.classList.toggle('has-focus', !!node);
      const id = node?.dataset.node;
      const linked = new Set<string>();
      lines.forEach((l) => {
        const [a, b] = (l.dataset.edge ?? '').split(' ');
        const lit = !!id && (a === id || b === id);
        l.classList.toggle('is-lit', lit);
        if (lit) { linked.add(a!); linked.add(b!); }
      });
      nodes.forEach((n) => {
        n.classList.toggle('is-active', n === node);
        n.classList.toggle('is-linked', linked.has(n.dataset.node!));
      });
      status.textContent = node ? node.dataset.status ?? '' : initial.status;
      title.textContent = node ? node.textContent?.trim() ?? '' : initial.title;
      text.textContent = node ? node.dataset.text ?? '' : initial.text;
    };

    nodes.forEach((n) => {
      n.addEventListener('pointerenter', () => focus(n));
      n.addEventListener('focus', () => focus(n));
      n.addEventListener('click', () => focus(n));
    });
    root.querySelector('.arch__map')!.addEventListener('pointerleave', () => {
      if (!root.contains(document.activeElement) || document.activeElement === document.body) focus(null);
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) focus(null);
    });
  });
</script>
