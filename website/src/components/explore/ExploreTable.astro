---
import StatusBadge from '../ui/StatusBadge.astro';
import { PRODUCTS, ACT, NETWORKS, STATUS_LABEL, type Status } from '../../data/site';

interface Row {
  name: string;
  role: string;
  summary: string;
  where: string;
  status: Status;
  href: string;
  glyph: string;
  kind: 'wallet' | 'act' | 'plain';
}

const WHERE: Record<string, string> = {
  wallet: `${NETWORKS.length} networks`,
  universal: 'Solana ↔ Ethereum',
  safesend: 'Testnet; contracts on BNB Chain and Polygon',
  pay: 'ENS and .sol names',
  shield: 'Inside the wallet',
  intent: 'Inside the wallet',
};
const HREF: Record<string, string> = { wallet: '/wallet', universal: '/features#universal', pay: '/features#pay', shield: '/features#shield', intent: '/features#intent', safesend: '/features#safesend' };

const rows: Row[] = [
  ...PRODUCTS.map((p) => ({
    name: p.name,
    role: p.role,
    summary: p.summary,
    where: WHERE[p.slug],
    status: p.status,
    href: HREF[p.slug],
    glyph: p.name.replace('Aretia ', '').charAt(0),
    kind: (p.slug === 'wallet' ? 'wallet' : 'plain') as Row['kind'],
  })),
  {
    name: ACT.ticker,
    role: 'Ecosystem token',
    summary: `A fixed-supply ${ACT.standard} mint on Solana; every transfer funds the Climate Treasury.`,
    where: 'Solana mainnet',
    status: 'live' as Status,
    href: '/token',
    glyph: 'A',
    kind: 'act' as const,
  },
];

const filters = (['live', 'built', 'testnet', 'in-development'] as Status[]).filter((s) => rows.some((r) => r.status === s));
const treasury = ACT.transferFee.split.find((s) => s.label === 'Climate Treasury')!.percent;
const stats = [
  { label: 'ACT supply', value: ACT.totalSupply.toLocaleString('en-US') },
  { label: 'Transfer fee', value: `${ACT.transferFee.totalPercent}%` },
  { label: 'To Climate Treasury', value: `${treasury}%` },
  { label: 'Mint authority', value: 'Revoked' },
  { label: 'Networks', value: String(NETWORKS.length) },
];
/** Official network marks; source and license in public/assets/chains/CREDITS.md. */
const networks = [
  { name: 'Solana', note: 'Wallet · ACT · bridge (testnet)', logo: '/assets/chains/solana.png' },
  { name: 'Ethereum', note: 'Wallet · bridge (testnet)', logo: '/assets/chains/ethereum.png' },
  { name: 'Base', note: 'Wallet', logo: '/assets/chains/base.png' },
  { name: 'BNB Smart Chain', note: 'Wallet', logo: '/assets/chains/bnb.png' },
  { name: 'Polygon', note: 'Wallet', logo: '/assets/chains/polygon.png' },
];
---

<section class="explore section" id="explore" aria-labelledby="explore-title">
  <div class="container">
    <header class="explore__head" data-reveal>
      <h2 id="explore-title" class="explore__title">Explore Aretia</h2>
      <div class="explore__filters" role="group" aria-label="Filter by status" data-explore-filters>
        <button type="button" class="pill is-active" data-filter="all" aria-pressed="true">All</button>
        {filters.map((s) => <button type="button" class="pill" data-filter={s} aria-pressed="false">{STATUS_LABEL[s]}</button>)}
      </div>
    </header>

    <dl class="ticker" data-reveal>
      {stats.map((s) => (
        <div class="ticker__item">
          <dt>{s.label}</dt>
          <dd class="tnum">{s.value}</dd>
        </div>
      ))}
    </dl>

    <ul class="catalog" data-explore-rows data-reveal>
      {rows.map((r, i) => (
        <li class:list={['card', `card--${r.kind}`]} data-status={r.status}>
          <div class="card__top">
            <span class="card__idx tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <StatusBadge status={r.status} />
          </div>

          <div class="card__id">
            <span class="glyph" aria-hidden="true">{r.glyph}</span>
            <div>
              <h3 class="card__name"><a href={r.href}>{r.name}</a></h3>
              <p class="card__role">{r.role}</p>
            </div>
          </div>

          <p class="card__summary">{r.summary}</p>

          {r.kind === 'wallet' && (
            <ul class="card__chains" aria-label="Supported networks">
              {networks.map((n) => (
                <li><img src={n.logo} alt={n.name} width="40" height="40" loading="lazy" /></li>
              ))}
            </ul>
          )}
          {r.kind === 'act' && (
            <dl class="card__facts">
              <div><dt>Fixed supply</dt><dd class="tnum">{ACT.totalSupply.toLocaleString('en-US')}</dd></div>
              <div><dt>Mint authority</dt><dd>Revoked</dd></div>
            </dl>
          )}

          <div class="card__foot">
            <span class="card__where">{r.where}</span>
            <span class="card__go" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="16" height="16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </div>
        </li>
      ))}
    </ul>

    <div class="band" data-reveal>
      <header class="band__head">
        <h3>Networks</h3>
        <p>One recovery phrase across five networks, as the wallet ships.</p>
      </header>
      <ul class="nets">
        {networks.map((n) => (
          <li>
            <img src={n.logo} alt="" width="48" height="48" loading="lazy" />
            <span class="nets__name">{n.name}</span>
            <small>{n.note}</small>
          </li>
        ))}
      </ul>
    </div>

    <div class="band" data-reveal>
      <header class="band__head">
        <h3>ACT utilities</h3>
        <p>What the token does today, and what is still ahead.</p>
      </header>
      <ul class="utils">
        {ACT.utilities.map((u) => (
          <li>
            <div class="utils__top">
              <span class="utils__name">{u.name}</span>
              <StatusBadge status={u.status} />
            </div>
            <p>{u.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .explore__head { display: grid; justify-items: center; gap: var(--space-md); text-align: center; margin-bottom: var(--space-lg); }
  .explore__title { font-size: var(--text-heading); color: var(--color-brand); }
  .explore__filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .pill {
    height: 36px; padding: 0 16px; border-radius: var(--radius-pill); font-size: 0.875rem; font-weight: 500;
    background: var(--color-bg-alt); color: var(--color-strong);
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .pill.is-active { background: var(--color-brand); color: #fff; }

  /* Five facts as a measured strip: label over a large figure, hairline rules
     between, so the numbers read before the catalogue starts. */
  .ticker { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0 0 var(--space-lg); border-block: 1px solid var(--color-border-strong); }
  .ticker__item { display: grid; gap: 4px; padding: 20px 20px 22px; border-left: 1px solid var(--color-border); }
  .ticker__item:first-child { border-left: 0; padding-left: 4px; }
  .ticker dt { font-size: 0.8125rem; color: var(--color-muted); }
  .ticker dd { margin: 0; font-size: clamp(1.25rem, 2.2vw, 1.875rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; color: var(--color-strong); }

  /* The catalogue: wallet is the anchor (two columns, two rows), ACT closes
     the grid across three. Filtering drops the spans so any subset reflows
     into an even grid instead of leaving holes. */
  .catalog { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 16px; }
  .card--wallet { grid-column: span 2; grid-row: span 2; }
  .card--act { grid-column: span 3; }
  .catalog[data-filtered] .card--wallet, .catalog[data-filtered] .card--act { grid-column: auto; grid-row: auto; }

  .card {
    position: relative; display: flex; flex-direction: column; gap: 14px; min-height: 270px; padding: 22px;
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); background: var(--color-surface);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .card[hidden] { display: none; }
  .card__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .card__idx { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; color: var(--color-faint); }
  .card__id { display: flex; align-items: center; gap: 12px; }
  .card__name { font-size: 1.1875rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .card__name a { color: inherit; }
  .card__name a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card__role { font-size: 0.8125rem; color: var(--color-muted); }
  .card__summary { font-size: 0.9375rem; line-height: 1.55; color: var(--color-muted); }
  .card__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--color-border); }
  .card__where { font-size: 0.8125rem; font-weight: 500; color: var(--color-text); }
  .card__go { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: var(--color-strong); background: var(--color-bg-alt); transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }

  .glyph { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-size: 1rem; font-weight: 600; background: var(--color-bg-alt); color: var(--color-strong); }
  .card[data-status='live'] .glyph, .card[data-status='built'] .glyph { background: var(--color-brand); color: var(--color-mint); }

  /* Wallet: the one committed-green tile, with its five networks as marks. */
  .card--wallet { padding: clamp(24px, 3vw, 36px); justify-content: flex-start; background: var(--color-brand); border-color: var(--color-brand); color: #fff; }
  .card--wallet .card__idx { color: rgba(255, 255, 255, 0.55); }
  .card--wallet .card__name { font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.05; }
  .card--wallet .card__role { color: rgba(255, 255, 255, 0.7); font-size: 0.9375rem; }
  .card--wallet .card__summary { max-width: 28rem; font-size: clamp(1.0625rem, 1.4vw, 1.25rem); color: rgba(255, 255, 255, 0.82); }
  .card--wallet .glyph { width: 52px; height: 52px; border-radius: 14px; font-size: 1.25rem; background: var(--color-mint); color: var(--color-brand); }
  .card--wallet .card__foot { margin-top: 18px; border-top-color: rgba(255, 255, 255, 0.2); }
  .card--wallet .card__where { color: rgba(255, 255, 255, 0.85); }
  .card--wallet .card__go { background: #fff; color: var(--color-brand); }
  .card--wallet .card__name a, .card--act .card__name a { color: #fff; }
  .card__chains { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .card__chains li { width: 44px; height: 44px; border-radius: 12px; overflow: hidden; background: #fff; }
  .card__chains img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* ACT: ink-dark with a gold figure -- gold is this site's fee-layer colour. */
  .card--act { background: var(--color-strong); border-color: var(--color-strong); color: #fff; min-height: 0; }
  .card--act .card__idx { color: rgba(255, 255, 255, 0.55); }
  .card--act .card__role { color: rgba(255, 255, 255, 0.65); }
  .card--act .card__summary { max-width: 34rem; color: rgba(255, 255, 255, 0.78); }
  .card.card--act .glyph { background: #e0bd6a; color: var(--color-strong); }
  .card--act .card__foot { border-top-color: rgba(255, 255, 255, 0.18); }
  .card--act .card__where { color: rgba(255, 255, 255, 0.85); }
  .card--act .card__go { background: #e0bd6a; color: var(--color-strong); }
  .card__facts { display: flex; flex-wrap: wrap; gap: 8px 40px; margin: 0; }
  .card__facts div { display: grid; gap: 2px; }
  .card__facts dt { font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .card__facts dd { margin: 0; font-size: clamp(1.375rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -0.03em; color: #e0bd6a; }

  /* StatusBadge is built for light grounds; on the two dark tiles it gets a
     light outline and white text so every status still reads. */
  .card--wallet :global(.badge), .card--act :global(.badge) { color: #fff; border-color: rgba(255, 255, 255, 0.4); background: rgba(255, 255, 255, 0.08); }

  /* Below the table: Networks and ACT utilities as two spec-sheet bands, a
     short label on the left and the detail on the right. */
  .band { display: grid; grid-template-columns: minmax(180px, 260px) minmax(0, 1fr); gap: var(--space-lg); padding-block: var(--space-lg); border-top: 1px solid var(--color-border-strong); }
  .catalog + .band { margin-top: var(--space-xl); }
  .band__head { display: grid; gap: 6px; align-content: start; }
  .band__head h3 { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; }
  .band__head p { font-size: 0.875rem; line-height: 1.5; color: var(--color-muted); }

  .nets { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .nets li { display: grid; gap: 4px; align-content: start; }
  .nets img { width: 48px; height: 48px; margin-bottom: 8px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px var(--color-border-strong); object-fit: cover; }
  .nets__name { font-size: 0.9375rem; font-weight: 600; color: var(--color-strong); }
  .nets small { font-size: 0.8125rem; line-height: 1.4; color: var(--color-muted); }

  .utils { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-lg); }
  .utils li { display: grid; gap: 6px; padding: 14px 0; border-bottom: 1px solid var(--color-border); }
  .utils li:nth-last-child(-n + 2) { border-bottom: 0; }
  .utils__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .utils__name { font-size: 1rem; font-weight: 600; color: var(--color-strong); }
  .utils p { font-size: 0.875rem; line-height: 1.5; color: var(--color-muted); max-width: 32rem; }

  @media (hover: hover) and (pointer: fine) {
    .pill:not(.is-active):hover { background: var(--color-surface-3); }
    .card:hover { transform: translateY(-3px); border-color: var(--color-brand-bright); box-shadow: 0 18px 40px -22px rgba(14, 11, 43, 0.28); }
    .card:hover .card__go { transform: translateX(3px); }
    .card:not(.card--wallet):not(.card--act):hover .card__go { background: var(--color-brand); color: #fff; }
  }
  .pill:active { transform: scale(0.97); }

  @media (max-width: 1100px) {
    .ticker { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ticker__item:nth-child(4) { border-left: 0; padding-left: 4px; }
    .catalog { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card--wallet { grid-row: auto; }
    .card--act { grid-column: span 2; }
    .band { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    .nets { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 16px; }
  }
  @media (max-width: 640px) {
    .ticker { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ticker__item { border-left: 0; padding-left: 4px; }
    .ticker__item:nth-child(even) { border-left: 1px solid var(--color-border); padding-left: 16px; }
    .catalog { grid-template-columns: minmax(0, 1fr); }
    .card--wallet, .card--act { grid-column: auto; }
    .card { min-height: 0; }
    .nets { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .utils { grid-template-columns: minmax(0, 1fr); }
    .utils li:nth-last-child(2) { border-bottom: 1px solid var(--color-border); }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-explore-filters]');
  const grid = document.querySelector<HTMLElement>('[data-explore-rows]');
  const cards = document.querySelectorAll<HTMLElement>('[data-explore-rows] > li');
  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const f = btn.dataset.filter;
    group.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      const on = b === btn;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    if (grid) {
      if (f === 'all') grid.removeAttribute('data-filtered');
      else grid.setAttribute('data-filtered', '');
    }
    cards.forEach((c) => (c.hidden = f !== 'all' && c.dataset.status !== f));
  });
</script>
