---
import { LINKS } from '../../data/site';

const columns = [
  {
    title: 'Products',
    links: [
      { label: 'Wallet', href: '/wallet' },
      { label: 'Universal', href: '/features#universal' },
      { label: 'Shield', href: '/features#shield' },
      { label: 'Intent', href: '/features#intent' },
      { label: 'Pay', href: '/features#pay' },
    ],
  },
  {
    title: 'Protocol',
    links: [
      { label: 'ACT', href: '/token' },
      { label: 'Tokenomics', href: '/token#fees' },
      { label: 'Climate Treasury', href: '/details' },
      { label: 'Ecosystem', href: '/ecosystem' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { label: 'Docs', href: '/docs' },
      { label: 'GitHub', href: LINKS.github, external: true },
      { label: 'Security', href: '/docs#security' },
      { label: 'Whitepaper', href: '/whitepaper' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Blog', href: '/blog' },
      { label: 'Support', href: '/support' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Telegram', href: LINKS.telegram, external: true },
      { label: 'Discord', href: LINKS.discord, external: true },
      { label: 'X', href: LINKS.x, external: true },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
      { label: 'Risk disclosure', href: '/terms#risk' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Aretia Finance home">
          <img src="/assets/logo-mark.png" alt="" width="32" height="32" />
          <span>Aretia Finance</span>
        </a>
        <p>Multichain financial infrastructure for payments, interoperability and climate finance.</p>
      </div>
      <nav class="footer__cols" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h2 class="footer__title">{col.title}</h2>
              <ul>
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} {...('external' in link && link.external ? { target: '_blank', rel: 'noopener' } : {})}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="footer__wordmark" aria-hidden="true">ARETIA</div>
    <div class="footer__bottom">
      <span>© 2026 Aretia Finance</span>
      <span>Nothing on this site is investment advice. Digital assets carry risk.</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-bg-alt); border-top: 1px solid var(--color-border); padding-top: var(--space-2xl); overflow: hidden; }
  .footer__top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: var(--space-xl); }
  .footer__logo { display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; color: var(--color-strong); }
  .footer__logo img { width: 32px; height: 32px; border-radius: 9px; }
  .footer__brand p { margin-top: 1rem; color: var(--color-faint); font-size: var(--text-small); max-width: 18rem; }
  .footer__cols { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-md); }
  .footer__title { font-family: var(--font-body); font-size: 0.8125rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-strong); margin-bottom: 0.9rem; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .footer ul a { font-size: 0.8125rem; color: var(--color-muted); transition: color var(--duration-fast); }
  .footer ul a:hover { color: var(--color-strong); }
  .footer__wordmark { font-family: var(--font-display); font-weight: 600; font-size: clamp(5rem, 22vw, 20rem); line-height: 0.8; letter-spacing: -0.06em; text-align: center; margin-top: var(--space-2xl); background: linear-gradient(180deg, rgba(0, 0, 0, 0.07), rgba(0, 0, 0, 0)); -webkit-background-clip: text; background-clip: text; color: transparent; user-select: none; }
  .footer__bottom { display: flex; justify-content: space-between; gap: var(--space-sm); flex-wrap: wrap; padding-block: var(--space-md); border-top: 1px solid var(--color-border); font-size: var(--text-micro); color: var(--color-faint); }
  @media (max-width: 960px) {
    .footer__top { grid-template-columns: minmax(0, 1fr); }
    .footer__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-lg); }
  }
  @media (max-width: 480px) {
    .footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
