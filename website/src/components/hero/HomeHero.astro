---
import Button from '../buttons/Button.astro';
import { LINKS } from '../../data/site';

const chains = ['Solana', 'Ethereum', 'Base', 'BNB Smart Chain', 'Polygon'];
---

<section class="hero" data-hero>
  <svg class="hero__rings" viewBox="0 0 1000 1000" aria-hidden="true">
    <circle cx="500" cy="500" r="220" /><circle cx="500" cy="500" r="330" /><circle cx="500" cy="500" r="440" />
  </svg>

  <div class="container hero__head">
    <a class="hero__pill" href="/token" data-hero-in>
      <span class="hero__pill-dot"></span>ACT is live on Solana mainnet
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
    <h1 class="hero__title" data-split="load" data-split-delay="0.1">Money that moves<br />with people.</h1>
    <p class="hero__lead" data-hero-in>
      One self-custody wallet across five chains, a check before every signature, and a treasury that funds climate projects.
    </p>
    <div class="hero__ctas" data-hero-in>
      <Button href={LINKS.launchWallet} size="lg" arrow>Launch Aretia Wallet</Button>
      <Button href="#ecosystem" size="lg" variant="ghost">Explore Aretia</Button>
    </div>
    <div class="hero__chains" data-hero-in>
      <span>Works across</span>
      <ul>{chains.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>

  <div class="container hero__photos">
    <figure class="photo photo--portrait" data-hero-photo>
      <img src="/images/people/woman-phone-standing.webp" alt="A smiling woman holding her phone at an outdoor gathering" width="933" height="1400" fetchpriority="high" />
      <span class="chip chip--top">Main account
        <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <div class="balance">
        <b class="tnum">12,480.00 <small>ACT</small></b>
        <span>Demo balance</span>
      </div>
    </figure>

    <figure class="photo photo--wide" data-hero-photo>
      <img src="/images/people/couple-selfie.webp" alt="Two friends laughing and taking a selfie in a park" width="1400" height="788" />
      <p class="photo__caption">Send to a name, not a string of characters. Aretia checks the recipient before you sign.</p>
      <div class="activity">
        <p class="activity__title">Recent activity</p>
        <ul>
          <li>
            <span class="activity__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="12" height="12"><path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="activity__main">Sent to vitalik.eth<small>Name resolved and shown before signing</small></span>
            <span class="activity__tag">Checked</span>
          </li>
        </ul>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; padding-top: calc(var(--nav-height) + clamp(2.5rem, 6vw, 4.5rem)); padding-bottom: var(--space-2xl); }
  .hero__rings { position: absolute; z-index: -1; left: 50%; top: calc(var(--nav-height) - 120px); width: min(1100px, 150vw); translate: -50% 0; fill: none; stroke: rgba(11, 61, 46, 0.07); stroke-width: 1; }

  .hero__head { display: grid; justify-items: center; text-align: center; gap: var(--space-md); }
  .hero__pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px 7px 12px; border-radius: var(--radius-pill);
    background: var(--color-mint); color: var(--color-brand); font-size: 0.875rem; font-weight: 500;
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .hero__pill:active { transform: scale(0.97); }
  .hero__pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-brand); }
  .hero__title { font-size: clamp(2.9rem, 7.4vw, 6rem); line-height: 0.98; letter-spacing: -0.05em; font-weight: 500; color: var(--color-brand); max-width: 14ch; }
  .hero__lead { max-width: 34rem; font-size: var(--text-lead); color: var(--color-muted); line-height: 1.5; }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.25rem; }
  .hero__ctas :global(.btn--primary) { background: var(--color-brand); box-shadow: 0 0 0 4px #fff, 0 0 0 5px rgba(11, 61, 46, 0.35); }
  .hero__ctas :global(.btn--ghost) { color: var(--color-strong); }
  .hero__chains { display: grid; gap: 0.6rem; justify-items: center; margin-top: var(--space-md); }
  .hero__chains > span { font-size: var(--text-small); color: var(--color-faint); }
  .hero__chains ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2.25rem; }
  .hero__chains li { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.02em; color: rgba(11, 61, 46, 0.55); }

  .hero__photos { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: 14px; margin-top: var(--space-2xl); }
  .photo { position: relative; margin: 0; border-radius: var(--radius-xl); overflow: hidden; background: var(--color-mint-soft); min-height: 460px; }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo--portrait img { object-position: 50% 20%; }
  .photo--wide img { object-position: 50% 35%; }
  .photo--wide::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 45%; z-index: 1; background: linear-gradient(180deg, rgba(7, 42, 32, 0.55), transparent); pointer-events: none; }

  .chip { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: var(--radius-pill); background: #fff; color: var(--color-strong); font-size: 0.8125rem; font-weight: 500; box-shadow: var(--shadow-soft); }
  .chip--top { top: 20px; right: 20px; }
  .balance { position: absolute; z-index: 2; left: 20px; bottom: 20px; display: grid; gap: 4px; padding: 16px 18px; border-radius: 18px; background: var(--color-mint); color: var(--color-brand); }
  .balance b { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .balance small { font-size: 0.8rem; font-weight: 600; }
  .balance span { font-size: 0.8125rem; }

  .photo__caption { position: absolute; z-index: 2; top: 24px; right: 28px; max-width: 22rem; color: #fff; font-size: 0.9375rem; line-height: 1.45; text-wrap: pretty; }
  .activity { position: absolute; z-index: 2; right: 20px; bottom: 20px; width: min(360px, calc(100% - 40px)); padding: 18px 20px; border-radius: 20px; background: var(--color-brand); color: #fff; box-shadow: var(--shadow-float); }
  .activity__title { font-size: 1rem; font-weight: 600; margin-bottom: 14px; }
  .activity ul { list-style: none; margin: 0; padding: 0; }
  .activity li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; }
  .activity__icon { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: rgba(94, 230, 168, 0.18); color: var(--color-mint); }
  .activity__main { display: grid; font-size: 0.875rem; font-weight: 500; }
  .activity__main small { font-size: 0.75rem; font-weight: 400; color: rgba(255, 255, 255, 0.68); }
  .activity__tag { font-size: 0.75rem; font-weight: 600; color: var(--color-brand); background: var(--color-mint); padding: 4px 10px; border-radius: var(--radius-pill); }

  :global(html.motion-ok) [data-hero-in] { opacity: 0; }
  :global(html.motion-ok) [data-hero-photo] { opacity: 0; }

  @media (hover: hover) and (pointer: fine) {
    .hero__pill:hover { background: #7df0bb; }
  }
  @media (max-width: 860px) {
    .hero__photos { grid-template-columns: minmax(0, 1fr); }
    .photo { min-height: 420px; }
    .photo--portrait { min-height: 480px; }
    .photo__caption { left: 22px; right: 22px; }
  }
  @media (max-width: 480px) {
    .hero__chains ul { gap: 0.4rem 1.25rem; }
    .hero__chains li { font-size: 1rem; }
    .hero__ctas :global(.btn--primary) { width: 100%; }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  if (!reducedMotion()) {
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.to('[data-hero-in]', { opacity: 1, y: 0, duration: 0.8, stagger: 0.06, startAt: { y: 14 } }, 0.35)
      .to('[data-hero-photo]', { opacity: 1, y: 0, scale: 1, duration: 1, stagger: 0.08, startAt: { y: 40, scale: 0.98 } }, 0.55)
      .from('[data-hero] .chip, [data-hero] .balance, [data-hero] .activity', { opacity: 0, y: 12, duration: 0.7, stagger: 0.08 }, 0.95);
  }
</script>
