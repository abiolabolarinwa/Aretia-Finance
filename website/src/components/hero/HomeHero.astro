---
import { LINKS, PRODUCTS, STATUS_LABEL, type Status } from '../../data/site';

const p = Object.fromEntries(PRODUCTS.map((x) => [x.slug, x]));
const liveChain = 'Solana';
const nextChains = ['Ethereum', 'Base', 'BNB Smart Chain', 'Polygon'];

/** Official network marks (see public/assets/chains/CREDITS.md for source/license). */
const CHAIN_LOGO: Record<string, string> = {
  Solana: '/assets/chains/solana.png',
  Ethereum: '/assets/chains/ethereum.png',
  Base: '/assets/chains/base.png',
  'BNB Smart Chain': '/assets/chains/bnb.png',
  Polygon: '/assets/chains/polygon.png',
};

interface Slide {
  eyebrow: string;
  status: Status;
  title: string;
  lead: string;
  cta: { label: string; href: string };
  photo: { src: string; alt: string; position: string };
}

const slides: Slide[] = [
  {
    eyebrow: 'Climate Catalyst Fund',
    status: 'live',
    title: 'Move money.<br />Fund the planet.',
    lead: 'Every ACT transfer carries a 1.5% fee, withheld on-chain — 1% builds the Climate Catalyst Fund, verifiable yourself.',
    cta: { label: 'Explore the Climate Treasury', href: '/details' },
    photo: { src: '/images/people/farmer-field.webp', alt: 'A farmer tending young crops in a green field', position: '22% 32%' },
  },
  {
    eyebrow: p.wallet!.name,
    status: p.wallet!.status,
    title: 'Every chain.<br />One wallet.',
    lead: p.wallet!.summary,
    cta: { label: 'Join the waitlist', href: LINKS.walletWaitlist },
    photo: { src: '/images/people/hero-wide.webp', alt: 'Two friends laughing and taking a selfie in a sunlit park', position: '62% 40%' },
  },
  {
    eyebrow: p.pay!.name,
    status: p.pay!.status,
    title: 'Send to a name,<br />not an address.',
    lead: p.pay!.summary,
    cta: { label: 'See Aretia Pay', href: '/features#pay' },
    photo: { src: '/images/people/woman-phone-smiling.webp', alt: 'A young woman smiling at her phone at a café table', position: '48% 16%' },
  },
  {
    eyebrow: p.shield!.name,
    status: p.shield!.status,
    title: 'Know before<br />you sign.',
    lead: p.shield!.summary,
    cta: { label: 'See Aretia Shield', href: '/features#shield' },
    photo: { src: '/images/people/man-phone-night.webp', alt: 'A man scrutinizing his phone carefully at night against a city building', position: '68% 28%' },
  },
  {
    eyebrow: p.safesend!.name,
    status: p.safesend!.status,
    title: 'A pause you<br />can take back.',
    lead: p.safesend!.summary,
    cta: { label: 'See Aretia SafeSend', href: '/features#safesend' },
    photo: { src: '/images/people/woman-smiling-warm.webp', alt: 'A woman smiling warmly, relaxed and unhurried', position: '46% 35%' },
  },
  {
    eyebrow: p.universal!.name,
    status: p.universal!.status,
    title: 'Across chains,<br />without the plumbing.',
    lead: p.universal!.summary,
    cta: { label: 'See Aretia Universal', href: '/features#universal' },
    photo: { src: '/images/people/woman-phone-walking.webp', alt: 'A woman in sunglasses walking down a city street, looking at her phone', position: '50% 28%' },
  },
  {
    eyebrow: p.intent!.name,
    status: p.intent!.status,
    title: 'Say what<br />you want.',
    lead: p.intent!.summary,
    cta: { label: 'See Aretia Intent', href: '/features#intent' },
    photo: { src: '/images/people/woman-phone-cafe.webp', alt: 'A woman delighted while typing on her phone in a warm café', position: '45% 30%' },
  },
];
---

<section class="hero" data-hero>
  <h1 class="sr-only">Aretia Finance — a climate-finance protocol and multichain wallet on Solana</h1>
  <div class="hero__frame" data-carousel aria-roledescription="carousel" aria-label="Aretia services">
    {
      slides.map((s, i) => (
        <div class="hero__slide" class:list={{ 'is-active': i === 0 }} data-slide={i} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${s.eyebrow}`} aria-hidden={i === 0 ? undefined : 'true'}>
          <img
            class="hero__img"
            src={s.photo.src}
            alt={s.photo.alt}
            style={`object-position:${s.photo.position}`}
            width="2400"
            height="1350"
            loading={i === 0 ? undefined : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
          <div class="hero__content">
            <p class="hero__eyebrow" data-hero-in>
              <span class="hero__eyebrow-mark" aria-hidden="true"></span>{s.eyebrow} <span class="hero__eyebrow-sep">/</span> {STATUS_LABEL[s.status]}
            </p>
            <p class="hero__title" data-hero-in set:html={s.title} />
            <p class="hero__lead" data-hero-in>{s.lead}</p>
            <div class="hero__ctas" data-hero-in>
              <a class="hbtn hbtn--solid" href={s.cta.href}>
                {s.cta.label}
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <a class="hbtn hbtn--ghost" href="#explore">Explore Aretia</a>
            </div>
          </div>
        </div>
      ))
    }

    <div class="hero__controls">
      <p class="hero__count tnum" aria-hidden="true"><span data-count-current>01</span><span class="hero__count-sep">/</span>{String(slides.length).padStart(2, '0')}</p>
      <button type="button" class="hero__arrow" data-prev aria-label="Previous slide">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m10 3.5-4.5 4.5L10 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <ol class="hero__dots" role="tablist" aria-label="Choose a slide">
        {
          slides.map((s, i) => (
            <li role="presentation">
              <button type="button" role="tab" data-dot={i} aria-label={`Show ${s.eyebrow}`} aria-selected={i === 0 ? 'true' : 'false'} />
            </li>
          ))
        }
      </ol>
      <button type="button" class="hero__arrow" data-next aria-label="Next slide">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="hero__pause" data-pause aria-label="Pause automatic slide rotation" aria-pressed="false">
        <svg data-icon-pause viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 3h2.5v10H4zM9.5 3H12v10H9.5z" fill="currentColor" /></svg>
        <svg data-icon-play class="is-hidden" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4.5 3 12.5 8 4.5 13Z" fill="currentColor" /></svg>
      </button>
    </div>

    <a class="hero__scroll" href="#explore">Scroll
      <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <div class="container hero__chains">
    <span>Live on</span>
    <ul class="hero__chains-live">
      <li>
        <span class="hero__chain-icon"><img src={CHAIN_LOGO[liveChain]} alt="" width="22" height="22" loading="lazy" /></span>
        <span class="sr-only">{liveChain}</span>
      </li>
    </ul>
    <span>Coming to</span>
    <ul class="hero__chains-next">
      {
        nextChains.map((c) => (
          <li>
            <span class="hero__chain-icon"><img src={CHAIN_LOGO[c]} alt="" width="22" height="22" loading="lazy" /></span>
            <span class="sr-only">{c}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero { padding: calc(var(--nav-height) + 8px) clamp(8px, 1.2vw, 16px) 0; }
  .hero__frame {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: min(calc(100svh - var(--nav-height) - 24px), 860px); min-height: max(560px, min(calc(100svh - var(--nav-height) - 24px), 860px));
    border-radius: 0; background: var(--color-brand);
  }
  .hero__slide { position: absolute; inset: 0; display: flex; align-items: center; opacity: 0; pointer-events: none; transition: opacity 700ms var(--ease-out); }
  .hero__slide.is-active { opacity: 1; pointer-events: auto; z-index: 1; }
  .hero__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  /* Scrim built from the same logo green as the rest of the page, not a
     separate near-black -- one brand color carries the whole site. */
  .hero__slide::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(11, 61, 46, 0.82) 0%, rgba(11, 61, 46, 0.52) 34%, rgba(11, 61, 46, 0) 62%), linear-gradient(0deg, rgba(11, 61, 46, 0.4), transparent 30%); }

  .hero__content { display: grid; justify-items: start; gap: 22px; width: min(100%, 860px); padding: clamp(24px, 6vw, 96px); color: #fff; }
  /* Tracked-out uppercase label, no pill chip -- a thin square mark instead
     of a soft glowing dot, and a hairline rule underneath rather than a
     background fill. Architectural-brief register, not a status badge. */
  .hero__eyebrow { display: inline-flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.3); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; }
  .hero__eyebrow-mark { width: 7px; height: 7px; background: var(--color-mint); flex: none; }
  .hero__eyebrow-sep { color: rgba(255, 255, 255, 0.45); }
  .hero__title { font-family: var(--font-topical); font-size: clamp(2rem, 4.4vw, 4.25rem); font-weight: 700; line-height: 1.04; letter-spacing: -0.005em; color: #fff; text-wrap: balance; }
  .hero__lead { max-width: 30rem; font-size: clamp(1.0625rem, 1.3vw, 1.25rem); line-height: 1.5; color: rgba(255, 255, 255, 0.9); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hbtn {
    display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 26px; border-radius: var(--radius-pill);
    font-size: 1rem; font-weight: 500; letter-spacing: -0.01em;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .hbtn:active { transform: scale(0.97); }
  .hbtn--solid { background: #fff; color: var(--color-brand); }
  .hbtn--ghost { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.7); }
  /* The global :focus-visible ring is brand-green -- invisible on this dark
     scrim. Every focusable element inside the hero gets a white ring instead. */
  .hero__frame :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .hero__scroll { position: absolute; z-index: 2; bottom: clamp(18px, 2.4vw, 32px); right: clamp(24px, 3vw, 40px); display: inline-flex; align-items: center; gap: 6px; font-size: 0.8125rem; color: rgba(255, 255, 255, 0.85); }

  .hero__controls { position: absolute; z-index: 2; left: clamp(24px, 6vw, 96px); bottom: clamp(18px, 2.4vw, 32px); display: flex; align-items: center; gap: 18px; }
  /* Large typographic slide count, not a dot -- the template's numbered-
     index motif. Thin rule under the arrows/dots instead of soft shadows. */
  .hero__count { display: flex; align-items: baseline; font-family: var(--font-topical); font-size: 1.375rem; font-weight: 700; color: #fff; letter-spacing: 0; }
  .hero__count-sep { margin: 0 3px; font-size: 0.75rem; font-weight: 500; color: rgba(255, 255, 255, 0.45); }
  .hero__count::after { content: ''; width: 1px; height: 20px; margin-left: 16px; background: rgba(255, 255, 255, 0.3); }
  .hero__arrow, .hero__pause { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 0; color: #fff; border: 1px solid rgba(255, 255, 255, 0.45); transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out); }
  .hero__pause { width: 30px; height: 30px; }
  .hero__pause .is-hidden { display: none; }
  .hero__dots { list-style: none; display: flex; align-items: center; gap: 8px; margin: 0; padding: 0; }
  .hero__dots button { width: 22px; height: 2px; border-radius: 0; background: rgba(255, 255, 255, 0.4); transform: scaleX(0.364); transform-origin: left center; transition: transform var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out); }
  .hero__dots button[aria-selected='true'] { background: #fff; transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .hbtn--solid:hover { background: var(--color-mint); }
    .hbtn--ghost:hover { background: rgba(255, 255, 255, 0.12); }
    .hero__arrow:hover, .hero__pause:hover { background: rgba(255, 255, 255, 0.14); border-color: #fff; }
    .hero__dots button:hover { background: rgba(255, 255, 255, 0.7); }
  }

  .hero__chains { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem 1.25rem; padding-block: clamp(28px, 4vw, 48px) 0; }
  .hero__chains > span { font-size: var(--text-small); color: var(--color-faint); }
  .hero__chains ul { list-style: none; margin: 0; padding: 0; display: contents; }
  .hero__chains li { display: flex; align-items: center; }
  /* Official marks, each cropped into a uniform chip so Solana's square tile,
     Ethereum's circle and Base/Polygon's edge-to-edge marks read as one
     consistent row instead of five differently-shaped source assets. */
  .hero__chain-icon { display: block; width: 22px; height: 22px; border-radius: 0; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px var(--color-border); }
  .hero__chain-icon img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* "Coming to" chains are real logos but not live yet -- desaturated and
     dimmed so the honesty distinction survives the switch from drawn,
     tintable icons to real brand art that can't just inherit currentColor. */
  .hero__chains-next .hero__chain-icon { filter: grayscale(1); opacity: 0.55; }

  :global(html.motion-ok) [data-slide='0'] [data-hero-in] { opacity: 0; }

  @media (max-width: 760px) {
    .hero__slide { align-items: flex-end; }
    .hero__slide::before { background: linear-gradient(0deg, rgba(4, 22, 16, 0.85) 0%, rgba(4, 22, 16, 0.55) 45%, rgba(4, 22, 16, 0) 72%); }
    .hero__content { padding: 24px 22px 96px; gap: 16px; }
    .hero__ctas { width: 100%; }
    .hbtn { flex: 1 1 100%; justify-content: center; height: 52px; }
    .hero__scroll { display: none; }
    .hero__controls { left: 22px; right: 22px; bottom: 22px; gap: 8px; }
    .hero__count { font-size: 1.0625rem; }
    .hero__count::after { margin-left: 8px; }
    .hero__arrow, .hero__pause { width: 30px; height: 30px; }
    .hero__pause { width: 26px; height: 26px; }
    .hero__dots { gap: 5px; }
    .hero__dots button { width: 16px; }
    .hero__chain-icon { width: 19px; height: 19px; }
    .hero__chains { gap: 0.4rem 1.1rem; }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const countEl = root.querySelector<HTMLElement>('[data-count-current]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const iconPause = pauseBtn.querySelector<SVGElement>('[data-icon-pause]')!;
    const iconPlay = pauseBtn.querySelector<SVGElement>('[data-icon-play]')!;

    let current = 0;
    let timer: number | undefined;
    let userPaused = reducedMotion();
    const INTERVAL = 6000;

    const setPauseUI = () => {
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      pauseBtn.setAttribute('aria-label', userPaused ? 'Resume automatic slide rotation' : 'Pause automatic slide rotation');
      iconPause.classList.toggle('is-hidden', userPaused);
      iconPlay.classList.toggle('is-hidden', !userPaused);
    };

    const goTo = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((el, idx) => {
        const active = idx === current;
        el.classList.toggle('is-active', active);
        if (active) el.removeAttribute('aria-hidden');
        else el.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, idx) => d.setAttribute('aria-selected', String(idx === current)));
      if (countEl) countEl.textContent = String(current + 1).padStart(2, '0');
      if (!reducedMotion()) {
        const img = slides[current]!.querySelector<HTMLElement>('.hero__img');
        if (img) gsap.fromTo(img, { scale: 1.05 }, { scale: 1, duration: 1.1, ease: 'expo.out' });
      }
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (userPaused) return;
      timer = window.setInterval(() => goTo(current + 1), INTERVAL);
    };

    prevBtn.addEventListener('click', () => { goTo(current - 1); start(); });
    nextBtn.addEventListener('click', () => { goTo(current + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); start(); }));
    pauseBtn.addEventListener('click', () => { userPaused = !userPaused; setPauseUI(); start(); });

    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) start(); });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); start(); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); start(); }
    });

    setPauseUI();
    start();

    if (!reducedMotion()) {
      gsap.fromTo('[data-slide="0"] .hero__img', { scale: 1.06 }, { scale: 1, duration: 1.4, ease: 'expo.out' });
      gsap.to('[data-slide="0"] [data-hero-in]', { opacity: 1, y: 0, duration: 0.8, stagger: 0.07, ease: 'expo.out', startAt: { y: 16 }, delay: 0.2 });
    }
  }
</script>
