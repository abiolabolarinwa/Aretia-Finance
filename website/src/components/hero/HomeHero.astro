---
import { LINKS } from '../../data/site';

const liveChain = 'Solana';
const nextChains = ['Ethereum', 'Base', 'BNB Smart Chain', 'Polygon'];
---

<section class="hero" data-hero>
  <div class="hero__frame">
    <img
      class="hero__img"
      src="/images/people/hero-wide.webp"
      srcset="/images/people/hero-wide-1200.webp 1200w, /images/people/hero-wide.webp 2400w"
      sizes="100vw"
      alt="Two friends laughing and taking a selfie in a sunlit park"
      width="2400"
      height="1350"
      fetchpriority="high"
    />
    <div class="hero__content">
      <a class="hero__pill" href="/token" data-hero-in>
        <span class="hero__pill-dot"></span>ACT is live on Solana mainnet
      </a>
      <h1 class="hero__title" data-hero-in>Move money.<br />Fund the planet.</h1>
      <p class="hero__lead" data-hero-in>
        Every ACT transfer carries a 3.5% fee, withheld on-chain — 2% builds a Climate Treasury you can verify yourself. Self-custody across five chains is on the way.
      </p>
      <div class="hero__ctas" data-hero-in>
        <a class="hbtn hbtn--solid" href={LINKS.buyAct}>
          Get ACT
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="hbtn hbtn--ghost" href="#explore">Explore Aretia</a>
      </div>
    </div>
    <p class="hero__foot">Aretia Wallet — multichain self-custody, in development. <a href={LINKS.walletWaitlist}>Join the waitlist →</a></p>
    <a class="hero__scroll" href="#explore">Scroll
      <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <div class="container hero__chains">
    <span>Live on</span>
    <ul class="hero__chains-live"><li>{liveChain}</li></ul>
    <span>Coming to</span>
    <ul class="hero__chains-next">{nextChains.map((c) => <li>{c}</li>)}</ul>
  </div>
</section>

<style>
  .hero { padding: calc(var(--nav-height) + 8px) clamp(8px, 1.2vw, 16px) 0; }
  .hero__frame {
    position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center;
    min-height: min(calc(100svh - var(--nav-height) - 24px), 860px); min-height: max(560px, min(calc(100svh - var(--nav-height) - 24px), 860px));
    border-radius: clamp(20px, 2.2vw, 32px); background: var(--color-brand);
  }
  .hero__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%; }
  /* Scrim built from the same logo green as the rest of the page, not a
     separate near-black -- one brand color carries the whole site. */
  .hero__frame::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(11, 61, 46, 0.82) 0%, rgba(11, 61, 46, 0.52) 34%, rgba(11, 61, 46, 0) 62%), linear-gradient(0deg, rgba(11, 61, 46, 0.4), transparent 30%); }

  .hero__content { display: grid; justify-items: start; gap: 22px; width: min(100%, 860px); padding: clamp(24px, 6vw, 96px); color: #fff; }
  .hero__pill { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; font-weight: 500; color: #fff; }
  .hero__pill-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-mint); box-shadow: 0 0 0 4px rgba(94, 230, 168, 0.25); }
  .hero__title { font-size: clamp(2.6rem, 5.6vw, 5.5rem); font-weight: 600; white-space: nowrap; line-height: 0.98; letter-spacing: -0.045em; color: #fff; text-wrap: balance; }
  .hero__lead { max-width: 30rem; font-size: clamp(1.0625rem, 1.3vw, 1.25rem); line-height: 1.5; color: rgba(255, 255, 255, 0.9); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hbtn {
    display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 26px; border-radius: var(--radius-pill);
    font-size: 1rem; font-weight: 500; letter-spacing: -0.01em;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .hbtn:active { transform: scale(0.97); }
  .hbtn--solid { background: #fff; color: var(--color-brand); }
  .hbtn--ghost { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.7); }
  /* The global :focus-visible ring is brand-green -- invisible on this dark
     scrim. Every focusable element inside the hero gets a white ring instead. */
  .hero__frame :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .hero__foot, .hero__scroll { position: absolute; bottom: clamp(18px, 2.4vw, 32px); font-size: 0.8125rem; color: rgba(255, 255, 255, 0.85); }
  .hero__foot { left: clamp(24px, 6vw, 96px); max-width: min(80vw, 30rem); }
  .hero__foot a { color: #fff; text-decoration: underline; text-underline-offset: 2px; font-weight: 500; }
  .hero__scroll { right: clamp(24px, 3vw, 40px); display: inline-flex; align-items: center; gap: 6px; }

  .hero__chains { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem 1.25rem; padding-block: clamp(28px, 4vw, 48px) 0; }
  .hero__chains > span { font-size: var(--text-small); color: var(--color-faint); }
  .hero__chains ul { list-style: none; margin: 0; padding: 0; display: contents; }
  .hero__chains li { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.02em; }
  .hero__chains-live li { color: var(--color-brand-bright); }
  /* rgba(brand, 0.35) read ~3.3:1 on white, failing WCAG AA. 0.68 clears
     4.6:1+ while still reading clearly lighter than the live entry above. */
  .hero__chains-next li { color: rgba(11, 61, 46, 0.68); }

  :global(html.motion-ok) [data-hero-in] { opacity: 0; }

  @media (hover: hover) and (pointer: fine) {
    .hbtn--solid:hover { background: var(--color-mint); }
    .hbtn--ghost:hover { background: rgba(255, 255, 255, 0.12); }
  }
  @media (max-width: 760px) {
    .hero__frame { align-items: flex-end; min-height: max(620px, calc(100svh - var(--nav-height) - 16px)); }
    .hero__img { object-position: 70% 30%; }
    .hero__frame::before { background: linear-gradient(0deg, rgba(4, 22, 16, 0.85) 0%, rgba(4, 22, 16, 0.55) 45%, rgba(4, 22, 16, 0) 72%); }
    .hero__content { padding: 24px 22px 64px; gap: 16px; }
    .hero__title { white-space: normal; }
    .hero__ctas { width: 100%; }
    .hbtn { flex: 1 1 100%; justify-content: center; height: 52px; }
    .hero__foot { left: 22px; bottom: 22px; }
    .hero__scroll { display: none; }
    .hero__chains li { font-size: 1rem; }
    .hero__chains { gap: 0.4rem 1.25rem; }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  if (!reducedMotion()) {
    gsap.fromTo('[data-hero] .hero__img', { scale: 1.06 }, { scale: 1, duration: 1.4, ease: 'expo.out' });
    gsap.to('[data-hero-in]', { opacity: 1, y: 0, duration: 0.8, stagger: 0.07, ease: 'expo.out', startAt: { y: 16 }, delay: 0.2 });
  }
</script>
