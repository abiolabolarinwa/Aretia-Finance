---
/**
 * The restrained animated background: slow-drifting nodes joined by thin
 * lines, occasional value "pulses" travelling along a link, and a gentle
 * pull toward the pointer. Canvas 2D, capped at ~70 nodes, paused when
 * off-screen or the tab is hidden, and static under reduced motion.
 */
interface Props {
  density?: number;
}
const { density = 1 } = Astro.props;
---

<canvas class="field" data-network-field data-density={density} aria-hidden="true"></canvas>

<style>
  .field { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 1.6s var(--ease-out); }
  .field.is-ready { opacity: 1; }
</style>

<script>
  interface Node { x: number; y: number; vx: number; vy: number; r: number; gold: boolean }
  interface Pulse { a: number; b: number; t: number; speed: number }

  document.querySelectorAll<HTMLCanvasElement>('[data-network-field]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const density = Number(canvas.dataset.density || 1);
    const LINK = 150;
    let w = 0, h = 0, dpr = 1;
    let nodes: Node[] = [];
    const pulses: Pulse[] = [];
    const pointer = { x: -9999, y: -9999, tx: 0, ty: 0, ox: 0, oy: 0 };
    let visible = true;
    let raf = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(70, Math.round((w * h) / 22000 * density));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.12, vy: (Math.random() - 0.5) * 0.12,
        r: Math.random() * 1.2 + 0.6, gold: Math.random() < 0.08,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      // Whole-field parallax toward the pointer, eased.
      pointer.ox += (pointer.tx - pointer.ox) * 0.04;
      pointer.oy += (pointer.ty - pointer.oy) * 0.04;
      for (const n of nodes) {
        if (!reduced) {
          n.x += n.vx; n.y += n.vy;
          if (n.x < -20) n.x = w + 20; else if (n.x > w + 20) n.x = -20;
          if (n.y < -20) n.y = h + 20; else if (n.y > h + 20) n.y = -20;
        }
      }
      const px = pointer.ox, py = pointer.oy;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i]!;
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j]!;
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d > LINK) continue;
          const near = Math.hypot((a.x + b.x) / 2 - pointer.x, (a.y + b.y) / 2 - pointer.y) < 180;
          ctx.strokeStyle = `rgba(29,29,31,${(1 - d / LINK) * (near ? 0.14 : 0.05)})`;
          ctx.lineWidth = 0.6;
          ctx.beginPath(); ctx.moveTo(a.x + px, a.y + py); ctx.lineTo(b.x + px, b.y + py); ctx.stroke();
          if (!reduced && pulses.length < 6 && Math.random() < 0.00025) pulses.push({ a: i, b: j, t: 0, speed: 0.006 + Math.random() * 0.006 });
        }
      }
      for (const n of nodes) {
        ctx.fillStyle = n.gold ? 'rgba(160,122,44,0.75)' : 'rgba(29,29,31,0.22)';
        ctx.beginPath(); ctx.arc(n.x + px, n.y + py, n.r, 0, Math.PI * 2); ctx.fill();
      }
      for (let k = pulses.length - 1; k >= 0; k--) {
        const p = pulses[k]!;
        const a = nodes[p.a], b = nodes[p.b];
        p.t += p.speed;
        if (!a || !b || p.t >= 1) { pulses.splice(k, 1); continue; }
        const x = a.x + (b.x - a.x) * p.t + px, y = a.y + (b.y - a.y) * p.t + py;
        const g = ctx.createRadialGradient(x, y, 0, x, y, 8);
        g.addColorStop(0, 'rgba(160,122,44,0.7)'); g.addColorStop(1, 'rgba(160,122,44,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, 8, 0, Math.PI * 2); ctx.fill();
      }
    };

    const loop = () => {
      draw();
      if (visible && !document.hidden && !reduced) raf = requestAnimationFrame(loop);
    };
    const start = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); };

    resize();
    draw();
    canvas.classList.add('is-ready');
    if (reduced) return;

    new ResizeObserver(() => { resize(); draw(); }).observe(canvas);
    new IntersectionObserver(([entry]) => { visible = !!entry?.isIntersecting; if (visible) start(); }).observe(canvas);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      window.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = e.clientX - rect.left; pointer.y = e.clientY - rect.top;
        pointer.tx = (e.clientX / window.innerWidth - 0.5) * -24;
        pointer.ty = (e.clientY / window.innerHeight - 0.5) * -16;
      }, { passive: true });
    }
    start();
  });
</script>
