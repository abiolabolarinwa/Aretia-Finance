---
/** Aretia Pay = ENS/SNS name resolution before signing. No Aretia fee exists, so none is shown. */
---

<div class="panel pv" data-pay>
  <div class="ui-card pv__card">
    <div class="pv__head"><span>Pay</span><span class="pv__net">Ethereum</span></div>
    <div class="pv__amount tnum">0.05 <span>ETH</span></div>
    <label class="pv__field">
      <small>To</small>
      <span class="pv__name">vitalik.eth</span>
    </label>
    <div class="pv__resolve" data-pay-step>
      <span class="pv__spinner" aria-hidden="true"></span>
      <span>Resolving ENS name…</span>
    </div>
    <div class="pv__resolved" data-pay-step>
      <small>Resolved address</small>
      <span class="mono">0xd8dA6BF2…A96045</span>
    </div>
    <dl class="pv__rows" data-pay-step>
      <div><dt>Network fee</dt><dd>Shown at review</dd></div>
      <div><dt>Aretia fee</dt><dd>None</dd></div>
    </dl>
    <button class="pv__btn" type="button" data-pay-step tabindex="-1" aria-hidden="true">Pay with Aretia</button>
    <div class="pv__done" data-pay-step>
      <span class="pv__tick" aria-hidden="true">✓</span>
      Sent to vitalik.eth
    </div>
  </div>
</div>

<style>
  .pv { display: grid; place-items: center; min-height: 420px; }
  .pv__card { width: min(100%, 340px); display: grid; gap: 14px; padding: 20px; }
  .pv__head { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: var(--color-muted); }
  .pv__net { font-size: 11px; padding: 3px 9px; border-radius: 999px; background: rgba(0, 0, 0, 0.05); }
  .pv__amount { font-family: var(--font-display); font-size: 42px; font-weight: 600; letter-spacing: -0.03em; color: var(--color-strong); }
  .pv__amount span { font-size: 18px; color: var(--color-faint); }
  .pv__field { display: grid; gap: 4px; padding: 12px; border-radius: 14px; border: 1px solid var(--color-border-strong); background: rgba(0, 0, 0, 0.03); }
  .pv__field small, .pv__resolved small { font-size: 11px; color: var(--color-faint); }
  .pv__name { font-size: 15px; font-weight: 600; color: var(--color-strong); }
  .pv__resolve { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--color-muted); }
  .pv__spinner { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--color-border-strong); border-top-color: var(--color-gold); animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .pv__resolved { display: grid; gap: 2px; }
  .pv__resolved .mono { color: var(--color-gold-bright); font-size: 13px; }
  .pv__rows { margin: 0; display: grid; gap: 6px; font-size: 12px; }
  .pv__rows div { display: flex; justify-content: space-between; }
  .pv__rows dt { color: var(--color-faint); }
  .pv__rows dd { margin: 0; color: var(--color-text); }
  .pv__btn { height: 44px; border-radius: 999px; font-weight: 600; font-size: 14px; background: var(--color-strong); color: var(--color-bg); cursor: default; }
  .pv__done { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--color-ok); }
  .pv__tick { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: rgba(27, 138, 75, 0.14); }
  :global(html.motion-ok) .pv [data-pay-step] { display: none; }
  :global(html.motion-ok) .pv [data-pay-step].is-shown { display: revert; animation: pay-in 450ms var(--ease-out); }
  :global(html.motion-ok) .pv .pv__resolve.is-shown, :global(html.motion-ok) .pv .pv__done.is-shown { display: flex; }
  :global(html.motion-ok) .pv .pv__rows.is-shown, :global(html.motion-ok) .pv .pv__resolved.is-shown { display: grid; }
  @keyframes pay-in { from { opacity: 0; transform: translateY(6px); } }
  :global(html:not(.motion-ok)) .pv__resolve { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pay]').forEach((root) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const [resolving, resolved, rows, btn, done] = [...root.querySelectorAll<HTMLElement>('[data-pay-step]')];
    let timers: number[] = [];
    const clear = () => { timers.forEach((t) => window.clearTimeout(t)); timers = []; };
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const show = (el: HTMLElement | undefined, on: boolean) => el?.classList.toggle('is-shown', on);
    const play = () => {
      clear();
      [resolving, resolved, rows, btn, done].forEach((el) => show(el, false));
      at(300, () => show(resolving, true));
      at(1500, () => { show(resolving, false); show(resolved, true); });
      at(2100, () => show(rows, true));
      at(2600, () => show(btn, true));
      at(3900, () => { show(btn, false); show(done, true); });
      at(7400, play);
    };
    new IntersectionObserver(([e]) => (e?.isIntersecting ? play() : clear()), { threshold: 0.35 }).observe(root);
  });
</script>
