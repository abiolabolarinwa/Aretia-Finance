---
import StatusBadge from '../ui/StatusBadge.astro';
import type { Status } from '../../data/site';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead: string;
  status?: Status;
  statusNote?: string;
  points?: string[];
  roadmap?: string[];
  reverse?: boolean;
  /** A photo of people the product visual floats over. */
  photo?: { src: string; alt: string; position?: string };
}
const { id, eyebrow, title, lead, status, statusNote, points = [], roadmap = [], reverse = false, photo } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section class:list={['ps section', { 'ps--reverse': reverse, 'section--alt': reverse }]} id={id} aria-labelledby={headingId}>
  <div class="container ps__grid">
    <div class="ps__copy">
      <div class="ps__meta" data-reveal>
        {status && <StatusBadge status={status} />}
      </div>
      <h2 id={headingId} class="heading" set:html={title} data-split />
      <p class="lead" data-reveal>{lead}</p>
      {
        points.length > 0 && (
          <ul class="ps__points">
            {points.map((p) => (
              <li data-reveal>{p}</li>
            ))}
          </ul>
        )
      }
      {
        roadmap.length > 0 && (
          <div class="ps__roadmap" data-reveal>
            <StatusBadge status="roadmap" />
            <span>{roadmap.join(' · ')}</span>
          </div>
        )
      }
      {statusNote && <p class="ps__note" data-reveal>{statusNote}</p>}
      <slot name="actions" />
    </div>
    {
      photo ? (
        <div class="ps__visual ps__stage" data-reveal="scale">
          <img class="ps__photo" src={photo.src} alt={photo.alt} loading="lazy" decoding="async" style={photo.position ? `object-position:${photo.position}` : undefined} />
          <div class="ps__float">
            <slot />
          </div>
        </div>
      ) : (
        <div class="ps__visual" data-reveal="scale">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .ps__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: clamp(2.5rem, 6vw, 6rem); }
  .ps--reverse .ps__copy { order: 2; }
  .ps__copy { display: grid; gap: var(--space-md); justify-items: start; }
  .ps__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; }
  .ps__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .ps__points li { position: relative; padding-left: 1.6rem; color: var(--color-text); font-size: 0.97rem; }
  .ps__points li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 10px; height: 1px; background: var(--color-brand-bright); }
  .ps__roadmap { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; font-size: var(--text-small); color: var(--color-faint); }
  .ps__note { font-size: var(--text-small); color: var(--color-faint); }
  .ps__visual { position: relative; min-width: 0; }
  .ps__stage { display: grid; border-radius: var(--radius-xl); overflow: hidden; isolation: isolate; padding: clamp(15rem, 28vw, 21rem) clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem); }
  .ps__photo { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; }
  .ps__stage::after { content: ''; position: absolute; inset: 40% 0 0 0; z-index: -1; background: linear-gradient(180deg, transparent, rgba(7, 42, 32, 0.35)); }
  .ps__float { min-width: 0; }
  .ps__float :global(.panel) { background: rgba(255, 255, 255, 0.94); box-shadow: var(--shadow-float); padding: clamp(1.1rem, 3vw, 2rem); backdrop-filter: blur(18px); }
  @media (max-width: 1023px) {
    .ps__grid { grid-template-columns: minmax(0, 1fr); }
    /* Phones: the photo becomes a band at the top so faces stay clear of the panel. */
    .ps__stage { padding: 17rem 0.75rem 0.75rem; background: var(--color-mint-soft); }
    .ps__photo { bottom: auto; height: 22rem; object-position: 50% 22% !important; }
    .ps__stage::after { inset: 0 0 auto 0; height: 22rem; }
    .ps--reverse .ps__copy { order: 0; }
  }
</style>
