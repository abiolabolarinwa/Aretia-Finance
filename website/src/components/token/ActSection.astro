---
import StatusBadge from '../ui/StatusBadge.astro';
import Button from '../buttons/Button.astro';
import { ACT } from '../../data/site';

const split = ACT.transferFee.split;
---

<section class="act section" id="act" aria-labelledby="act-title">
  <div class="container">
    <header class="act__head">
      <p class="eyebrow eyebrow--gold" data-reveal>ACT</p>
      <h2 id="act-title" class="heading" data-split>One token.<br />Multiple utilities.</h2>
      <p class="lead" data-reveal>
        ACT is Aretia's ecosystem token, live on Solana mainnet as an SPL Token-2022 mint with a fixed supply. A protocol-level transfer fee funds the Climate Treasury, liquidity and treasury operations on every transfer.
      </p>
    </header>

    <div class="act__grid">
      <div class="panel panel--glow-gold act__flow" data-fee-flow data-reveal="scale">
        <p class="act__flow-title">Where a transfer's fee goes</p>
        <div class="flow">
          <div class="flow__node flow__node--src"><small>Step 1</small>ACT transfer</div>
          <div class="flow__pipe"><span></span></div>
          <div class="flow__node flow__node--fee"><small>Token-2022 program</small><b class="tnum">{ACT.transferFee.totalPercent}%</b> withheld</div>
          <div class="flow__pipe"><span></span></div>
          <div class="flow__node"><small>Treasury multisig</small>Collected &amp; split</div>
          <div class="flow__split">
            {
              split.map((s) => (
                <div class="flow__dest" data-dest>
                  <b class="tnum">{s.percent}%</b>
                  <span>{s.label}</span>
                </div>
              ))
            }
          </div>
        </div>
        <p class="act__flow-note">{ACT.transferFee.note}</p>
      </div>

      <div class="act__side">
        <dl class="act__facts">
          <div data-reveal>
            <dt>Total supply</dt>
            <dd class="tnum" data-count={ACT.totalSupply}>{ACT.totalSupply.toLocaleString('en-US')}</dd>
            <p>Fixed. {ACT.mintAuthority}.</p>
          </div>
          <div data-reveal>
            <dt>Presale allocation</dt>
            <dd class="tnum" data-count={ACT.presaleAllocation}>{ACT.presaleAllocation.toLocaleString('en-US')}</dd>
            <p>Net to purchasers.</p>
          </div>
        </dl>
        <ul class="act__utilities">
          {
            ACT.utilities.map((u) => (
              <li data-reveal>
                <div>
                  <b>{u.name}</b>
                  <span>{u.detail}</span>
                </div>
                <StatusBadge status={u.status} />
              </li>
            ))
          }
        </ul>
        <div class="act__actions" data-reveal>
          <Button href="/token" variant="secondary" arrow>Token details</Button>
          <Button href="/verify" variant="ghost">Verify the mint</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .act__head { display: grid; gap: var(--space-md); max-width: 50rem; margin-bottom: var(--space-2xl); }
  .act__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-xl); align-items: start; }
  .act__flow { display: grid; gap: var(--space-md); }
  .act__flow-title { font-size: var(--text-small); font-weight: 600; color: var(--color-muted); }
  .flow { display: grid; justify-items: center; gap: 0; }
  .flow__node { display: grid; justify-items: center; gap: 4px; padding: 14px 22px; border-radius: var(--radius-md); background: var(--color-surface-2); border: 1px solid var(--color-border); font-size: 14px; font-weight: 600; color: var(--color-strong); text-align: center; }
  .flow__node small { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); font-weight: 600; }
  .flow__node--fee { border-color: rgba(160, 122, 44, 0.45); background: var(--color-gold-soft); }
  .flow__node--fee b { font-family: var(--font-display); font-size: 28px; color: var(--color-gold-bright); line-height: 1; }
  .flow__pipe { position: relative; width: 2px; height: 42px; background: var(--color-border-strong); overflow: hidden; }
  .flow__pipe span { position: absolute; left: 0; width: 2px; height: 14px; background: var(--color-gold-bright); box-shadow: 0 0 10px var(--color-gold); animation: drip 1.8s var(--ease-in-out) infinite; }
  @keyframes drip { from { transform: translateY(-16px); } to { transform: translateY(44px); } }
  .flow__split { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; width: 100%; margin-top: 26px; position: relative; }
  .flow__split::before { content: ''; position: absolute; left: 16.6%; right: 16.6%; top: -14px; height: 1px; background: var(--color-border-strong); }
  .flow__dest { position: relative; display: grid; justify-items: center; gap: 4px; padding: 14px 8px; border-radius: var(--radius-md); border: 1px solid var(--color-border); text-align: center; transition: border-color var(--duration-base), background-color var(--duration-base), transform var(--duration-base) var(--ease-out); }
  .flow__dest::before { content: ''; position: absolute; top: -14px; left: 50%; width: 1px; height: 14px; background: var(--color-border-strong); }
  .flow__dest b { font-family: var(--font-display); font-size: 22px; color: var(--color-gold-bright); }
  .flow__dest span { font-size: 12px; color: var(--color-muted); }
  .flow__dest.is-lit, .flow__dest:hover { border-color: rgba(160, 122, 44, 0.5); background: var(--color-gold-soft); transform: translateY(-3px); }
  .act__flow-note { font-size: var(--text-micro); color: var(--color-faint); }
  .act__side { display: grid; gap: var(--space-lg); }
  .act__facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
  .act__facts dt { font-size: var(--text-micro); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--color-faint); font-weight: 600; }
  .act__facts dd { margin: 6px 0 4px; font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.25rem); font-weight: 600; letter-spacing: -0.03em; color: var(--color-strong); }
  .act__facts p { font-size: var(--text-small); color: var(--color-muted); }
  .act__utilities { list-style: none; margin: 0; padding: 0; display: grid; }
  .act__utilities li { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-sm); padding: 16px 0; border-top: 1px solid var(--color-border); }
  .act__utilities li div { display: grid; gap: 2px; }
  .act__utilities b { font-size: 15px; color: var(--color-strong); }
  .act__utilities span { font-size: var(--text-small); color: var(--color-muted); }
  .act__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 1023px) {
    .act__grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 420px) {
    .act__facts { grid-template-columns: minmax(0, 1fr); }
    .flow__dest b { font-size: 18px; }
    .flow__dest span { font-size: 11px; }
  }
</style>

<script>
  // Light each fee destination in turn, in time with the flowing pulse.
  document.querySelectorAll<HTMLElement>('[data-fee-flow]').forEach((root) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const dests = [...root.querySelectorAll<HTMLElement>('[data-dest]')];
    let i = 0;
    let timer: number | undefined;
    const tick = () => { dests.forEach((d, k) => d.classList.toggle('is-lit', k === i)); i = (i + 1) % dests.length; };
    new IntersectionObserver(([e]) => {
      window.clearInterval(timer);
      if (e?.isIntersecting) { tick(); timer = window.setInterval(tick, 1800); }
      else dests.forEach((d) => d.classList.remove('is-lit'));
    }).observe(root);
  });
</script>
