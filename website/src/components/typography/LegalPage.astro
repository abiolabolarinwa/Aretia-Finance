---
import Base from '../../layouts/Base.astro';
import PageHero from './PageHero.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description} ctaBands={false}>
  <PageHero eyebrow="Legal" title={title}>
    <p class="lh__meta">Last updated {updated}</p>
    <p class="lh__draft" role="note">
      Draft pending legal review. Sections marked <em>[Legal review required]</em> are placeholders and are not yet final terms.
    </p>
  </PageHero>
  <div class="container">
    <div class="legal"><slot /></div>
  </div>
</Base>

<style>
  .lh__meta { color: rgba(255, 255, 255, 0.7); font-size: var(--text-small); }
  .lh__draft { max-width: 44rem; padding: 14px 18px; border-radius: var(--radius-md); border: 1px solid rgba(255, 200, 130, 0.5); background: rgba(255, 255, 255, 0.07); color: #ffd9a8; font-size: var(--text-small); }
  .legal { margin-top: var(--space-2xl); }
  .legal { max-width: 46rem; padding-bottom: var(--space-3xl); color: var(--color-muted); line-height: 1.75; }
  .legal :global(h2) { font-size: 1.5rem; letter-spacing: -0.02em; margin: 2.5rem 0 0.75rem; scroll-margin-top: calc(var(--nav-height) + 16px); }
  .legal :global(p), .legal :global(ul) { margin: 0 0 1rem; }
  .legal :global(ul) { padding-left: 1.2rem; }
  .legal :global(li) { margin-bottom: 0.4rem; }
  .legal :global(em) { color: var(--color-warn); font-style: normal; font-weight: 600; }
  .legal :global(strong) { color: var(--color-text); }
  .legal :global(a) { color: var(--color-gold-bright); text-decoration: underline; text-underline-offset: 3px; }
</style>
