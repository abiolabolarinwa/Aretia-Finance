---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  size?: 'display' | 'mega';
}
const { eyebrow, title, lead, align = 'left', size = 'display' } = Astro.props;
---

<header class:list={['ph', `ph--${align}`]}>
  <div class="container ph__inner">
    <h1 class:list={['ph__title', `ph__title--${size}`]} data-split="load" set:html={title} />
    {lead && <p class="lead ph__lead" data-reveal>{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph { position: relative; padding-top: calc(var(--nav-height) + clamp(4rem, 10vw, 8rem)); padding-bottom: clamp(3rem, 7vw, 6rem); overflow: hidden; isolation: isolate; }
  .ph__inner { display: grid; gap: var(--space-md); justify-items: start; }
  .ph--center .ph__inner { justify-items: center; text-align: center; }
  .ph--center .ph__lead { margin-inline: auto; }
  .ph__title { font-family: var(--font-topical); }
  .ph__title--display { font-size: var(--text-display); max-width: 15ch; }
  .ph__title--mega { font-size: var(--text-mega); line-height: 0.92; }
  .ph__lead { max-width: 42rem; }
</style>
