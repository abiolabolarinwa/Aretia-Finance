---
const stages = ['Asset', 'Routing', 'Execution', 'Destination'];
---

<div class="panel panel--glow-indigo uv" data-universal>
  <div class="uv__track">
    <svg class="uv__svg" viewBox="0 0 600 220" aria-hidden="true">
      <path class="uv__path" d="M 70 110 C 190 20 230 20 300 110 C 370 200 410 200 530 110" />
      <path class="uv__path uv__path--glow" d="M 70 110 C 190 20 230 20 300 110 C 370 200 410 200 530 110" pathLength="1" />
      {
        [0, 1, 2].map((i) => (
          <circle class="uv__particle" r="4" style={`animation-delay:${i * 1.1}s`} />
        ))
      }
    </svg>
    <div class="uv__node uv__node--sol" style="left:11.6%">
      <span class="uv__chain">Solana</span><small>ACT locked in hub</small>
    </div>
    <div class="uv__node uv__node--hub" style="left:50%">
      <span class="uv__hub"><img src="/assets/logo-mark.png" alt="" width="28" height="28" /></span>
      <small>Wormhole NTT · Executor relay</small>
    </div>
    <div class="uv__node uv__node--eth" style="left:88.3%">
      <span class="uv__chain">Ethereum</span><small>ACT minted on spoke</small>
    </div>
  </div>
  <ol class="uv__stages">
    {stages.map((s, i) => <li data-uv-stage={i}><span class="tnum">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
  </ol>
  <p class="uv__caption">Testnet deployment: Solana devnet ↔ Ethereum Sepolia.</p>
</div>

<style>
  .uv { display: grid; gap: var(--space-lg); }
  .uv__track { position: relative; aspect-ratio: 600 / 220; }
  .uv__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .uv__path { fill: none; stroke: var(--color-border-strong); stroke-width: 1.2; stroke-dasharray: 3 5; }
  .uv__path--glow { stroke: var(--color-indigo-bright); stroke-width: 1.6; stroke-dasharray: 0.18 0.82; stroke-dashoffset: 1; animation: dash 3.3s linear infinite; opacity: 0.9; }
  @keyframes dash { to { stroke-dashoffset: 0; } }
  .uv__particle { fill: var(--color-gold-bright); offset-path: path('M 70 110 C 190 20 230 20 300 110 C 370 200 410 200 530 110'); animation: move 3.3s var(--ease-in-out) infinite; filter: drop-shadow(0 0 6px rgba(226, 194, 130, 0.9)); }
  @keyframes move { 0% { offset-distance: 0%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }
  .uv__node { position: absolute; top: 50%; translate: -50% -50%; display: grid; justify-items: center; gap: 8px; text-align: center; transition: transform var(--duration-base) var(--ease-out); }
  .uv__node:hover { transform: scale(1.06); }
  .uv__node small { font-size: 11px; color: var(--color-faint); white-space: nowrap; }
  .uv__chain { padding: 10px 16px; border-radius: 999px; font-size: 13px; font-weight: 600; background: var(--color-surface-2); border: 1px solid var(--color-border-strong); color: var(--color-strong); }
  .uv__node--sol .uv__chain { box-shadow: 0 0 30px -8px rgba(20, 241, 149, 0.5); }
  .uv__node--eth .uv__chain { box-shadow: 0 0 30px -8px rgba(98, 126, 234, 0.6); }
  .uv__node--hub { top: 50%; }
  .uv__hub { width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center; background: var(--color-indigo); border: 1px solid rgba(61, 43, 214, 0.6); box-shadow: 0 0 50px -6px rgba(61, 43, 214, 0.7); }
  .uv__hub img { border-radius: 7px; }
  .uv__node--hub small { position: absolute; top: calc(100% + 10px); }
  .uv__stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .uv__stages li { display: grid; gap: 4px; padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--color-border); font-size: 13px; font-weight: 600; color: var(--color-muted); transition: color var(--duration-base), border-color var(--duration-base), background-color var(--duration-base); }
  .uv__stages li span { font-size: 11px; color: var(--color-faint); font-weight: 500; }
  .uv__stages li.is-on { color: var(--color-strong); border-color: rgba(61, 43, 214, 0.5); background: var(--color-indigo-soft); }
  .uv__caption { font-size: var(--text-micro); color: var(--color-faint); }
  @media (max-width: 560px) {
    .uv__node small { display: none; }
    .uv__chain { padding: 7px 10px; font-size: 11px; }
    .uv__hub { width: 44px; height: 44px; border-radius: 14px; }
    .uv__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  // Step the Asset → Routing → Execution → Destination indicator in time with the particles.
  document.querySelectorAll<HTMLElement>('[data-universal]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-uv-stage]')];
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((i) => i.classList.add('is-on'));
      return;
    }
    let i = 0;
    let timer: number | undefined;
    const tick = () => {
      items.forEach((el, k) => el.classList.toggle('is-on', k === i));
      i = (i + 1) % items.length;
    };
    new IntersectionObserver(([e]) => {
      window.clearInterval(timer);
      if (e?.isIntersecting) { tick(); timer = window.setInterval(tick, 825); }
    }).observe(root);
  });
</script>
