---
/**
 * A stylised Aretia Wallet interface. Balances and the activity row are
 * illustrative sample values for a product preview, never presented as real
 * user or protocol data (the caption says so).
 */
interface Props {
  class?: string;
  compact?: boolean;
  /** Tilt toward the pointer within the nearest [data-tilt-zone]. */
  tilt?: boolean;
}
const { class: className, compact = false, tilt = true } = Astro.props;
---

<figure class:list={['wm', { 'wm--compact': compact }, className]} data-wallet-mock data-tilt={tilt ? '5' : undefined}>
  <div class="wm__screen">
    <div class="wm__top">
      <div class="wm__account">
        <span class="wm__avatar" aria-hidden="true"></span>
        <div>
          <div class="wm__name">Main account</div>
          <div class="wm__addr mono">7xKq…9fPa</div>
        </div>
      </div>
      <span class="wm__net"><span class="wm__dot"></span>Solana</span>
    </div>

    <div class="wm__balance" data-wm-item>
      <div class="wm__label">Total balance</div>
      <div class="wm__total tnum">12,480.<span>00</span> <em>ACT</em></div>
    </div>

    <div class="wm__actions" data-wm-item>
      {['Send', 'Receive', 'Swap', 'Bridge'].map((a) => <span class="wm__action">{a}</span>)}
    </div>

    <ul class="wm__assets">
      <li data-wm-item>
        <span class="wm__coin wm__coin--act">ACT</span>
        <span class="wm__asset"><b>Aretia</b><small>Solana</small></span>
        <span class="wm__amt tnum">12,480.00</span>
      </li>
      <li data-wm-item>
        <span class="wm__coin wm__coin--sol">SOL</span>
        <span class="wm__asset"><b>Solana</b><small>Solana</small></span>
        <span class="wm__amt tnum">3.214</span>
      </li>
      <li data-wm-item>
        <span class="wm__coin wm__coin--eth">ETH</span>
        <span class="wm__asset"><b>Ether</b><small>Ethereum</small></span>
        <span class="wm__amt tnum">0.842</span>
      </li>
    </ul>

    {
      !compact && (
        <div class="wm__activity" data-wm-item>
          <div class="wm__label">Recent</div>
          <div class="wm__tx">
            <span class="wm__tx-icon" aria-hidden="true">↗</span>
            <span class="wm__asset">
              <b>Sent to vitalik.eth</b>
              <small>Aretia Pay · resolved before signing</small>
            </span>
            <span class="wm__shield">Shield ✓</span>
          </div>
        </div>
      )
    }

    <div class="wm__chips" data-wm-item>
      <span>Shield</span><span>Pay</span><span>Universal</span><span>Intent</span>
    </div>
  </div>
  <figcaption class="sr-only">Illustrative preview of the Aretia Wallet interface with sample balances.</figcaption>
</figure>

<style>
  .wm { margin: 0; width: min(100%, 360px); transform-style: preserve-3d; will-change: transform; }
  .wm__screen { position: relative; padding: 20px; border-radius: 30px; background: linear-gradient(180deg, #ffffff 0%, var(--color-offwhite) 100%); box-shadow: var(--shadow-float); display: grid; gap: 16px; overflow: hidden; }
  .wm__screen::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: linear-gradient(160deg, rgba(226, 194, 130, 0.45), rgba(0, 0, 0, 0.04) 40%, rgba(42, 20, 176, 0.3)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  .wm__top { display: flex; align-items: center; justify-content: space-between; }
  .wm__account { display: flex; align-items: center; gap: 10px; }
  .wm__avatar { width: 32px; height: 32px; border-radius: 50%; background: conic-gradient(from 200deg, var(--color-brand-bright), var(--color-gold), var(--color-brand)); }
  .wm__name { font-size: 13px; font-weight: 600; color: var(--color-strong); }
  .wm__addr { font-size: 11px; color: var(--color-faint); }
  .wm__net { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--color-muted); padding: 4px 9px; border-radius: 999px; background: rgba(0, 0, 0, 0.05); }
  .wm__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-ok); }
  .wm__label { font-size: 11px; color: var(--color-faint); letter-spacing: 0.04em; margin-bottom: 4px; }
  .wm__total { font-family: var(--font-display); font-size: 32px; font-weight: 600; letter-spacing: -0.03em; color: var(--color-strong); }
  .wm__total span { color: var(--color-faint); }
  .wm__total em { font-style: normal; font-size: 15px; color: var(--color-gold); letter-spacing: 0; }
  .wm__actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .wm__action { text-align: center; font-size: 11px; font-weight: 600; padding: 9px 0; border-radius: 12px; background: rgba(0, 0, 0, 0.05); color: var(--color-text); }
  .wm__action:first-child { background: var(--color-strong); color: var(--color-bg); }
  .wm__assets { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .wm__assets li, .wm__tx { display: grid; grid-template-columns: 32px 1fr auto; align-items: center; gap: 10px; padding: 8px; border-radius: 14px; transition: background-color var(--duration-fast); }
  .wm__coin, .wm__tx-icon { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-size: 9px; font-weight: 700; }
  .wm__coin--act { background: radial-gradient(circle at 30% 30%, var(--color-gold-bright), var(--color-gold) 60%, #8a6d34); color: #1a1406; }
  .wm__coin--sol { background: linear-gradient(135deg, #9945ff, #14f195); color: #ffffff; }
  .wm__coin--eth { background: #e8e8ed; color: #3c4a8f; }
  .wm__tx-icon { background: var(--color-brand-soft); color: var(--color-brand-bright); font-size: 14px; }
  .wm__asset { display: grid; min-width: 0; }
  .wm__asset b { font-size: 13px; font-weight: 600; color: var(--color-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wm__asset small { font-size: 11px; color: var(--color-faint); }
  .wm__amt { font-size: 13px; font-weight: 600; color: var(--color-strong); }
  .wm__activity { padding-top: 4px; border-top: 1px solid var(--color-border); }
  .wm__shield { font-size: 10px; font-weight: 600; color: var(--color-ok); padding: 3px 7px; border-radius: 999px; background: rgba(27, 138, 75, 0.08); }
  .wm__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .wm__chips span { font-size: 10px; font-weight: 600; letter-spacing: 0.04em; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-muted); }
  .wm--compact .wm__screen { gap: 12px; padding: 16px; }
  @media (hover: hover) and (pointer: fine) {
    .wm__assets li:hover { background: rgba(0, 0, 0, 0.04); }
  }
</style>
