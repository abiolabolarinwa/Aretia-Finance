---
import Base from '../layouts/Base.astro';
import PageHero from '../components/typography/PageHero.astro';
import Button from '../components/buttons/Button.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import { ACT, LINKS, POOLS } from '../data/site';
---

<Base title="Buy ACT" description="Trade ACT on Solana through the Jupiter swap widget.">
  <link slot="head" rel="stylesheet" href="/assets/wallet/wallet.css" />
  <PageHero eyebrow="Buy ACT" title="Get ACT." lead="Swap into ACT on Solana through Jupiter, connected to the wallet you already use. Always check you are receiving the real mint." />

  <section class="section buy">
    <div class="container buy__grid">
      <div class="buy__widget panel" data-reveal="scale">
        <div class="buy__head">
          <div>
            <StatusBadge status="live" />
          </div>
          <div class="buy__connect" data-aretia-wallet-mount></div>
        </div>
        <p class="buy__status">ACT’s two liquidity pools opened on 2 October 2026. Jupiter finds the best route across them.</p>
        <p class="buy__notice"><b>Keep a little SOL for fees.</b> Every swap pays a small network fee in SOL, and your first ACT purchase also opens your ACT token account (about 0.002 SOL). Paying with USDC or another token? Keep about 0.003 SOL in the same wallet, or the swap will fail.</p>
        <div id="jupiter-terminal" class="buy__terminal"><span class="buy__loading">Loading swap widget…</span></div>
        <a class="buy__listed" href={LINKS.dexscreener} target="_blank" rel="noopener noreferrer"><img src="/assets/logos/dexscreener.png" alt="" width="20" height="20" loading="lazy" />Listed on DexScreener · live price and trades ↗</a>
      </div>

      <aside class="buy__side">
        <div class="buy__card" data-reveal>
          <p class="mono buy__mint">{ACT.mint}</p>
          <p class="muted">Tokens with the same name or ticker can be fakes. Only this mint is ACT.</p>
          <Button href="/verify" variant="secondary" arrow>Verify on-chain</Button>
        </div>
        <div class="buy__card" data-reveal>
          <p><b>Liquidity pools</b></p>
          <p class="muted">Two Meteora pools opened single-sided, each with about 4.9 million ACT, so nothing trades below the floor. The liquidity is permanently locked: no one, the treasury included, can withdraw it. To check, open each locked position below and read its permanently locked liquidity, which is the whole pool.</p>
          {POOLS.map((p) => (
            <p class="muted buy__pool"><b>{p.pair}</b> · floor {p.floor}<br /><a href={p.explorer} target="_blank" rel="noopener noreferrer" class="mono">{p.address}</a><br /><span class="buy__lock">Locked position: <a href={`https://solscan.io/account/${p.position}`} target="_blank" rel="noopener noreferrer" class="mono">{p.position}</a></span>{p.chart && <><br /><a href={p.chart} target="_blank" rel="noopener noreferrer" class="buy__dex"><img src="/assets/logos/dexscreener.png" alt="" width="16" height="16" loading="lazy" />View chart on DexScreener ↗</a></>}</p>
          ))}
        </div>
        <div class="buy__card" data-reveal>
          <p class="muted">Every ACT transfer, including a swap, has a {ACT.transferFee.totalPercent}% fee withheld on-chain{ACT.transferFee.scheduled && ` from Solana epoch ${ACT.transferFee.scheduled.fromEpoch} (${ACT.transferFee.scheduled.previousPercent}% until then)`}. <a href="/token#fees">How it’s split →</a></p>
        </div>
      </aside>
    </div>
    <div class="container">
      <p class="buy__disclaimer">Swaps are executed by Jupiter and signed in your own wallet. Nothing here is investment advice; digital assets can lose all their value. Read the <a href="/terms#risk">risk disclosure</a>.</p>
    </div>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <script is:inline src="https://plugin.jup.ag/plugin-v1.js" data-preload></script>
  <!-- ?v= busts the long browser cache on /assets (served as immutable); bump it whenever wallet.js changes. -->
  <script is:inline src="/assets/wallet/wallet.js?v=20261003b"></script>
  <script is:inline>
    (function () {
      const ACT_MINT = '7Ut5njM9ajGDjP83WvJmvrAcfi9JoVYrHSK5x5sSFrTG';
      const SOL_MINT = 'So11111111111111111111111111111111111111112';
      const RPC_ENDPOINT = 'https://solana-rpc.publicnode.com';
      // Same integration as the previous homepage: wallet.js keeps the
      // widget's wallet in sync via window.Jupiter.syncProps on every
      // connect/disconnect, so a visitor never connects twice.
      function initTerminal() {
        if (!window.Jupiter || typeof window.Jupiter.init !== 'function') return false;
        window.Jupiter.init({
          displayMode: 'integrated',
          integratedTargetId: 'jupiter-terminal',
          endpoint: RPC_ENDPOINT,
          enableWalletPassthrough: true,
          passthroughWalletContextState: window.AretiaWallet ? window.AretiaWallet.getWalletContextState() : undefined,
          formProps: { initialInputMint: SOL_MINT, initialOutputMint: ACT_MINT, fixedOutputMint: false },
        });
        return true;
      }
      if (!initTerminal()) {
        let attempts = 0;
        const poll = setInterval(function () {
          attempts += 1;
          if (initTerminal() || attempts > 100) clearInterval(poll);
        }, 100);
      }
    })();
  </script>
</Base>

<style>
  .buy { padding-top: 0; }
  .buy__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-xl); align-items: start; }
  .buy__widget { display: grid; gap: var(--space-md); }
  .buy__head { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-sm); flex-wrap: wrap; }
  .buy__head > div:first-child { display: grid; gap: 0.6rem; justify-items: start; }
  .buy__status { font-size: var(--text-small); color: var(--color-warn); }
  .buy__notice { margin: 0; padding: 0.75rem 1rem; font-size: var(--text-small); line-height: 1.5; color: var(--color-strong); background: rgba(178, 94, 9, 0.1); border-radius: var(--radius-md); }
  .buy__terminal { min-height: 520px; border-radius: var(--radius-lg); overflow: hidden; background: rgba(0, 0, 0, 0.02); display: grid; }
  .buy__loading { place-self: center; color: var(--color-faint); font-size: var(--text-small); }
  /* Jupiter Plugin renders its own instance next to the placeholder; hide the placeholder once it has. */
  .buy__terminal:has(:global(#jupiter-plugin-instance)) .buy__loading { display: none; }
  /* The Jupiter widget has a fixed 360px width, wider than the panel on phones. */
  .buy__terminal :global(#jupiter-plugin-instance),
  .buy__terminal :global(#jupiter-plugin-instance > *) { width: 100% !important; max-width: 100% !important; min-width: 0 !important; }
  .buy__side { display: grid; gap: var(--space-md); }
  .buy__card { display: grid; gap: 0.75rem; justify-items: start; padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-bg-alt); }
  .buy__card a:not(.btn) { color: var(--color-gold-bright); }
  .buy__pool a { font-size: 12px; overflow-wrap: anywhere; }
  .buy__lock { font-size: 12px; }
  .buy__dex { display: inline-flex; align-items: center; gap: 0.4rem; }
  .buy__dex img { border-radius: 4px; }
  .buy__listed { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--text-small); color: var(--color-muted); justify-self: start; }
  .buy__listed img { border-radius: 5px; }
  .buy__listed:hover { color: var(--color-strong); }
  .buy__mint { font-size: 13px; color: var(--color-gold-bright); overflow-wrap: anywhere; }
  .buy__disclaimer { margin-top: var(--space-xl); font-size: var(--text-small); color: var(--color-faint); max-width: 52rem; }
  .buy__disclaimer a { color: var(--color-muted); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1023px) {
    .buy__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
