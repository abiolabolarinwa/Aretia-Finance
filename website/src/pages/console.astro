---
import '../styles/global.css';
import ProductLogo from '../components/brand/ProductLogo.astro';
import { NAV, LINKS, type Status } from '../data/site';
import type { ProductKey } from '../lib/logos';

/* Aretia Finance Console: the whole product map on one screen, no scrolling.
   Status labels follow src/data/site.ts; hrefs point at the live page for each
   service. Radar has no page yet, so it points at the ecosystem map. */
interface Service {
  key: ProductKey;
  name: string;
  line: string;
  href: string;
  status: Status;
}

const services: Service[] = [
  { key: 'swings', name: 'Aretia Swings', line: 'Trade across chains in one flow, with the route and fee shown first.', href: '/wallet', status: 'built' },
  { key: 'pay', name: 'Aretia Pay', line: 'Send to maria.sol or alex.eth instead of a long address.', href: '/features#pay', status: 'built' },
  { key: 'swap', name: 'Aretia Swap', line: 'Swap the tokens you hold at the price the market offers.', href: '/wallet', status: 'built' },
  { key: 'carbon', name: 'Aretia Carbon Credit', line: 'Registry-backed carbon credits, retired only when the registry confirms.', href: '/carboncredit', status: 'in-development' },
  { key: 'shield', name: 'Aretia Shield', line: 'Every recipient and approval checked before you sign.', href: '/features#shield', status: 'built' },
  { key: 'safesend', name: 'Aretia SafeSend', line: 'Lock a transfer and cancel it before it lands if something looks wrong.', href: '/features#safesend', status: 'testnet' },
  { key: 'radar', name: 'Aretia Radar', line: 'Market and wallet signals, surfaced before they matter.', href: '/ecosystem', status: 'roadmap' },
];

const STATUS_TEXT: Record<Status, string> = {
  live: 'Live',
  built: 'Built',
  testnet: 'Testnet',
  'in-development': 'In development',
  roadmap: 'Roadmap',
};

/** The chains in Aretia Wallet. Marks: public/assets/chains/CREDITS.md. */
const chains = [
  { name: 'Solana', logo: '/assets/chains/solana.png' },
  { name: 'Ethereum', logo: '/assets/chains/ethereum.png' },
  { name: 'Base', logo: '/assets/chains/base.png' },
  { name: 'BNB Chain', logo: '/assets/chains/bnb.png' },
  { name: 'Polygon', logo: '/assets/chains/polygon.png' },
  { name: 'Robinhood Chain', logo: '/assets/chains/robinhood.png' },
];

/* Carbon registries. These are typeset wordmarks, not the registries' own
   logos: drop the official files into public/assets/registries/ and set `logo`
   to use them. */
const registries: { name: string; logo?: string }[] = [
  { name: 'Gold Standard' },
  { name: 'Verra' },
  { name: 'American Carbon Registry' },
  { name: 'Climate Action Reserve' },
  { name: 'Plan Vivo' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aretia Finance Console</title>
    <meta name="description" content="Every Aretia service on one screen: Swings, Pay, Swap, Carbon Credit, Shield, SafeSend and Radar, across six chains and the major carbon registries." />
    <link rel="canonical" href="https://aretiafinance.org/console" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#fbfaf6" />
  </head>
  <body class="console">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="bar">
      <a class="bar__brand" href="/console" aria-label="Aretia Finance Console">
        <img src="/assets/logo-mark.png" alt="" width="28" height="28" />
        <span>Aretia Finance <em>Console</em></span>
      </a>
      <nav class="bar__nav" aria-label="Primary">
        <ul>
          {
            NAV.map((group) => (
              <li class="menu">
                <button type="button" class="menu__btn" aria-haspopup="true">
                  {group.label}
                  <svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                </button>
                <ul class="menu__panel">
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href}>
                        <b>{item.label}</b>
                        <span>{item.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
        <a class="bar__cta" href={LINKS.buyAct}>Buy ACT</a>
      </nav>
    </header>

    <main id="main" class="stage">
      <section class="intro">
        <h1>Home of <span>Decentralized Finance</span></h1>
        <p>Swap, pay, protect and offset, from one self-custody wallet on every chain you use.</p>
      </section>

      <section class="services" aria-label="Aretia services">
        <ul class="grid">
          {
            services.map((s) => (
              <li>
                <a class="card" href={s.href}>
                  <span class="card__tile">
                    <ProductLogo product={s.key} size={56} />
                    <span class="card__status" data-status={s.status}>{STATUS_TEXT[s.status]}</span>
                  </span>
                  <span class="card__name">{s.name}<i aria-hidden="true">→</i></span>
                  <span class="card__line">{s.line}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="flows" aria-label="Where Aretia connects">
        <div class="flow">
          <span class="flow__label">Chains in Aretia Wallet</span>
          <div class="flow__track">
            <img class="flow__brand" src="/assets/logo-mark.png" alt="Aretia Finance" width="40" height="40" />
            <svg class="flow__arrow" viewBox="0 0 64 12" aria-hidden="true"><path d="M1 6h60M54 1l7 5-7 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <ul class="flow__items">
              {
                chains.map((c) => (
                  <li class="chip">
                    <img src={c.logo} alt="" width="24" height="24" />
                    <span>{c.name}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="flow">
          <span class="flow__label">Carbon registries</span>
          <div class="flow__track">
            <img class="flow__brand" src="/assets/logo-mark.png" alt="Aretia Finance" width="40" height="40" />
            <svg class="flow__arrow" viewBox="0 0 64 12" aria-hidden="true"><path d="M1 6h60M54 1l7 5-7 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <ul class="flow__items">
              {
                registries.map((r) => (
                  <li class="chip chip--word">
                    {r.logo ? <img src={r.logo} alt={r.name} height="24" /> : <span>{r.name}</span>}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --c-bg: #fbfaf6;
    --c-card: #f4f3ec;
    --c-line: rgba(14, 11, 43, 0.1);
  }

  /* One screen on desktop: the page is exactly the viewport tall and never scrolls.
     Below 900px wide, or when the window is too short to fit it, it scrolls normally. */
  body.console {
    background: var(--c-bg);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 900px) and (min-height: 720px) {
    html, body.console { height: 100dvh; overflow: hidden; }
  }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 0 clamp(1rem, 4vw, 3rem); height: 64px; flex: none; position: relative; z-index: 5; }
  .bar__brand { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.02em; color: var(--color-strong); }
  .bar__brand img { width: 28px; height: 28px; border-radius: 8px; }
  .bar__brand em { font-style: normal; font-weight: 400; color: var(--color-muted); }
  .bar__nav { display: flex; align-items: center; gap: 0.25rem; }
  .bar__nav ul { list-style: none; margin: 0; padding: 0; }
  .bar__nav > ul { display: flex; gap: 0.1rem; }
  .menu { position: relative; }
  .menu__btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.875rem; font-weight: 500; color: var(--color-text); transition: background-color var(--duration-fast); }
  .menu__panel { position: absolute; top: 100%; left: 0; min-width: 290px; padding: 0.4rem; margin-top: 6px; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-md); box-shadow: var(--shadow-float); opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity var(--duration-fast), transform var(--duration-fast) var(--ease-out), visibility var(--duration-fast); }
  /* Bridges the 6px gap so the pointer can travel from button to panel. */
  .menu__panel::before { content: ''; position: absolute; inset: -8px 0 auto; height: 8px; }
  .menu:hover .menu__panel, .menu:focus-within .menu__panel { opacity: 1; visibility: visible; transform: none; }
  .menu__panel a { display: flex; flex-direction: column; gap: 1px; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
  .menu__panel b { font-size: 0.875rem; font-weight: 600; color: var(--color-strong); }
  .menu__panel span { font-size: 0.78rem; color: var(--color-faint); }
  .bar__cta { margin-left: 0.5rem; padding: 0.5rem 1.05rem; border-radius: var(--radius-sm); font-size: 0.875rem; font-weight: 600; color: var(--color-strong); border: 1px solid var(--c-line); background: #fff; transition: border-color var(--duration-fast); }
  @media (hover: hover) {
    .menu__btn:hover { background: rgba(14, 11, 43, 0.05); }
    .bar__cta:hover { border-color: var(--color-border-strong); }
  }

  .stage { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-evenly; gap: 1.25rem; width: 100%; max-width: 1360px; margin-inline: auto; padding: 0 clamp(1rem, 4vw, 3rem) clamp(1rem, 2.5vh, 1.75rem); }

  .intro { text-align: center; }
  .intro h1 { font-size: clamp(2.25rem, min(5.2vw, 8.5vh), 4.25rem); font-weight: 500; line-height: 1.04; letter-spacing: -0.035em; }
  .intro h1 span { display: block; color: var(--color-brand); }
  .intro p { margin: 0.9rem auto 0; max-width: 46ch; font-size: clamp(0.95rem, 1.7vh, 1.1rem); color: var(--color-muted); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.9rem; }
  .card { display: flex; flex-direction: column; gap: 0.35rem; height: 100%; color: inherit; }
  .card__tile { position: relative; display: grid; place-items: center; aspect-ratio: 1.45; border-radius: var(--radius-md); background: var(--c-card); border: 1px solid var(--c-line); transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base), box-shadow var(--duration-base); }
  .card__status { position: absolute; top: 8px; left: 8px; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.01em; color: var(--color-muted); background: rgba(255, 255, 255, 0.8); }
  .card__status[data-status='built'], .card__status[data-status='live'] { color: var(--color-ok); }
  .card__status[data-status='testnet'], .card__status[data-status='in-development'] { color: var(--color-warn); }
  .card__name { display: flex; align-items: center; justify-content: space-between; margin-top: 0.4rem; font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-strong); }
  .card__name i { font-style: normal; opacity: 0; transform: translateX(-4px); transition: opacity var(--duration-fast), transform var(--duration-base) var(--ease-out); }
  .card__line { font-size: 0.8rem; line-height: 1.4; color: var(--color-muted); }
  .card:focus-visible .card__tile { border-color: var(--color-brand-bright); }
  .card:focus-visible .card__name i { opacity: 1; transform: none; }
  @media (hover: hover) {
    .card:hover .card__tile { transform: translateY(-3px); border-color: var(--color-border-strong); box-shadow: var(--shadow-soft); }
    .card:hover .card__name i { opacity: 1; transform: none; }
  }

  .flows { display: grid; gap: 0.9rem; }
  .flow { display: grid; grid-template-columns: 11rem minmax(0, 1fr); align-items: center; gap: 1rem; }
  .flow__label { font-size: 0.8rem; font-weight: 600; color: var(--color-muted); }
  .flow__track { display: flex; align-items: center; gap: 0.9rem; min-width: 0; padding: 0.55rem 0.9rem; border-radius: var(--radius-lg); background: var(--c-card); border: 1px solid var(--c-line); }
  .flow__brand { flex: none; width: 40px; height: 40px; border-radius: 10px; }
  .flow__arrow { flex: none; width: 56px; height: 12px; color: var(--color-brand); }
  .flow__items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; min-width: 0; }
  .chip { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.8rem 0.35rem 0.4rem; border-radius: var(--radius-pill); background: #fff; border: 1px solid var(--c-line); font-size: 0.82rem; font-weight: 500; color: var(--color-strong); white-space: nowrap; }
  .chip img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; }
  .chip--word { padding: 0.45rem 0.9rem; font-weight: 600; letter-spacing: -0.01em; }

  /* Narrower desktops: four cards a row, then three. */
  @media (max-width: 1180px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 1180px) and (min-width: 900px) {
    .card__line { display: none; }
  }
  @media (max-width: 899px) {
    .bar__nav > ul { display: none; }
    .stage { gap: 2rem; padding-top: 1rem; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow { grid-template-columns: 1fr; gap: 0.4rem; }
    .flow__track { flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__tile, .card__name i, .menu__panel { transition: none; }
  }
</style>
