---
import '../styles/global.css';
import ProductLogo from '../components/brand/ProductLogo.astro';
import { NAV, LINKS } from '../data/site';
import type { ProductKey } from '../lib/logos';

/* Aretia Finance home: the whole product map on one screen, no scrolling.
   Each card links to the live page for its service. Radar has no page yet, so
   it points at the ecosystem map. Per-product status lives in src/data/site.ts. */
interface Service {
  key: ProductKey;
  name: string;
  line: string;
  href: string;
}

const services: Service[] = [
  { key: 'marketplace', name: 'Aretia Marketplace', line: 'Browse and trade markets across chains', href: '/wallet' },
  { key: 'pay', name: 'Aretia Pay', line: 'Send to a name, not an address', href: '/features#pay' },
  { key: 'swap', name: 'Aretia Swap', line: 'Swap with the price shown first', href: '/wallet' },
  { key: 'carbon', name: 'Aretia Carbon Credit', line: 'Registry-backed, then retired', href: '/carboncredit' },
  { key: 'shield', name: 'Aretia Shield', line: 'Every send checked before you sign', href: '/features#shield' },
  { key: 'safesend', name: 'Aretia SafeSend', line: 'Cancel a send before it lands', href: '/features#safesend' },
  { key: 'radar', name: 'Aretia Radar', line: 'Market and wallet signals', href: '/ecosystem' },
];

/** The chains in Aretia Wallet. Marks: public/assets/chains/CREDITS.md. */
const chains = [
  { name: 'Solana', logo: '/assets/chains/solana.png' },
  { name: 'Ethereum', logo: '/assets/chains/ethereum.png' },
  { name: 'BNB Chain', logo: '/assets/chains/bnb.png' },
  { name: 'Polygon', logo: '/assets/chains/polygon.png' },
  { name: 'Base', logo: '/assets/chains/base.png' },
  { name: 'Arbitrum', logo: '/assets/chains/arbitrum.png' },
  { name: 'Optimism', logo: '/assets/chains/optimism.png' },
  { name: 'Avalanche', logo: '/assets/chains/avalanche.png' },
  { name: 'Robinhood Chain', logo: '/assets/chains/robinhood.png' },
];

/* Carbon registries, with their own logos (trimmed copies in public/assets/registries/).
   `h` is the display height in px, set per logo so each reads at a similar visual weight. */
const registries = [
  { name: 'Gold Standard', logo: '/assets/registries/gold-standard.png', w: 712, h: 352, show: 40 },
  { name: 'Verra', logo: '/assets/registries/verra.png', w: 601, h: 222, show: 30 },
  { name: 'American Carbon Registry', logo: '/assets/registries/american-carbon-registry.png', w: 541, h: 243, show: 36 },
  { name: 'Climate Action Reserve', logo: '/assets/registries/climate-action-reserve.png', w: 324, h: 132, show: 30 },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aretia Finance</title>
    <meta name="description" content="Every Aretia service on one screen: Marketplace, Pay, Swap, Carbon Credit, Shield, SafeSend and Radar, across six chains and the major carbon registries." />
    <link rel="canonical" href="https://aretiafinance.org/" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/ibm-plex-sans/ibm-plex-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="console">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="bar">
      <a class="bar__brand" href="/" aria-label="Aretia Finance home">
        <img src="/assets/logo-mark.png" alt="" width="28" height="28" />
        <span>Aretia<br />Finance</span>
      </a>
      <nav class="bar__nav" aria-label="Primary">
        <ul>
          {
            NAV.map((group) => (
              <li class="menu">
                <button type="button" class="menu__btn" aria-haspopup="true">
                  {group.label}
                  <svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                </button>
                <ul class="menu__panel">
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href}>
                        <b>{item.label}</b>
                        <span>{item.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
        <a class="bar__cta" href={LINKS.buyAct}>Buy ACT</a>
      </nav>
    </header>

    <main id="main" class="stage">
      <section class="intro">
        <h1>Home of <span>Decentralized Finance</span></h1>
        <p>Swap, pay, protect and offset, from one self-custody wallet on every chain you use.</p>
      </section>

      <section class="services" aria-label="Aretia services">
        <ul class="grid">
          {
            services.map((s) => (
              <li>
                <a class="card" href={s.href}>
                  <ProductLogo product={s.key} size={48} />
                  <span class="card__name">{s.name}</span>
                  <span class="card__line">{s.line}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="flows" aria-label="Where Aretia connects">
        <div class="flow">
          <h2 class="flow__label">Chains in Aretia Wallet</h2>
          <ul class="flow__items">
            {
              chains.map((c) => (
                <li class="chain">
                  <img src={c.logo} alt="" width="28" height="28" />
                  <span>{c.name}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flow">
          <h2 class="flow__label">Tokenisation of Carbon Credit is coming to:</h2>
          <ul class="flow__items flow__items--logos">
            {
              registries.map((r) => (
                <li>
                  <img src={r.logo} alt={r.name} width={r.w} height={r.h} style={`height:${r.show}px`} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  /* IBM Plex Sans: a clear, open grotesque with a banking heritage; self-hosted, scoped to this page. */
  @font-face {
    font-family: 'IBM Plex Sans';
    src: url('/fonts/ibm-plex-sans/ibm-plex-sans-latin-wght-normal.woff2') format('woff2');
    font-weight: 100 700;
    font-style: normal;
    font-display: swap;
  }

  body.console {
    --font-display: 'IBM Plex Sans', -apple-system, system-ui, 'Segoe UI', sans-serif;
    --font-body: 'IBM Plex Sans', -apple-system, system-ui, 'Segoe UI', sans-serif;
    --c-card: #f5f5f7;
    --c-line: rgba(14, 11, 43, 0.09);
    background: #fff;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* One screen on desktop: the page is exactly the viewport tall and never scrolls.
     Below 900px wide, or when the window is too short to fit it, it scrolls normally. */
  @media (min-width: 900px) and (min-height: 720px) {
    html, body.console { height: 100dvh; overflow: hidden; }
  }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 0 clamp(1rem, 4vw, 3rem); height: 64px; flex: none; position: relative; z-index: 5; }
  .bar__brand { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 1rem; font-weight: 600; line-height: 1.05; letter-spacing: -0.01em; color: var(--color-strong); }
  .bar__brand img { width: 30px; height: 30px; border-radius: 8px; }
  .bar__nav { display: flex; align-items: center; gap: 0.25rem; }
  .bar__nav ul { list-style: none; margin: 0; padding: 0; }
  .bar__nav > ul { display: flex; gap: 0.1rem; }
  .menu { position: relative; }
  .menu__btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.9rem; font-weight: 500; color: var(--color-text); transition: background-color var(--duration-fast); }
  .menu__panel { position: absolute; top: 100%; left: 0; min-width: 290px; padding: 0.4rem; margin-top: 6px; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-md); box-shadow: var(--shadow-float); opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity var(--duration-fast), transform var(--duration-fast) var(--ease-out), visibility var(--duration-fast); }
  /* Bridges the 6px gap so the pointer can travel from button to panel. */
  .menu__panel::before { content: ''; position: absolute; inset: -8px 0 auto; height: 8px; }
  .menu:hover .menu__panel, .menu:focus-within .menu__panel { opacity: 1; visibility: visible; transform: none; }
  .menu__panel a { display: flex; flex-direction: column; gap: 1px; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
  .menu__panel b { font-size: 0.875rem; font-weight: 600; color: var(--color-strong); }
  .menu__panel span { font-size: 0.78rem; color: var(--color-faint); }
  .bar__cta { margin-left: 0.5rem; padding: 0.5rem 1.05rem; border-radius: var(--radius-sm); font-size: 0.9rem; font-weight: 600; color: var(--color-strong); border: 1px solid var(--c-line); background: var(--c-card); transition: border-color var(--duration-fast); }
  @media (hover: hover) {
    .menu__btn:hover { background: rgba(14, 11, 43, 0.05); }
    .bar__cta:hover { border-color: var(--color-border-strong); }
  }

  .stage { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-evenly; gap: 1.25rem; width: 100%; max-width: 1360px; margin-inline: auto; padding: 0 clamp(1rem, 4vw, 3rem) clamp(1rem, 2.5vh, 1.75rem); }

  .intro { text-align: center; }
  .intro h1 { font-size: clamp(2.25rem, min(5vw, 8.5vh), 4.25rem); font-weight: 500; line-height: 1.06; letter-spacing: -0.03em; }
  .intro h1 span { display: block; color: var(--color-brand); }
  .intro p { margin: 0.9rem auto 0; max-width: 46ch; font-size: clamp(0.95rem, 1.7vh, 1.1rem); color: var(--color-muted); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.75rem; }
  /* One soft grey card per service: icon at the top left, then the name and a short line. */
  .grid li { display: flex; }
  .card { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; width: 100%; padding: 1.1rem 1.1rem 1.25rem; border-radius: var(--radius-lg); background: var(--c-card); color: inherit; transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base); }
  .card .pl { margin-bottom: 0.9rem; }
  .card__name { font-size: 0.95rem; font-weight: 600; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-strong); }
  .card__line { font-size: 0.82rem; line-height: 1.4; color: var(--color-muted); }
  .card:focus-visible { outline: 2px solid var(--color-brand-bright); outline-offset: 3px; }
  @media (hover: hover) {
    .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); }
  }

  .flows { display: grid; gap: 1.1rem; }
  .flow { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; text-align: center; }
  .flow__label { font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.005em; color: var(--color-strong); }
  .flow__items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.6rem 1.75rem; min-width: 0; }
  .chain { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; font-weight: 500; color: var(--color-strong); white-space: nowrap; }
  .chain img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; }
  .flow__items--logos { gap: 0.5rem 2.5rem; }
  .flow__items--logos img { width: auto; max-width: none; }

  @media (max-width: 899px) {
    .bar__nav > ul { display: none; }
    .stage { gap: 2rem; padding-top: 1rem; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .menu__panel { transition: none; }
  }
</style>
