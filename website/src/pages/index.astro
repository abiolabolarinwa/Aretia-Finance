---
/* aretiafinance.org opens straight on Markets. The single-screen home page lives at /home. A script does the jump at once; the
   refresh tag and the link cover a browser with scripts off. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aretia Finance</title>
    <meta name="description" content="Aretia Finance: create your own token, give it a market and trade thousands of others from one wallet." />
    <meta http-equiv="refresh" content="0; url=/wallet#/swings" />
    <link rel="canonical" href="https://aretiafinance.org/wallet" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <script is:inline>
      location.replace('/wallet#/swings');
    </script>
  </head>
  <body>
    <p><a href="/wallet#/swings">Open Aretia Markets</a></p>
  </body>
</html>
