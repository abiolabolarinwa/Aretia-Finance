---
import '../styles/global.css';
import { LINKS } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aretia Finance</title>
    <meta name="description" content="Aretia Finance is building multichain financial infrastructure: a self-custody wallet, cross-chain ACT, name-based payments, pre-send safety checks and a treasury that funds climate projects." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#fbfbfd" />
  </head>
  <body>
    <main class="welcome">
      <a class="welcome__brand" href="/home">
        <img src="/assets/logo-mark-green.png" alt="" width="24" height="24" />
        <span>Aretia</span>
      </a>

      <div class="welcome__inner">
        <h1 class="welcome__word">
          <span>Aretia</span>
          <span>Finance</span>
        </h1>
        <p class="welcome__lead">Multichain self-custody, built so every transfer funds a climate treasury.</p>

        <div class="welcome__actions">
          <a class="wbtn wbtn--solid" href={LINKS.walletWaitlist}>Join the Aretia Wallet Waitlist</a>
          <a class="wbtn wbtn--outline" href="/home">Explore Aretia Finance</a>
        </div>

        <ul class="welcome__chains" aria-label="Aretia, and the chains it supports">
          <li class="welcome__chain-icon welcome__chain-icon--aretia"><img src="/assets/logo-mark-green.png" alt="Aretia Finance" width="28" height="28" /></li>
          <li class="welcome__chain-icon"><img src="/assets/chains/solana.png" alt="Solana" width="28" height="28" /></li>
          <li class="welcome__chain-icon"><img src="/assets/chains/ethereum.png" alt="Ethereum" width="28" height="28" /></li>
          <li class="welcome__chain-icon"><img src="/assets/chains/base.png" alt="Base" width="28" height="28" /></li>
          <li class="welcome__chain-icon"><img src="/assets/chains/polygon.png" alt="Polygon" width="28" height="28" /></li>
          <li class="welcome__chain-icon"><img src="/assets/chains/bnb.png" alt="BNB Smart Chain" width="28" height="28" /></li>
        </ul>

        <p class="welcome__note">The wallet's browser extension is in development and not yet on the Chrome Web Store.</p>
      </div>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Rostex';
    src: url('/fonts/rostex/Rostex-Regular.ttf') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  .welcome {
    position: relative;
    min-height: 100svh;
    background: var(--color-offwhite);
    display: grid;
    place-items: center;
  }

  .welcome__brand {
    position: fixed;
    top: clamp(1.25rem, 3vw, 2rem);
    left: clamp(1.25rem, 3vw, 2rem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-strong);
  }
  .welcome__brand img { border-radius: 6px; }

  .welcome__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
    padding: clamp(4rem, 8vw, 6rem) var(--gutter) clamp(6rem, 10vw, 8rem);
  }

  .welcome__word {
    display: grid;
    line-height: 0.95;
    font-family: 'Rostex', var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-strong);
  }

  .welcome__lead {
    max-width: 30rem;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .welcome__actions {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 22rem;
    margin-top: var(--space-sm);
  }

  .wbtn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 1rem;
    transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .wbtn--solid { background: var(--color-strong); color: #fff; box-shadow: var(--shadow-soft); }
  .wbtn--outline { background: #fff; color: var(--color-strong); border: 1px solid var(--color-border-strong); }
  .wbtn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .wbtn--solid:hover { background: var(--color-brand); }
    .wbtn--outline:hover { border-color: var(--color-strong); }
  }

  .welcome__chains {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .welcome__chain-icon {
    display: flex;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .welcome__chain-icon img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .welcome__chain-icon--aretia { background: var(--color-brand); box-shadow: none; margin-right: 0.35rem; align-items: center; justify-content: center; }
  .welcome__chain-icon--aretia img { width: 68%; height: 68%; object-fit: contain; }

  .welcome__note { font-size: var(--text-micro); color: var(--color-faint); max-width: 26rem; }
</style>
