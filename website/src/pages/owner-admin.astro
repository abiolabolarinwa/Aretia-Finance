---
import Base from '../layouts/Base.astro';
---

<Base title="Owner" description="Private." ctaBands={false} footer={false}>
  <meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
  <div class="oa">
    <h1>Owner</h1>
    <p class="oa-note">Private. Sign in with the owner wallet (a free signed message, not a transaction). The server decides who may see anything here.</p>
    <div id="owner-admin-buttons" class="oa-row"></div>
    <p id="owner-admin-status" class="oa-note" role="status"></p>
    <div id="owner-admin"></div>
  </div>
  <script>
    import '../scripts/ownerAdmin';
  </script>
</Base>

<style is:global>
  .oa { max-width: 1100px; margin: 0 auto; padding: 96px 16px 64px; }
  .oa h1 { font-size: 28px; margin: 0 0 8px; }
  .oa h2 { font-size: 16px; margin: 0 0 4px; }
  .oa h3 { font-size: 14px; margin: 14px 0 4px; }
  .oa-note { opacity: 0.7; font-size: 13px; margin: 0 0 10px; }
  .oa-warn { color: #9a5b00; font-size: 14px; }
  .oa-row { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
  .oa-btn { font: inherit; padding: 10px 14px; border-radius: 10px; border: 1px solid #c9c7e0; background: transparent; color: inherit; cursor: pointer; }
  .oa-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 16px; margin-bottom: 16px; }
  .oa-card { border: 1px solid #e4e2f2; border-radius: 14px; padding: 16px; overflow-x: auto; }
  .oa-big { font-size: 32px; font-weight: 700; margin: 4px 0 8px; }
  .oa table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .oa td, .oa th { padding: 6px 8px; border-top: 1px solid #e4e2f2; text-align: left; }
  .oa th { font-size: 12px; opacity: 0.7; }
  .oa .r { text-align: right; }
  @media (prefers-color-scheme: dark) { .oa-card, .oa td, .oa th { border-color: #2b2945; } .oa-btn { border-color: #3a3860; } }
</style>
