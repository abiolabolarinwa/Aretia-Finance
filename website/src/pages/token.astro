---
import Base from '../layouts/Base.astro';
import PageHero from '../components/typography/PageHero.astro';
import ActSection from '../components/token/ActSection.astro';
import Button from '../components/buttons/Button.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import { ACT, LINKS } from '../data/site';

const pct = (n: number) => (n / ACT.totalSupply) * 100;
const liquiditySeed = 10_000_000;
const segments = [
  { label: 'Liquidity pools', amount: liquiditySeed, status: 'live' as const, note: 'Two Meteora pools, ACT/USDC and ACT/SOL, opened 2 Oct 2026 with 5,000,000 ACT each before ACT’s 1.5% fee (about 4.92M landed in each). Liquidity permanently locked.' },
  { label: 'Treasury-held, allocation to be published', amount: ACT.totalSupply - liquiditySeed, status: undefined, note: 'Held in the 2-of-3 treasury multisig. No further allocation has been published.' },
];
const facts = [
  { k: 'Network', v: `${ACT.network} mainnet` },
  { k: 'Standard', v: ACT.standard },
  { k: 'Decimals', v: '9' },
  { k: 'Mint authority', v: ACT.mintAuthority },
  { k: 'Freeze authority', v: ACT.freezeAuthority },
  { k: 'Fee authority', v: 'Treasury 2-of-3 multisig' },
];
---

<Base title="Token" description="Token pages on Aretia: price, chart, supply and the facts that can be read from the chain for a token on Solana, BNB Chain, Ethereum or Polygon, with a buy in the Aretia wallet. Also ACT, Aretia's own token: fixed 1,000,000,000 supply, 1.5% transfer fee funding the Climate Treasury.">
  <section class="section tkp-section" id="tkp-section" hidden aria-live="polite"><div class="container"><div id="tkp-root" class="tkp"></div></div></section>
  <div id="act-page">
  <PageHero
    eyebrow="Token"
    title="ACT"
    size="mega"
    lead="Aretia's ecosystem token. A fixed-supply SPL Token-2022 mint on Solana, with a transfer fee enforced by the token program itself."
  />

  <section class="section tk-facts" aria-labelledby="supply-title">
    <div class="container">
      <div class="supply">
        <div class="supply__head">
          <h2 id="supply-title" class="label">Total supply</h2>
          <p class="supply__big tnum" data-count={ACT.totalSupply}>{ACT.totalSupply.toLocaleString('en-US')}</p>
          <p class="muted">Minted once, in a single instruction. Mint authority revoked: the supply can never increase.</p>
        </div>

        <div class="bar" data-reveal role="img" aria-label="ACT supply: 1% in locked liquidity pools, 99% held in the treasury multisig with allocation to be published">
          {segments.map((s, i) => <span class={`bar__seg bar__seg--${i}`} style={`--w:${pct(s.amount)}%`} />)}
        </div>
        <ul class="legend">
          {
            segments.map((s, i) => (
              <li data-reveal>
                <span class={`legend__dot bar__seg--${i}`} />
                <div>
                  <b>{s.label}</b>
                  <span class="tnum">{s.amount.toLocaleString('en-US')} ACT · {pct(s.amount).toLocaleString('en-US', { maximumFractionDigits: 1 })}%</span>
                  <small>{s.note}</small>
                </div>
                {s.status && <StatusBadge status={s.status} />}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="contract paper paper--gold" data-reveal>
        <h2 class="label">Contract</h2>
        <div class="contract__mint">
          <span class="mono" data-mint>{ACT.mint}</span>
          <button type="button" class="contract__copy" data-copy={ACT.mint} aria-label="Copy mint address">Copy</button>
        </div>
        <dl class="contract__facts">
          {facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
        <div class="contract__actions">
          <Button href={LINKS.explorerMint} variant="secondary" external arrow>View on Solscan</Button>
          <Button href={`/wallet#/swap/solana/${ACT.mint}`} variant="secondary">Swap in the Aretia wallet</Button>
          <Button href="/verify" variant="ghost">Verify on-chain</Button>
        </div>
      </div>
    </div>
  </section>

  <div id="fees"><ActSection /></div>

  <section class="section disclaimer" aria-label="Important information">
    <div class="container">
      <p>ACT is a utility token for the Aretia ecosystem. Nothing on this page is an offer, investment advice or a promise of value, returns or price. Digital assets are volatile and you can lose everything you put in. Read the <a href="/terms#risk">risk disclosure</a>.</p>
    </div>
  </section>
  </div>
</Base>

<style>
  .tk-facts .container { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-xl); align-items: start; }
  .supply { display: grid; gap: var(--space-lg); }
  .supply__head { display: grid; gap: var(--space-xs); }
  .supply__big { font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 600; letter-spacing: -0.04em; color: var(--color-strong); line-height: 1; }
  .bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: rgba(0, 0, 0, 0.05); gap: 2px; }
  .bar__seg { width: var(--w); min-width: 6px; }
  .bar__seg--0 { background: var(--color-gold); }
  .bar__seg--1 { background: var(--color-brand-bright); }
  .bar__seg--2 { background: repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.14) 0 6px, rgba(0, 0, 0, 0.05) 6px 12px); }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; }
  .legend li { display: grid; grid-template-columns: 12px minmax(0, 1fr) auto; gap: 14px; align-items: start; padding: 16px 0; border-top: 1px solid var(--color-border); }
  .legend__dot { width: 12px; height: 12px; border-radius: 3px; margin-top: 4px; }
  .legend div { display: grid; gap: 2px; }
  .legend b { color: var(--color-strong); font-size: 15px; }
  .legend span { font-size: var(--text-small); color: var(--color-muted); }
  .legend small { font-size: var(--text-micro); color: var(--color-faint); }
  .contract { display: grid; gap: var(--space-md); padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--radius-lg); }
  .contract .label { color: var(--c-muted); }
  .contract__mint { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.16); }
  .contract__mint .mono { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 13px; color: #e0bd6a; }
  .contract__copy { flex: none; font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.4); color: #fff; transition: background-color var(--duration-fast); min-height: 32px; }
  .contract__facts { margin: 0; display: grid; }
  .contract__facts div { display: flex; justify-content: space-between; gap: 1rem; padding: 10px 0; border-top: 1px solid rgba(255, 255, 255, 0.14); font-size: var(--text-small); }
  .contract__facts dt { color: rgba(255, 255, 255, 0.6); }
  .contract__facts dd { margin: 0; color: #fff; text-align: right; }
  .contract__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .disclaimer p { font-size: var(--text-small); color: var(--color-faint); max-width: 52rem; }
  .disclaimer a { color: var(--color-muted); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1023px) {
    .tk-facts .container { grid-template-columns: minmax(0, 1fr); }
  }
  @media (hover: hover) and (pointer: fine) {
    .contract__copy:hover { background: rgba(255, 255, 255, 0.12); }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
        window.setTimeout(() => (btn.textContent = 'Copy'), 1600);
      } catch {
        btn.textContent = 'Select & copy';
      }
    });
  });
</script>

<style is:global>
  .tkp-section[hidden] { display: none; }
  .tkp { --tkp-line: var(--color-border, #e3e0d8); display: grid; gap: 16px; max-width: 1240px; margin-inline: auto; padding-block: clamp(1rem, 4vw, 2.5rem); }
  .tkp-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; padding: 12px 16px; border: 1px solid var(--tkp-line); border-radius: 16px; background: var(--color-bg); }
  .tkp-head .tkp-avatar { width: 44px; height: 44px; }
  .tkp-head .tkp-name { font-size: clamp(1.15rem, 4vw, 1.5rem); }
  .tkp-head .tkp-sub { font-size: 13px; }
  .tkp-headline { display: flex; align-items: baseline; gap: 10px; }
  .tkp-price { font-size: 1.35rem; font-weight: 650; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .tkp-chg { padding: 2px 9px; font-size: 13px; font-weight: 600; border-radius: 999px; background: var(--color-surface-2, #f4f4f5); color: var(--color-muted); }
  .tkp-chg.is-up { color: #1b8a4b; background: rgba(27, 138, 75, 0.1); }
  .tkp-chg.is-down { color: #b3261e; background: rgba(179, 38, 30, 0.1); }
  .tkp-toggle { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 14px; font: inherit; font-size: 13px; font-weight: 600; color: inherit; background: var(--color-surface-2, #f4f4f5); border: 1px solid var(--tkp-line); border-radius: 999px; cursor: pointer; }
  .tkp-toggle:hover, .tkp-edge:hover { border-color: var(--color-brand); }
  .tkp-toggle-ico { font-size: 15px; line-height: 1; color: var(--color-brand); }
  .tkp-toggle:focus-visible, .tkp-edge:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .tkp-grid { --tkp-panel: 360px; --tkp-gap: 16px; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) var(--tkp-panel); gap: var(--tkp-gap); align-items: start; transition: grid-template-columns 240ms var(--ease-out), column-gap 240ms var(--ease-out); }
  .tkp-grid.is-collapsed { --tkp-panel: 0px; --tkp-gap: 0px; }
  .tkp-main { display: grid; gap: 16px; min-width: 0; }
  .tkp-side { position: sticky; top: calc(var(--nav-height, 72px) + 12px); display: grid; gap: 12px; align-content: start; min-width: 0; max-height: calc(100vh - var(--nav-height, 72px) - 24px); overflow-y: auto; padding: 14px; border: 1px solid var(--tkp-line); border-radius: 16px; background: var(--color-bg); transition: opacity 180ms var(--ease-out), padding 240ms var(--ease-out), border-width 240ms; }
  .tkp-grid.is-collapsed .tkp-side { padding-inline: 0; border-width: 0; opacity: 0; overflow: hidden; pointer-events: none; }
  .tkp-side .tkp-actions { grid-template-columns: 1fr auto; margin-top: 0; }
  .tkp-side .tkp-grid2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tkp-edge { position: absolute; z-index: 3; top: 90px; right: max(0px, calc(var(--tkp-panel) + var(--tkp-gap) - 13px)); width: 26px; height: 52px; padding: 0; font-size: 16px; line-height: 1; color: var(--color-muted); background: var(--color-bg); border: 1px solid var(--tkp-line); border-radius: 10px; cursor: pointer; box-shadow: var(--shadow-soft); transition: right 240ms var(--ease-out); }
  .tkp-logohost { grid-row: 1; }
  .tkp-avatar { width: 56px; height: 56px; border-radius: 50%; display: inline-grid; place-items: center; background: var(--color-surface-2, #efece4); font-weight: 600; color: var(--color-strong, #1a1a1a); object-fit: cover; }
  .tkp-name { margin: 0; font-size: clamp(1.5rem, 6vw, 2.25rem); line-height: 1.1; overflow-wrap: anywhere; }
  .tkp-sub { margin: 2px 0 0; color: var(--color-muted, #666); font-size: 15px; }
  .tkp-addr, .tkp-actions, .tkp-head > .tkp-fine, .tkp-metahost { grid-column: 1 / -1; }
  .tkp-metahost:empty { display: none; }
  .tkp-meta { display: grid; gap: 8px; margin-top: 8px; }
  .tkp-desc { margin: 0; font-size: 15px; line-height: 1.5; white-space: pre-line; overflow-wrap: anywhere; }
  .tkp-links { margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tkp-links a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border: 1px solid var(--tkp-line); border-radius: 999px; font-size: 13px; font-weight: 600; color: inherit; text-decoration: none; }
  .tkp-note { margin: 0; font-size: 12px; color: var(--color-muted, #666); }
  .tkp-addr { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding: 8px 10px; border: 1px solid var(--tkp-line); border-radius: 12px; }
  .tkp-code { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 12.5px; }
  .tkp-copy, .tkp-btn { min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--tkp-line); background: transparent; color: inherit; font: inherit; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
  .tkp-copy { min-height: 36px; padding: 0 12px; font-size: 13px; }
  .tkp-actions { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-top: 6px; }
  .tkp-btn--primary { background: var(--color-brand, #1f6f4a); border-color: transparent; color: #fff; }
  .tkp-btn[aria-disabled='true'] { opacity: 0.55; pointer-events: none; }
  .tkp-card { border: 1px solid var(--tkp-line); border-radius: 16px; padding: 16px; display: grid; gap: 10px; }
  .tkp-h { margin: 0; font-size: 1.05rem; }
  .tkp-body { display: grid; gap: 12px; }
  .tkp-fine { margin: 0; font-size: 13px; color: var(--color-muted, #666); }
  .tkp-warn { padding: 0 2px; }
  .tkp-facts { margin: 0; display: grid; }
  .tkp-fact { display: grid; gap: 2px; padding: 10px 0; border-top: 1px solid var(--tkp-line); }
  .tkp-fact:first-child { border-top: 0; }
  .tkp-fact dt { font-size: 13px; color: var(--color-muted, #666); }
  .tkp-fact dd { margin: 0; overflow-wrap: anywhere; }
  .tkp-fact--good dd::before { content: '✓ '; color: #1f7a45; font-weight: 700; }
  .tkp-fact--warn dd::before { content: '! '; color: #b3541e; font-weight: 700; }
  .tkp-fact--unknown dd { color: var(--color-muted, #666); }
  .tkp-fact--unknown dd::before { content: '? '; font-weight: 700; }
  .tkp-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tkp-stat { display: grid; gap: 2px; padding: 10px; border-radius: 12px; background: var(--color-surface-2, #f4f1ea); }
  .tkp-k { font-size: 12px; color: var(--color-muted, #666); }
  .tkp-v { font-size: 15px; overflow-wrap: anywhere; }
  .tkp-chart { height: 520px; border-radius: 12px; overflow: hidden; border: 1px solid var(--tkp-line); }
  .tkp-chart iframe { width: 100%; height: 100%; border: 0; }
  .tkp-bar { height: 12px; border-radius: 999px; background: var(--color-surface-2, #ece8de); overflow: hidden; }
  .tkp-bar-fill { display: block; height: 100%; background: var(--color-brand, #1f6f4a); }
  .tkp-status { margin: 0; font-weight: 600; }
  .tkp-link { color: inherit; text-decoration: underline; text-underline-offset: 3px; font-size: 14px; }
  @media (max-width: 1000px) { .tkp-grid, .tkp-grid.is-collapsed { grid-template-columns: minmax(0, 1fr); --tkp-gap: 16px; } .tkp-side { position: static; max-height: none; } .tkp-grid.is-collapsed .tkp-side { display: none; } .tkp-edge { display: none; } .tkp-toggle { margin-left: 0; } }
  @media (min-width: 720px) { .tkp-grid2 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .tkp-actions { grid-template-columns: auto auto; justify-content: start; } .tkp-chart { height: 640px; } }
</style>

<script>
  import { parseTokenPageHash } from '../scripts/tokenPageCore';
  import { mountPublicTokenPage, type TokenPageHandle } from '../scripts/walletTokenPublic';

  const act = document.getElementById('act-page');
  const section = document.getElementById('tkp-section');
  const root = document.getElementById('tkp-root');
  let handle: TokenPageHandle | null = null;
  let shown = '';

  function route(): void {
    if (!act || !section || !root) return;
    const ref = parseTokenPageHash(location.hash);
    if (!ref) {
      handle?.dispose();
      handle = null;
      shown = '';
      section.hidden = true;
      act.hidden = false;
      return;
    }
    const key = `${ref.chain}:${ref.address}`;
    if (key === shown) return;
    handle?.dispose();
    shown = key;
    act.hidden = true;
    section.hidden = false;
    handle = mountPublicTokenPage(root, ref);
    window.scrollTo(0, 0);
  }
  window.addEventListener('hashchange', route);
  route();
</script>
