---
import Base from '../layouts/Base.astro';
import Button from '../components/buttons/Button.astro';
import WalletMock from '../components/wallet/WalletMock.astro';
import NetworkField from '../components/hero/NetworkField.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import InfoGrid from '../components/cards/InfoGrid.astro';
import { LINKS, NETWORKS, SECURITY, type Status } from '../data/site';

const capabilities: { title: string; body: string; status: Status; href?: string }[] = [
  { title: 'Multichain', body: `${NETWORKS.join(', ')}. One recovery phrase, one place.`, status: 'built' },
  { title: 'Asset management', body: 'Balances across chains, custom token import, and hide what you do not want to see.', status: 'built' },
  { title: 'Send', body: 'To an address, an ENS name or a .sol name, with a decoded review before you sign.', status: 'built' },
  { title: 'Receive', body: 'Your address and QR code for every supported network.', status: 'built' },
  { title: 'Swap', body: 'Token swaps on Solana routed through Jupiter, quoted before you confirm.', status: 'built' },
  { title: 'Bridge · Universal', body: 'ACT between Solana and Ethereum over Wormhole NTT, delivered automatically.', status: 'testnet', href: '/features#universal' },
  { title: 'ACT', body: 'Hold, send and track ACT alongside everything else.', status: 'built', href: '/token' },
  { title: 'Shield', body: 'Recipient and approval checks before every send.', status: 'built', href: '/features#shield' },
  { title: 'Intent', body: 'Type a phrase like “send 5 ACT to alex.sol” and review the transaction it builds.', status: 'built', href: '/features#intent' },
  { title: 'Security', body: 'AES-256-GCM encrypted keys, auto-lock, per-site permissions and an approval queue.', status: 'built', href: '#security' },
];
---

<Base title="Aretia Wallet" description="Aretia Wallet: a self-custody wallet for Solana and EVM networks with name-based payments, pre-send safety checks, plain-language transactions and cross-chain ACT.">
  <section class="whero" data-tilt-zone>
    <NetworkField density={0.7} />
    <div class="container whero__grid">
      <div class="whero__copy">
        <div class="whero__meta" data-reveal>
          <StatusBadge status="in-development" />
        </div>
        <h1 class="whero__title" data-split="load">Your assets.<br />Your chains.<br />Your control.</h1>
        <p class="lead" data-reveal>A self-custody browser wallet for Solana and EVM networks, with the rest of Aretia built in. Keys stay encrypted on your device.</p>
        <div class="whero__ctas" data-reveal>
          <Button href={LINKS.walletWaitlist} size="lg" arrow>Join the waitlist</Button>
          <Button href="/features" size="lg" variant="secondary">All features</Button>
        </div>
        <p class="whero__note" data-reveal>The browser extension is not yet on the Chrome Web Store. Join the waitlist and we'll email you the moment you can install it.</p>
      </div>
      <div class="whero__visual" data-reveal="scale">
        <img class="whero__photo" src="/images/people/friends-hugging.webp" alt="Three friends laughing and hugging outdoors" fetchpriority="high" />
        <WalletMock class="whero__mock" />
      </div>
    </div>
  </section>

  <section class="rail" aria-labelledby="rail-title" data-rail>
    <div class="container rail__head">
      <h2 id="rail-title" class="heading" data-split>Ten things. One wallet.</h2>
    </div>
    <div class="rail__viewport">
      <ol class="rail__track" data-rail-track>
        {
          capabilities.map((c, i) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <li class="rail__item">
                <Tag class="rail__card" {...(c.href ? { href: c.href } : {})}>
                  <span class="rail__num tnum">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="rail__title">{c.title}</h3>
                  <p>{c.body}</p>
                  <StatusBadge status={c.status} />
                </Tag>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="section" id="security" aria-labelledby="wsec-title">
    <div class="container wsec">
      <header class="wsec__head">
        <h2 id="wsec-title" class="heading" data-split>Self-custody, by design.</h2>
      </header>
      <InfoGrid items={SECURITY} />
    </div>
  </section>

  <section class="section" id="waitlist" aria-labelledby="wl-title">
    <div class="container wl">
      <div class="wl__copy">
        <h2 id="wl-title" class="heading" data-split>Get notified when it ships.</h2>
        <p class="lead" data-reveal>No download yet — the extension is still pre-release. Leave your email and we'll send one message the day it's on the Chrome Web Store, nothing else.</p>
      </div>
      <form class="wl__form" action={LINKS.contactForm} method="POST" novalidate data-waitlist>
        <input type="hidden" name="_subject" value="Wallet waitlist" data-subject />
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="wl__row">
          <label class="sr-only" for="wl-email">Email address</label>
          <input id="wl-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required aria-describedby="wl-err" data-email />
          <button type="submit" class="submit" data-submit>Join waitlist</button>
        </div>
        <p class="err" id="wl-err" data-err></p>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .whero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; isolation: isolate; padding-top: var(--nav-height); }
  .whero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-xl); align-items: center; padding-block: var(--space-2xl); }
  .whero__copy { display: grid; gap: var(--space-md); justify-items: start; }
  .whero__meta { display: flex; flex-wrap: wrap; gap: 0.9rem; align-items: center; }
  .whero__title { font-family: var(--font-topical); font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; }
  .whero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .whero__note { font-size: var(--text-small); color: var(--color-faint); max-width: 30rem; }
  .whero__visual { position: relative; display: grid; place-items: end center; isolation: isolate; border-radius: var(--radius-xl); overflow: hidden; padding: clamp(14rem, 24vw, 19rem) clamp(1rem, 3vw, 2rem) 0; max-height: 720px; }
  .whero__visual :global(.whero__mock) { margin-bottom: -2rem; }
  .whero__photo { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 10%; }

  .rail { padding-block: var(--space-3xl); overflow: hidden; }
  .rail__head { display: grid; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .rail__viewport { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-inline: max(var(--gutter), calc((100vw - var(--max-width)) / 2 + var(--gutter))); }
  .rail__viewport::-webkit-scrollbar { display: none; }
  .rail__track { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; width: max-content; }
  .rail__item { scroll-snap-align: start; }
  .rail__card { display: grid; align-content: start; gap: 0.9rem; width: clamp(260px, 26vw, 340px); min-height: 320px; padding: 1.75rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-bg-alt); transition: border-color var(--duration-base), transform var(--duration-base) var(--ease-out), background-color var(--duration-base); }
  @media (hover: hover) and (pointer: fine) { a.rail__card:hover { border-color: var(--color-border-strong); transform: translateY(-4px); background: var(--color-surface); } }
  .rail__num { font-family: var(--font-display); font-size: 3rem; font-weight: 600; letter-spacing: -0.04em; color: rgba(0, 0, 0, 0.08); line-height: 1; }
  .rail__title { font-size: 1.5rem; letter-spacing: -0.02em; }
  .rail__card p { color: var(--color-muted); font-size: var(--text-small); }
  .rail__card :global(.badge) { justify-self: start; margin-top: auto; }
  /* Desktop with motion: vertical scroll drives the rail sideways (see script). */
  :global(html.motion-ok) .rail.is-pinned .rail__viewport { overflow: visible; }

  .wsec { display: grid; gap: var(--space-2xl); }
  .wsec__head { display: grid; gap: var(--space-md); }

  /* Same solid-logo-green treatment as the shared closing CtaBands, so the
     last word on this page carries the same confidence as every other. */
  .wl { display: grid; gap: var(--space-xl); padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3.5rem); border-radius: var(--radius-xl); background: var(--color-brand); color: #fff; justify-items: center; text-align: center; }
  .wl .heading { color: #fff; }
  .wl__copy { display: grid; gap: var(--space-sm); max-width: 34rem; justify-items: center; }
  .wl__copy .lead { color: rgba(255, 255, 255, 0.78); }
  .wl__form { width: 100%; max-width: 30rem; display: grid; gap: 8px; }
  .hp { position: absolute; left: -9999px; }
  .wl__row { display: flex; gap: 0.6rem; }
  .wl__row input { flex: 1; min-width: 0; padding: 0 16px; height: 52px; border-radius: var(--radius-pill); border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.08); color: #fff; font-size: 1rem; transition: border-color var(--duration-fast), box-shadow var(--duration-fast); }
  .wl__row input::placeholder { color: rgba(255, 255, 255, 0.55); }
  .wl__row input:focus { outline: none; border-color: #fff; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.18); }
  .wl__row input[aria-invalid='true'] { border-color: #ffb4a8; }
  .wl .submit { flex: none; display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 1.75rem; border-radius: var(--radius-pill); background: #fff; color: var(--color-brand); font-weight: 600; transition: background-color var(--duration-base); }
  .wl .submit[disabled] { opacity: 0.6; cursor: default; }
  .wl .err { font-size: var(--text-micro); color: #ffb4a8; min-height: 1em; }
  .wl .status { font-size: var(--text-small); min-height: 1.2em; color: rgba(255, 255, 255, 0.78); }
  .wl .status.is-ok { color: var(--color-mint); }
  .wl .status.is-err { color: #ffb4a8; }
  @media (hover: hover) and (pointer: fine) {
    .wl .submit:hover { background: var(--color-mint); }
  }
  @media (max-width: 600px) {
    .wl__row { flex-direction: column; }
    .wl .submit { width: 100%; justify-content: center; }
  }

  @media (max-width: 1023px) {
    .whero__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion, isDesktop } from '../scripts/motion';

  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const track = document.querySelector<HTMLElement>('[data-rail-track]');
  if (rail && track && !reducedMotion() && isDesktop()) {
    rail.classList.add('is-pinned');
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + 120);
    gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: rail,
        start: 'top top',
        end: () => `+=${distance()}`,
        pin: true,
        scrub: 0.6,
        invalidateOnRefresh: true,
      },
    });
    ScrollTrigger.refresh();
  }
</script>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]')!;
  const email = form.querySelector<HTMLInputElement>('[data-email]')!;
  const err = form.querySelector<HTMLElement>('[data-err]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

  const validate = (): boolean => {
    const msg = !email.value.trim() ? 'Enter your email.' : email.validity.typeMismatch ? 'That doesn’t look like an email address.' : '';
    email.setAttribute('aria-invalid', String(!!msg));
    err.textContent = msg;
    return !msg;
  };
  email.addEventListener('blur', validate);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) {
      email.focus();
      return;
    }
    submit.disabled = true;
    status.className = 'status';
    status.textContent = 'Joining…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.classList.add('is-ok');
      status.textContent = 'You’re on the list. We’ll email you the moment the extension is on the Chrome Web Store.';
    } catch {
      status.classList.add('is-err');
      status.textContent = 'Something went wrong. Please try again, or reach us on Telegram.';
    } finally {
      submit.disabled = false;
    }
  });
</script>
