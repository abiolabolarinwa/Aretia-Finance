  .lh-chip__logo[src$='/solana.png'], .lh-token__netlogo[src$='/solana.png'] { padding: 4px; background: #0b0b12; box-sizing: border-box; }
  .lh-chip.is-on .lh-chip__logo { box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9); }
