  @media (max-width: 640px) { .lh-det__links { grid-template-columns: 1fr; } }
  /* Before you sign. */
  .lh-check { display: grid; gap: 8px; padding: 14px; border: 1px solid var(--color-border); border-radius: 14px; background: var(--color-bg-alt); }
  .lh-check__h { margin: 0; font-size: 13px; color: var(--color-strong); }
