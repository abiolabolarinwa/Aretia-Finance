  .lh__step[data-step='market'][data-ready='0']:hover, .lh__step[data-step='market'][data-ready='0']:focus-within { opacity: 1; }
  .lh__markethead { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px 18px; }
