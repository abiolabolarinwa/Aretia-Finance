  .wapp-tx__txn { text-align: center; }
  .wapp-mp__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1px; overflow: clip; flex: none; min-height: min-content; background: var(--color-border-strong); border: 1px solid var(--color-border-strong); border-radius: 12px; }
