    [data-wapp].wapp[data-view='swings'] :is(.wapp-mt__card, .wapp-mt__chart) { border-right: 0; border-radius: var(--radius-xl) 0 0 var(--radius-xl); box-shadow: none; }
    [data-wapp].wapp[data-view='swings'] > .wapp-mp:not([hidden]) { display: flex; flex-direction: column; position: sticky; top: 0; z-index: 35; align-self: start; height: 100vh; box-sizing: border-box; overflow-y: auto; gap: 10px; padding: 16px; background: var(--color-bg); border-left: 1px solid var(--color-border); }
  }
  @media (min-width: 1680px) {
    /* With the panel docked, the top bar (ACT price and wallet) ends where the list ends, opposite the search box, instead of sitting over the panel. */
    body:has([data-wapp][data-view='swings'] > .wapp-mp:not([hidden])) .nav--wallet { right: 360px; }
  }
  .wapp-mt__main { min-width: 0; display: grid; gap: 10px; }
  /* The chart opened from the docked panel: in the centre, above the list. */
  .wapp-mt__chart { display: grid; gap: 10px; padding: 14px; margin-bottom: 14px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 14px; box-shadow: var(--shadow-soft); }
  .wapp-mt__chart-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .wapp-mt__chart-title { font-size: 13px; color: var(--color-strong); }
  .wapp-mt__chart-close { padding: 8px 16px; font-size: 12px; color: #fff; background: #c62828; border-color: #c62828; }
  .wapp-mt__chart-close:hover { background: #a31f1f; border-color: #a31f1f; }
  /* Each DexScreener embed ends with a footer strip. These frames clip it off (the swap chart does the same in .wapp__chart); the height grows by the same amount so the chart itself keeps its size. Tune the crop here. */
  .wapp-mt__chart, .wapp-tp__chart { --dex-footer-crop: 46px; }
  .wapp-mt__chart-frame { display: block; width: 100%; height: calc(max(520px, 62vh) + var(--dex-footer-crop)); margin-bottom: calc(var(--dex-footer-crop) * -1); clip-path: inset(0 0 var(--dex-footer-crop) 0 round 10px); border: 0; border-radius: 10px; background: #fff; }
  /* The numbers as one grid table: hairlines between cells, header rows, 12 columns so rows of 3, 4 and 2 line up. */
  /* The Transactions table under a chart: recent trades, newest first, in a box that scrolls. */
  .wapp-tx { display: grid; gap: 10px; min-width: 0; margin-top: 4px; }
  .wapp-tx__head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
