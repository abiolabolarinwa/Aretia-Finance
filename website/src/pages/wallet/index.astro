  /* The Launch pane sits in the middle of the page, not against the sidebar. */
  .wapp .wapp__pane[data-pane='launch'] { justify-self: center; margin-inline: auto; }

  /* Motion: a progress bar that fills, stages that slide in from the side they are reached from, results that rise in, and a working step that pulses. */
  .lh__bar { width: 100%; max-width: 780px; height: 4px; margin: -8px auto 0; overflow: hidden; background: var(--color-border); border-radius: 999px; }
  .lh__bar > span { display: block; width: 0; height: 100%; background: linear-gradient(90deg, var(--color-brand), #7a5cff); border-radius: inherit; transition: width 600ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .lh .lh__step.lh-enter { animation: lh-in-fwd 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .lh[data-dir='back'] .lh__step.lh-enter { animation-name: lh-in-back; }
  @keyframes lh-in-fwd { from { opacity: 0; transform: translateX(28px) scale(0.985); } to { opacity: 1; transform: none; } }
  @keyframes lh-in-back { from { opacity: 0; transform: translateX(-28px) scale(0.985); } to { opacity: 1; transform: none; } }
  @keyframes lh-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .lh [data-stage='review'] .wapp-ln > *, .lh [data-stage='done'] .wapp-ln > * { animation: lh-rise 380ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .lh [data-stage='review'] .wapp-ln > :nth-child(2), .lh [data-stage='done'] .wapp-ln > :nth-child(2) { animation-delay: 50ms; }
  .lh [data-stage='review'] .wapp-ln > :nth-child(3), .lh [data-stage='done'] .wapp-ln > :nth-child(3) { animation-delay: 100ms; }
  .lh [data-stage='review'] .wapp-ln > :nth-child(4), .lh [data-stage='done'] .wapp-ln > :nth-child(4) { animation-delay: 150ms; }
