  /* Staged: only the open stage shows. The page title above is the page's own, so it goes. */
  .wapp[data-view='launch'] [data-title] { display: none; }
  .lh { margin-inline: auto; }
  .lh__head { flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 18px; }
  .lh__lead { margin-inline: auto; }
  .lh__net { justify-items: center; }
  .lh-chips { justify-content: center; }
  .lh__rail { width: 100%; max-width: 780px; margin-inline: auto; }
  .lh__grid { width: 100%; max-width: 1020px; margin-inline: auto; }
  .lh[data-view='token'] [data-step='market'], .lh[data-view='token'] [data-step='live'],
  .lh[data-view='market'] [data-step='token'], .lh[data-view='market'] [data-step='live'],
