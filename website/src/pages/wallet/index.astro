  .lh .wapp__rows > div.is-total dt, .lh .wapp__rows > div.is-total dd { font-size: 13px; font-weight: 700; color: var(--color-strong); }
  .lh-adv { border: 1px solid var(--color-border); border-radius: 14px; background: var(--color-bg-alt); }
  .lh-adv > summary { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 0 14px; font-size: 12.5px; font-weight: 600; color: var(--color-strong); cursor: pointer; list-style: none; }
