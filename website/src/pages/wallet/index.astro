---
import Base from '../../layouts/Base.astro';
import { ACT, PRODUCTS } from '../../data/site';

// Universal and SafeSend are not usable on this page (mainnet + Solana only), so their tabs report
// status. Copy comes from PRODUCTS, the single source the features page uses; the network rows
// restate the deployment records (packages/safesend/src/deployments.ts and the bridge config).
type Tone = 'on' | 'warn' | 'off';
interface StatusRow { network: string; state: string; tone: Tone }
const product = (slug: string) => PRODUCTS.find((p) => p.slug === slug)!;
const safesend = product('safesend');
const universal = product('universal');
const safesendRows: StatusRow[] = [
  { network: 'Solana mainnet (this page)', state: 'Not deployed', tone: 'off' },
  { network: 'Solana devnet', state: 'Testnet', tone: 'on' },
  { network: 'Ethereum Sepolia', state: 'Testnet', tone: 'on' },
  { network: 'BNB Chain and Polygon mainnet', state: 'Deployed, not audited', tone: 'warn' },
  { network: 'Ethereum mainnet', state: 'Not deployed', tone: 'off' },
];
const universalRows: StatusRow[] = [
  { network: 'Solana mainnet ↔ Ethereum mainnet', state: 'Not live', tone: 'off' },
  { network: 'Solana devnet ↔ Ethereum Sepolia', state: 'Testnet', tone: 'on' },
  { network: 'ACT on BNB Chain and Polygon mainnet', state: 'Deployed, bridging not live', tone: 'warn' },
];
// Restates what src/pages/carboncredit.astro says is built and not built; keep the two in step.
const carbonRows: StatusRow[] = [
  { network: 'Issue, approve, reconcile, retire workflow', state: 'Built, simulated', tone: 'on' },
  { network: 'Connection to a real registry', state: 'None', tone: 'off' },
  { network: 'Token contract on a network', state: 'Not deployed, not audited', tone: 'off' },
  { network: 'Live carbon credits', state: 'None', tone: 'off' },
];
const carbonSteps = [
  'The registry authorises which credits may go on a chain, how many, and where.',
  'The organisation asks for those exact serial numbers to be tokenised, with a signed, one-time request.',
  'A second person approves. The person who asked cannot.',
  'The registry is asked again just before anything is created. If the credit has changed, it stops.',
  'The token is created, then the registry, the ledger and the chain are compared and any difference is flagged.',
  'A retirement counts only when the registry itself confirms it. Burning a token is not a retirement.',
];
const carbonNeeds = [
  'A carbon registry willing to work with us, with its own documentation, credentials and written approval.',
  'An independent security audit of the token contract and the key management.',
  'Legal and data-protection review, and approval of the issuance and retirement workflows.',
];
const safesendNeeds = [
  'SafeSend deployed on Solana mainnet. Today the Solana program exists on devnet only.',
  'A security audit of the vault and the program before it holds anyone’s real funds.',
];
const universalNeeds = [
  'ACT bridging live on mainnet. Today it runs on testnet with zero-value test tokens.',
  'An Ethereum wallet connection. This page connects Solana wallets only, and a bridge needs both sides.',
];

// Buying USDT/USDC with local currency (through providers) lives inside Aretia Pay. It stays out of the
// page until the site is built with PUBLIC_PAY_BUY=1. See docs/ramp.md.
const payBuyOn = import.meta.env.PUBLIC_PAY_BUY === '1';
const sendTips = [
  'Transfers on Solana cannot be reversed. Check the full address on the review screen.',
  'Aretia never holds your keys. Your wallet shows the transaction and signs it; this page then submits it.',
  'Before it asks your wallet, the page simulates the transaction on a public RPC. A failed simulation blocks the send.',
  'The addresses and amounts involved, and any .sns name you type, are sent to a public Solana RPC.',
  'Sending a token to an address that has no account for it opens one, paid in SOL by you (about 0.002 SOL).',
  `ACT carries a ${ACT.transferFee.totalPercent}% transfer fee on every move, so the recipient gets slightly less than you send.`,
];
const buyTips = [
  'You pick a provider and the checkout opens on this page. The provider verifies who you are and takes your payment, by card or bank transfer depending on your country.',
  'The provider buys the USDT or USDC and sends it straight to your own wallet address on Solana. Aretia never holds your money and never sees your documents.',
  'Buying does not put money in your bank account. It takes money from your card or bank and gives you crypto. Paying out to a bank account is selling, which is not available yet.',
  'Each provider sets its own fees, limits, payment methods and the countries it serves. It is a third-party service with its own terms.',
  'Your wallet address is sent to the provider you pick so it knows where to deliver. Nothing else about your wallet is shared.',
  'Only USDT and USDC on Solana are offered. Anything else is refused by the server, not just hidden.',
];
---

<Base
  title="Wallet"
  description="Aretia web wallet: connect the Solana wallet you already use to see your balances and activity and trade ACT. Aretia never holds your keys."
  walletConnect
  ctaBands={false}
  footer={false}
>
  <link slot="head" rel="stylesheet" href="/assets/wallet/wallet.css" />
  <script slot="head" is:inline>document.documentElement.dataset.wappSidebar = 'collapsed';</script>

  <div class="wapp" data-wapp data-connected="false" data-view="dashboard">
    <aside class="wapp__side" aria-label="Wallet">
      <div class="wapp__side-head">
        <a class="wapp__brand" href="/home" aria-label="Aretia Finance home">
          <img src="/assets/logo-mark.png" width="28" height="28" alt="" />
          <span>Aretia</span>
        </a>
      </div>
      <div class="wapp__account" data-account aria-live="polite"></div>
      <nav class="wapp__nav" id="wapp-nav" aria-label="Wallet sections">
        <button type="button" data-nav="dashboard" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="7.5" height="9" rx="2" /><rect x="13.5" y="3" width="7.5" height="5" rx="2" /><rect x="13.5" y="11" width="7.5" height="10" rx="2" /><rect x="3" y="15" width="7.5" height="6" rx="2" /></svg>
          <span class="wapp__label">Dashboard</span>
        </button>
        <button type="button" data-nav="swings">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7" /></svg>
          <span class="wapp__label">Markets</span>
        </button>
        <button type="button" data-nav="favourites">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8 6.8 19.6l1-5.8-4.3-4.1 5.9-.9z" /></svg>
          <span class="wapp__label">Favourites</span>
        </button>
        <button type="button" data-nav="send">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          <span class="wapp__label">Pay</span>
        </button>
        <button type="button" data-nav="carbon">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-14 14zM5 19c3-4 6-7 10-10" /></svg>
          <span class="wapp__label">Carbon Credit</span>
        </button>
        <button type="button" data-nav="shield">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg>
          <span class="wapp__label">Shield</span>
        </button>
        <button type="button" data-nav="intent">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg>
          <span class="wapp__label">Intent</span>
        </button>
        <button type="button" data-nav="safesend">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg>
          <span class="wapp__label">SafeSend</span>
        </button>
        <button type="button" data-nav="universal">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 18v-2a9 9 0 0 1 18 0v2M3 18h18M8 18v-5M16 18v-5M12 18v-7" /></svg>
          <span class="wapp__label">Universal</span>
        </button>
        <button type="button" data-nav="activity">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
          <span class="wapp__label">Activity</span>
        </button>
      </nav>
      <div class="wapp__side-foot">
        <button type="button" class="wapp__lock wapp__bell" data-bell title="Notifications">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 17V11a6 6 0 0 1 12 0v6l1.5 2h-15zM10 21h4" /></svg>
          <span class="wapp__label">Notifications</span>
          <span class="wapp__bell-count" data-bell-count hidden>0</span>
        </button>
        <button type="button" class="wapp__lock" data-lock title="Optional: protect this wallet on this computer with a password, PIN or your computer's own unlock">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          <span class="wapp__label">Lock wallet</span>
        </button>
        <a href="/wallet/about">About Aretia Wallet</a>
        <a href="/buy">Buy ACT</a>
        <a href="/verify">Verify ACT on-chain</a>
      </div>
    </aside>

    <nav class="wapp__rail" data-rail aria-label="Networks"></nav>

    <section class="wapp__main">
      <header class="wapp__top">
        <h1 data-title>Dashboard</h1>
        <div class="wapp__chips">
          <button type="button" class="wapp__chip wapp__chip--btn" data-refresh>Refresh</button>
        </div>
      </header>

      <div class="wapp__gate" data-gate>
        <h2>Connect your wallet</h2>
        <p>
          Connect Phantom, Solflare, Backpack, the Aretia extension or another Solana wallet. Aretia never holds your keys or your recovery phrase: this page only reads public data for the wallet you connect, and your own wallet asks you to approve anything that moves money.
        </p>
        <button type="button" class="wapp__btn wapp__btn--primary" data-connect>Connect wallet</button>
        <p class="wapp__fine">
          No wallet yet? Aretia's own wallet is still in development. <a href="/wallet/about">Read about it and join the waitlist</a>.
        </p>
      </div>

      <div data-pane="dashboard" class="wapp__pane">
        <section class="wapp__hero" aria-label="Overview">
          <div class="wapp__hero-copy">
            <span class="wapp__hero-eyebrow">Aretia Wallet</span>
            <h2 class="wapp__hero-title">One place to hold, send, swap and protect.</h2>
            <p class="wapp__hero-sub">Send · Receive · Swap · Protect</p>
            <div class="wapp__hero-cta">
              <button type="button" class="wapp__pill wapp__pill--solid" data-nav="send">Send</button>
              <button type="button" class="wapp__pill wapp__pill--outline" data-receive>Receive</button>
              <button type="button" class="wapp__pill wapp__pill--outline" data-nav="swap">Swap</button>
            </div>
          </div>

          <div class="wapp__hero-panel">
            <div class="wapp__hero-row">
              <div class="wapp__card wapp__card--wash">
                <div class="wapp__row">
                  <span class="wapp__eyebrow">Portfolio</span>
                  <button type="button" class="wapp__icon" data-hide aria-label="Hide amounts" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                  </button>
                </div>
                <div class="wapp__total" data-total>—</div>
                <div class="wapp__sub" data-total-sub></div>
              </div>
              <div class="wapp__card wapp__hero-stats">
                <div>
                  <span class="wapp__eyebrow">Tokens</span>
                  <div class="wapp__hero-stat" data-token-count>—</div>
                </div>
                <div>
                  <span class="wapp__eyebrow">Wallet</span>
                  <div class="wapp__hero-stat wapp__hero-stat--text" data-wallet-name>—</div>
                </div>
                <a class="wapp__hero-link" data-solscan target="_blank" rel="noopener noreferrer" href="https://solscan.io">View on Solscan</a>
              </div>
            </div>

            <div class="wapp__card wapp__hero-list">
              <div class="wapp__hero-tabs" role="tablist">
                <button type="button" role="tab" class="wapp__hero-tab" data-tab="assets" aria-selected="true">Your assets</button>
                <button type="button" role="tab" class="wapp__hero-tab" data-tab="address" aria-selected="false">Address</button>
                <button type="button" class="wapp__hero-viewall" data-scroll="all-assets">View all</button>
              </div>
              <div data-tabpanel="assets">
                <ul class="wapp__hero-assets" data-top-assets></ul>
              </div>
              <div data-tabpanel="address" class="wapp__receive" hidden>
                <span class="wapp__eyebrow">Your Solana address</span>
                <code class="wapp-mono" data-address></code>
                <button type="button" class="wapp__btn wapp__btn--ghost" data-copy>Copy address</button>
                <p class="wapp__fine">Send only Solana assets to this address.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="wapp__tools" aria-label="Aretia tools">
          <button type="button" class="wapp__tools-arrow" aria-label="Previous tools" data-tools-prev>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <div class="wapp__tools-track" data-tools-track>
          <button type="button" class="wapp__toolcard" data-nav="send"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M7 17L17 7M9 7h8v8" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Pay</span><strong>Send to a name</strong><span>Pay a .sns name instead of a long address.</span></span></button>
          <button type="button" class="wapp__toolcard" data-nav="shield"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Shield</span><strong>Check before you send</strong><span>Look up an address for no history or a smart contract.</span></span></button>
          <button type="button" class="wapp__toolcard" data-nav="intent"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Intent</span><strong>Type it, then review</strong><span>Write "swap 0.1 SOL for ACT" and confirm on the normal screen.</span></span></button>
          <button type="button" class="wapp__toolcard" data-nav="universal"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M3 18v-2a9 9 0 0 1 18 0v2M3 18h18M8 18v-5M16 18v-5M12 18v-7" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Universal<span class="wapp__toolcard-badge">Testnet</span></span><strong>Move ACT across chains</strong><span>Bridge ACT between Solana and Ethereum. Testnet only today; see its status here.</span></span></button>
          <button type="button" class="wapp__toolcard" data-nav="safesend"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia SafeSend<span class="wapp__toolcard-badge">Not on mainnet yet</span></span><strong>Send with a safety delay</strong><span>Hold a transfer in escrow so you can cancel it first. See where it runs.</span></span></button>
          </div>
          <button type="button" class="wapp__tools-arrow" aria-label="Next tools" data-tools-next>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </section>

        <div class="wapp__section-head" id="all-assets">
          <h2>Everything in this wallet.</h2>
          <p>Every token this wallet holds, with prices where one exists.</p>
        </div>
        <div class="wapp__card">
          <h2 class="wapp__h2">Holdings</h2>
          <div data-holdings></div>
        </div>
      </div>

      <div data-pane="send" class="wapp__pane" hidden>
        <div class="wapp__stack wapp-pay">
          <div class="wapp-pay__hub" role="tablist" aria-label="Pay">
            <button type="button" class="wapp-pay__card" role="tab" data-pay-tab="send" aria-selected="true">
              <span class="wapp-pay__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M7 17L17 7M9 7h8v8" /></svg></span>
              <span class="wapp-pay__text"><strong>Send</strong><span>Send SOL or a token to an address or a .sns name.</span></span>
            </button>
            <button type="button" class="wapp-pay__card" role="tab" data-pay-tab="ramp" aria-selected="false">
              <span class="wapp-pay__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path d="M6.5 9.5v.01M17.5 14.5v.01" /></svg></span>
              <span class="wapp-pay__text"><strong>Cash out or top up</strong><span>Turn USDC into cash, or buy USDC with a card or bank transfer.</span></span>
            </button>
            <button type="button" class="wapp-pay__card" role="tab" data-pay-tab="transfer" aria-selected="false">
              <span class="wapp-pay__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 8h13l-3-3M20 16H7l3 3" /></svg></span>
              <span class="wapp-pay__text"><strong>Move USDC</strong><span>Send USDC from one network to another.</span></span>
            </button>
          </div>
          <p class="wapp__intro" data-pay-intro aria-live="polite"></p>
          <div data-pay-panel="send">
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__stack">
            <div class="wapp__card">
              <h2 class="wapp__h2">Send or pay</h2>
              <p class="wapp__fine">
                Send SOL or a token you hold to a Solana address, or pay a <b>.sns</b> name. You review the full transaction here, then approve it in your own wallet.
              </p>
              <form class="wapp__form" data-send-form>
                <label for="send-asset" class="wapp__eyebrow">Asset</label>
                <select id="send-asset" class="wapp__input" data-send-asset disabled><option>Loading your tokens…</option></select>
                <label for="send-to" class="wapp__eyebrow">Recipient address or .sns name</label>
                <input id="send-to" class="wapp__input wapp-mono" data-send-to autocomplete="off" spellcheck="false" placeholder="Address or name.sns" />
                <label for="send-amount" class="wapp__eyebrow">Amount</label>
                <div class="wapp__amount">
                  <input id="send-amount" class="wapp__input" data-send-amount inputmode="decimal" autocomplete="off" placeholder="0.0" />
                  <button type="button" class="wapp__btn wapp__btn--ghost" data-send-max>Max</button>
                </div>
                <button type="submit" class="wapp__btn wapp__btn--primary">Review</button>
              </form>
              <div data-send-review aria-live="polite"></div>
            </div>
            {payBuyOn && (
              <details class="wapp__card wapp__guide">
                <summary><h2 class="wapp__h2">Before you send</h2><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
                <ul class="wapp__list">{sendTips.map((tip) => <li>{tip}</li>)}</ul>
              </details>
            )}
          </div>
          {payBuyOn ? (
            <div class="wapp__card wapp__buy" data-market>
              <div class="wapp__buy-head">
                <div>
                  <span class="wapp__eyebrow">Aretia Pay</span>
                  <h2 class="wapp__h2">Buy USDT or USDC</h2>
                </div>
                <div class="wapp__seg" role="group" aria-label="Buy or sell">
                  <button type="button" class="wapp__chip wapp__chip--btn" data-side="buy" aria-pressed="true">Buy</button>
                  <button type="button" class="wapp__chip wapp__chip--btn" data-side="sell" aria-pressed="false">Sell</button>
                </div>
              </div>
              <p class="wapp__fine">Pay with your card or bank in your local currency. The stablecoin is sent straight to your own wallet on Solana.</p>
              <div class="wapp__assets" role="group" aria-label="Asset">
                <button type="button" class="wapp__asset" data-market-asset="USDC" aria-pressed="true">
                  <span class="wapp__coin wapp__coin--usdc" aria-hidden="true">$</span>
                  <span><strong>USDC</strong><small>USD Coin on Solana</small></span>
                </button>
                <button type="button" class="wapp__asset" data-market-asset="USDT" aria-pressed="false">
                  <span class="wapp__coin wapp__coin--usdt" aria-hidden="true">₮</span>
                  <span><strong>USDT</strong><small>Tether on Solana</small></span>
                </button>
              </div>
              <form class="wapp__form" data-market-form>
                <label for="market-country" class="wapp__eyebrow">Country</label>
                <select id="market-country" class="wapp__input" data-market-country disabled><option>Loading…</option></select>
                <div class="wapp__paybox">
                  <label for="market-amount" class="wapp__eyebrow">You pay (optional)</label>
                  <div class="wapp__paybox-row">
                    <input id="market-amount" class="wapp__paybox-input" data-market-amount inputmode="numeric" autocomplete="off" placeholder="50000" />
                    <select id="market-fiat" class="wapp__input wapp__paybox-fiat" data-market-fiat aria-label="Currency" disabled><option>…</option></select>
                  </div>
                </div>
              </form>
              <div data-market-providers></div>
              <div class="wapp__notes" data-market-notes></div>
              <div class="wapp__embed" data-market-embed hidden></div>
              <ul class="wapp__trust">
                <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /><path d="M9 12l2 2 4-4" /></svg>Non-custodial: Aretia never holds your money</li>
                <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12h13" /><path d="M13 6l6 6-6 6" /></svg>Sent to your wallet when the provider finishes</li>
                <li><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1-4 4-6 8-6s7 2 8 6" /></svg>ID checks and payment are handled by the provider</li>
              </ul>
              <details class="wapp__more">
                <summary>How buying works<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
                <ul class="wapp__list">{buyTips.map((tip) => <li>{tip}</li>)}</ul>
              </details>
            </div>
          ) : (
            <div class="wapp__card">
              <span class="wapp__eyebrow">Before you send</span>
              <ul class="wapp__list">{sendTips.map((tip) => <li>{tip}</li>)}</ul>
            </div>
          )}
        </div>
          </div>
