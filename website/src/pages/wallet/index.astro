  .lh-chip:hover:not(:disabled):not(.is-on) .lh-chip__logo { filter: none; opacity: 1; }
  .lh-chip.is-on { color: #fff; background: var(--color-brand); border-color: var(--color-brand); padding-right: 12px; box-shadow: 0 8px 20px -8px rgba(74, 46, 224, 0.7), 0 0 0 3px rgba(74, 46, 224, 0.2); }
  .lh-chip__check { display: grid; place-items: center; width: 18px; height: 18px; margin-left: 2px; font-size: 11px; font-weight: 800; color: var(--color-brand); background: #fff; border-radius: 50%; }

  .lh-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding-top: 4px; }
