  .wapp__tag--ok { color: var(--color-ok); background: rgba(27, 138, 75, 0.1); }
  .wapp__tag--warn { color: var(--color-warn); background: rgba(178, 94, 9, 0.1); }
  .wapp__trade-side { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-content: start; min-width: 0; }

  .wapp__intro { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-muted); max-width: 70ch; }
  .wapp__intro:empty { display: none; }
  .wapp__fineprint { padding: 4px 2px; font-size: 13px; color: var(--color-muted); }
  .wapp__fineprint > summary { cursor: pointer; font-weight: 600; color: var(--color-strong); }
  .wapp__fineprint ul { display: grid; gap: 6px; margin: 10px 0 0; padding-left: 18px; line-height: 1.5; }
  .wapp__steps { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; padding: 0; list-style: none; counter-reset: wstep; font-size: 12px; color: var(--color-muted); }
  .wapp__steps li { counter-increment: wstep; display: inline-flex; align-items: center; gap: 6px; }
  .wapp__steps li::before { content: counter(wstep); display: inline-grid; place-items: center; width: 18px; height: 18px; font-size: 11px; font-weight: 700; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 50%; }
