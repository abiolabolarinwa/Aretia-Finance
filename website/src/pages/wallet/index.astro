  /* ---- Price-alert pop-up (two seconds, then gone) and the Favourites page's alert list ---- */
  .wapp-toasts { position: fixed; right: 20px; bottom: 20px; z-index: 300; display: grid; justify-items: end; pointer-events: none; }
