  .wapp__pill:focus-visible, .wapp__tools-arrow:focus-visible, .wapp__toolcard:focus-visible, .wapp__hero-tab:focus-visible, .wapp__hero-viewall:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp__hero-panel { display: grid; gap: 14px; padding: 14px; background: rgba(255, 255, 255, 0.55); border: 1px solid var(--color-border); border-radius: 28px; }
