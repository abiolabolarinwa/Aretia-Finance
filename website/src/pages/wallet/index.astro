  .wapp__coin { flex: none; display: grid; place-items: center; width: 36px; height: 36px; font-size: 18px; font-weight: 700; color: #fff; border-radius: 50%; }
  .wapp__coin--usdc { background: #2775ca; }
  .wapp__coin--usdt { background: #26a17b; }
  .wapp__paybox { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 14px 16px; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 16px; }
  .wapp__paybox:focus-within { border-color: var(--color-brand); box-shadow: 0 0 0 3px var(--color-brand-soft); }
  .wapp__paybox-row { display: flex; align-items: center; gap: 10px; }
  .wapp__paybox-input { flex: 1; min-width: 0; padding: 0; font: inherit; font-size: 28px; font-weight: 600; color: var(--color-strong); background: transparent; border: 0; outline: 0; }
  .wapp__paybox-input::placeholder { color: var(--color-muted); opacity: 0.6; }
  .wapp__paybox-row .wapp__paybox-fiat { flex: none; width: auto; min-width: 88px; font-weight: 600; }
  .wapp__trust { display: grid; gap: 8px; margin: 0; padding: 14px 0 0; list-style: none; border-top: 1px solid var(--color-border); }
  .wapp__trust li { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--color-muted); }
  .wapp__trust svg, .wapp__more summary svg { flex: none; fill: none; stroke: var(--color-brand); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .wapp__more { display: grid; gap: 10px; }
  .wapp__more > summary { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 13px; font-weight: 600; color: var(--color-strong); list-style: none; cursor: pointer; }
  .wapp__more > summary::-webkit-details-marker { display: none; }
  .wapp__more > summary svg { stroke: var(--color-muted); transition: transform 160ms ease; }
  .wapp__more[open] > summary svg { transform: rotate(180deg); }
  .wapp__more > summary:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 8px; }
  .wapp__embed { display: grid; gap: 10px; }
  .wapp__embed[hidden] { display: none; }
  .wapp__embed-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .wapp__embed-frame { display: block; width: 100%; max-width: 440px; height: 680px; margin: 0 auto; border: 1px solid var(--color-border); border-radius: 18px; background: #fff; }
  .wapp__seg { display: flex; flex-wrap: wrap; gap: 8px; }
  .wapp__seg [aria-pressed='true'] { color: #fff; background: var(--color-brand); }
  .wapp__provider { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 16px; }
  .wapp__provider strong { color: var(--color-strong); }
  .wapp__provider span { display: block; font-size: 12px; color: var(--color-muted); }
    .wapp[data-view='send'] [data-refresh] { display: none; }
  .wapp__amount { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  .wapp__rows { display: grid; gap: 0; margin: 0; }
  .wapp__rows > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; font-size: 13px; border-top: 1px solid var(--color-border); }
  .wapp__rows > div:first-child { border-top: 0; }
  .wapp__rows dt { color: var(--color-muted); flex: none; }
  .wapp__rows dd { margin: 0; text-align: right; color: var(--color-strong); overflow-wrap: anywhere; }
  .wapp__rows code { font-size: 12px; }
  .wapp__check { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; line-height: 1.5; }
  .wapp__row-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .wapp[data-connected='false'][data-view='safesend'] .wapp__gate,
  .wapp[data-connected='false'][data-view='universal'] .wapp__gate,
  .wapp[data-connected='false'][data-view='carbon'] .wapp__gate { display: none; }
  .wapp[data-view='safesend'] [data-refresh], .wapp[data-view='universal'] [data-refresh], .wapp[data-view='carbon'] [data-refresh] { display: none; }
  .wapp__state { display: inline-block; padding: 3px 10px; font-size: 12px; font-weight: 600; border-radius: var(--radius-pill); }
  .wapp__state--on { color: #1c3fa8; background: rgba(28, 63, 168, 0.08); }
  .wapp__state--warn { color: #6b4300; background: rgba(178, 94, 9, 0.12); }
  .wapp__state--off { color: var(--color-muted); background: var(--color-bg-alt); }
  .wapp__state--bad { color: #8a1c14; background: rgba(179, 38, 30, 0.12); }
  /* Aretia's rating as a colour. The words stay on the chip, so the colour is never the only signal. */
  .wapp__state--green { color: #0b5f33; background: rgba(27, 138, 75, 0.16); }
  .wapp__state--yellow { color: #5f4a00; background: rgba(240, 190, 0, 0.26); }
  .wapp__state--orange { color: #7a3300; background: rgba(238, 112, 14, 0.2); }
  .wapp__state--red { color: #8a1c14; background: rgba(198, 42, 31, 0.16); }
  .wapp__state--grey { color: var(--color-muted); background: var(--color-bg-alt); }
  .wapp-key { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin-left: auto; font-size: 12.5px; color: var(--color-muted); cursor: help; }
  .wapp-key__lead { font-weight: 600; color: var(--color-strong); }
  .wapp-key__item { display: inline-flex; align-items: center; gap: 5px; }
  .wapp-key__dot { flex: none; width: 10px; height: 10px; border-radius: 50%; margin-top: 3px; }
  .wapp-key__dot--green { background: #1b8a4b; }
  .wapp-key__dot--yellow { background: #f0be00; }
  .wapp-key__dot--orange { background: #ee700e; }
  .wapp-key__dot--red { background: #c62a1f; }
  .wapp-key__dot--grey { background: #9a97b8; }
  .wapp-guide { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 13px; line-height: 1.45; color: var(--color-strong); }
  .wapp-guide li { display: flex; gap: 8px; align-items: flex-start; }
  .wapp-guide .wapp-key__dot { margin-top: 5px; }
  /* A first reading from market data alone: outlined and lighter until the on-chain check firms it up. */
  .wapp__state--soft { background: transparent; box-shadow: inset 0 0 0 1px currentColor; font-weight: 500; }
  .wapp__state.is-checking::after { content: ''; display: inline-block; width: 6px; height: 6px; margin-left: 6px; border-radius: 50%; background: currentColor; animation: wapp-check 1s ease-in-out infinite; }
  @keyframes wapp-check { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }

  /* ---- Markets: the selected token's panel is a bar docked to the right edge, as the left sidebar is docked to the left ---- */
  .wapp-mp { display: none; }
  /* One light indigo through the whole panel in place of grey: headers, lines, chips and the sponsor card. */
  .wapp { --wapp-indigo: #e9e6fc; --wapp-indigo-line: #cdc6f3; }
  .wapp-mp { --color-bg-alt: var(--wapp-indigo); --color-border: var(--wapp-indigo-line); --color-border-strong: #b9b0ec; --color-muted: #55508a; --color-brand-soft: var(--wapp-indigo); }
  /* The panel scrolls with the mouse wheel while the pointer is over it, without showing a scrollbar, and does not hand the scroll on to the page at its ends. */
  .wapp-mp { scrollbar-width: none; -ms-overflow-style: none; overscroll-behavior: contain; }
  .wapp-mp::-webkit-scrollbar { display: none; }
  .wapp-mt__row.is-selected td { background: var(--color-brand-soft); }
  @media (min-width: 1680px) {
    [data-wapp].wapp[data-view='swings'] { grid-template-columns: var(--wapp-side) 76px minmax(0, 1fr) 360px; }
    /* The list (and the chart above it) run right up to the docked panel, with no empty strip between them. */
    [data-wapp].wapp[data-view='swings'] .wapp__main { padding-right: 0; }
    [data-wapp].wapp[data-view='swings'] :is(.wapp-mt__card, .wapp-mt__chart) { border-right: 0; border-radius: var(--radius-xl) 0 0 var(--radius-xl); box-shadow: none; }
    [data-wapp].wapp[data-view='swings'] > .wapp-mp:not([hidden]) { display: flex; flex-direction: column; position: sticky; top: 0; z-index: 35; align-self: start; height: 100vh; box-sizing: border-box; overflow-y: auto; gap: 10px; padding: calc(var(--nav-height) + 12px) 16px 16px; background: var(--color-bg); border-left: 1px solid var(--color-border); }
  }
  .wapp-mt__main { min-width: 0; display: grid; gap: 10px; }
  /* The chart opened from the docked panel: in the centre, above the list. */
  .wapp-mt__chart { display: grid; gap: 10px; padding: 14px; margin-bottom: 14px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 14px; box-shadow: var(--shadow-soft); }
  .wapp-mt__chart-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .wapp-mt__chart-title { font-size: 16px; color: var(--color-strong); }
  .wapp-mt__chart-close { padding: 8px 16px; font-size: 13px; }
  .wapp-mt__chart-frame { display: block; width: 100%; height: max(520px, 62vh); border: 0; border-radius: 10px; background: #fff; }
  /* The numbers as one grid table: hairlines between cells, header rows, 12 columns so rows of 3, 4 and 2 line up. */
  .wapp-mp__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1px; overflow: clip; flex: none; min-height: min-content; background: var(--color-border-strong); border: 1px solid var(--color-border-strong); border-radius: 12px; }
  .wapp-mp__gh { grid-column: 1 / -1; padding: 6px 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); background: var(--color-bg-alt); }
  .wapp-mp__cell { display: grid; gap: 1px; align-content: center; justify-items: center; min-width: 0; padding: 8px 6px; text-align: center; background: var(--color-bg); }
  .wapp-mp__span-3 { grid-column: span 3; } .wapp-mp__span-4 { grid-column: span 4; } .wapp-mp__span-6 { grid-column: span 6; } .wapp-mp__span-12 { grid-column: 1 / -1; }
  .wapp-mp__cell.is-up .wapp-mp__v { color: #1b8a4b; }
  .wapp-mp__cell.is-down .wapp-mp__v { color: #b3261e; }
  .wapp-mp__wait { font-size: 13px; color: var(--color-muted); }
  .wapp-mp__tab { font: inherit; border: 0; cursor: pointer; }
  .wapp-mp__tab[aria-pressed='true'] { background: var(--color-bg-alt); box-shadow: inset 0 -2px 0 var(--color-brand); }
  .wapp-mp__tab.is-up .wapp-mp__v { color: #1b8a4b; }
  .wapp-mp__tab.is-down .wapp-mp__v { color: #b3261e; }
  .wapp-mp__meterrow { padding: 6px 10px; }
  .wapp-mp__meter { width: 100%; height: 6px; overflow: hidden; background: #d9534f; border-radius: 3px; }
  .wapp-mp__meter-buy { display: block; height: 100%; background: #1b8a4b; }
  .wapp-mp > * { flex: none; }
  .wapp-mp__group { display: grid; gap: 6px; }
  .wapp-mp__lock { display: inline-flex; vertical-align: -2px; margin-right: 5px; color: #16a34a; cursor: help; }
  /* A burn is permanent (green). A time lock ends, so it is amber. */
  .wapp-mp__lock.is-timed, .wapp-mt__lock.is-timed { color: #b45309; }
  .wapp-mp__icon { display: inline-grid; place-items: center; width: 28px; height: 28px; padding: 0; color: var(--color-brand); background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 8px; cursor: pointer; }
  .wapp-mp__icon:hover { background: var(--wapp-indigo-line); }
  .wapp-mp__icon:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-mp__head { display: flex; align-items: center; gap: 10px; }
  .wapp-mp__logo { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .wapp-mp__names { display: grid; min-width: 0; flex: 1; }
  .wapp-mp__pair { font-size: 17px; color: var(--color-strong); }
  .wapp-mp__sub { font-size: 13px; color: var(--color-muted); }
  .wapp-mp__price { font-size: 18px; font-variant-numeric: tabular-nums; color: var(--color-strong); }
  .wapp-mp__k, .wapp-mp__tabk { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-muted); }
  .wapp-mp__v { font-size: 16px; font-variant-numeric: tabular-nums; color: var(--color-strong); overflow-wrap: anywhere; }
  .wapp-mp__duo { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .wapp-mp__h { margin: 0; font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); }
  .wapp-mp__note { margin: 0; font-size: 13px; line-height: 1.5; color: var(--color-muted); }
  .wapp-mp__check { display: grid; gap: 6px; padding: 10px 12px; background: var(--color-brand-soft); border-radius: 10px; }
  .wapp-mp__checkhead { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .wapp-mp__headline { margin: 0; font-size: 15px; line-height: 1.5; font-weight: 600; color: var(--color-strong); }
  .wapp-mp__headline--bad { color: #8a1c14; }
  .wapp-mp__headline--warn { color: #6b4300; }
  .wapp-mp__concerns { margin: 0; padding-left: 18px; display: grid; gap: 3px; font-size: 14px; line-height: 1.5; color: var(--color-strong); }
  .wapp-mp__actions { display: grid; gap: 6px; }
  .wapp-mp__actions .wapp__btn { padding-block: 10px; }
  .wapp-mp__more { font-size: 13.5px; color: var(--color-muted); }
  .wapp-mp__more summary { cursor: pointer; font-weight: 600; color: var(--color-brand); }
  .wapp-mp__more > * + * { margin-top: 4px; }
  .wapp-mp__tiny { margin: 0; font-size: 12px; line-height: 1.4; color: var(--color-muted); }
  .wapp-ad--compact { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'top cta' 'text text'; align-items: center; gap: 2px 8px; padding: 8px 12px; }
  .wapp-ad--compact .wapp-ad__top { grid-area: top; }
  .wapp-ad--compact .wapp-ad__cta { grid-area: cta; justify-self: end; }
  .wapp-ad--compact .wapp-ad__text { grid-area: text; }
  .wapp-ad--compact .wapp-ad__text strong { font-size: 12.5px; }
  
  .wapp-mp__info { display: grid; }
  .wapp-mp__line { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 5px 0; font-size: 14px; font-size: 13px; border-top: 1px solid var(--color-border); }
  .wapp-mp__lk { color: var(--color-muted); }
  .wapp-mp__lv { display: inline-flex; align-items: center; gap: 8px; color: var(--color-strong); font-variant-numeric: tabular-nums; }
  .wapp-mp__addr { padding: 3px 8px; font-size: 13px; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 6px; }
  .wapp-mp__links { display: flex; flex-wrap: wrap; gap: 6px; }

  /* ---- Sponsor cards: labelled, quiet, plain text and one link ---- */
  .wapp-ad { display: grid; gap: 8px; padding: 12px 14px; background: var(--wapp-indigo); border: 1px solid var(--wapp-indigo-line); border-radius: 12px; }
  .wapp-ad--house { border-style: dashed; border-color: #b9b0ec; }
  .wapp-ad .wapp-ad__tag { color: #3f3a8a; background: #fff; border-color: var(--wapp-indigo-line); }
  .wapp-ad .wapp-ad__text p, .wapp-ad .wapp-ad__by { color: #4a4580; }
  .wapp-ad__top { display: flex; align-items: center; gap: 8px; }
  .wapp-ad__tag { padding: 1px 7px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); background: var(--color-bg-alt); border: 1px solid var(--color-border-strong); border-radius: 5px; }
  .wapp-ad__tag--plain { border-color: transparent; padding-left: 0; background: none; }
  .wapp-ad__by { font-size: 12px; color: var(--color-muted); }
  .wapp-ad__body { display: flex; gap: 10px; align-items: flex-start; }
  .wapp-ad__img { flex: none; width: 36px; height: 36px; border-radius: 8px; object-fit: cover; background: var(--color-bg-alt); }
  .wapp-ad__text { display: grid; gap: 2px; min-width: 0; }
  .wapp-ad__text strong { font-size: 13.5px; color: var(--color-strong); }
  .wapp-ad__text p { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--color-muted); }
  .wapp-ad__cta { justify-self: start; font-size: 12.5px; font-weight: 600; color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
  .wapp-mt__card > .wapp-ad { max-width: 560px; }

  /* ---- Notification bell (sidebar) and its list ---- */
  .wapp__lock { position: relative; }
  .wapp__bell-count { position: absolute; top: 4px; left: 28px; min-width: 17px; padding: 1px 5px; box-sizing: border-box; font-size: 10.5px; font-weight: 700; line-height: 15px; text-align: center; color: #fff; background: #e5484d; border-radius: 999px; box-shadow: 0 0 0 2px #2a1a9a; }
  .wapp__bell-count[hidden] { display: none; }
  .wapp__lock[data-lock-on='true']::after { content: ''; position: absolute; top: 9px; left: 26px; width: 8px; height: 8px; background: #3ddc84; border-radius: 50%; box-shadow: 0 0 0 2px #2a1a9a; }
  .wapp-bell-pop { position: fixed; left: 258px; bottom: 16px; z-index: 90; display: flex; flex-direction: column; box-sizing: border-box; width: min(380px, calc(100vw - 280px)); max-height: min(600px, calc(100vh - 32px)); overflow: hidden; background: var(--color-bg); border: 1px solid var(--wapp-indigo-line, var(--color-border)); border-radius: 16px; box-shadow: 0 24px 60px -12px rgba(10, 6, 50, 0.45); }
  .wapp-bell-pop[hidden] { display: none; }
  .wapp-bell__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px 10px; }
  .wapp-bell__title { margin: 0; font-size: 1.05rem; color: var(--color-strong); }
  .wapp-bell__actions { display: flex; gap: 12px; }
  .wapp-bell__link { padding: 0; font: inherit; font-size: 13px; font-weight: 600; color: var(--color-brand); background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .wapp-bell__link:disabled { color: var(--color-muted); cursor: default; text-decoration: none; opacity: 0.6; }
  .wapp-bell__link:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 4px; }
  .wapp-bell__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 8px 8px; }
  .wapp-bell__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .wapp-bell__item { display: flex; gap: 10px; align-items: flex-start; padding: 10px 10px; border-radius: 12px; border-left: 3px solid transparent; }
  .wapp-bell__item.is-unread { background: var(--wapp-indigo, var(--color-brand-soft)); }
  .wapp-bell__item--up { border-left-color: #1b8a4b; }
  .wapp-bell__item--down { border-left-color: #c62a1f; }
  .wapp-bell__img { flex: none; width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: var(--color-bg-alt); }
  .wapp-bell__text { display: grid; gap: 2px; min-width: 0; }
  .wapp-bell__text strong { font-size: 14px; color: var(--color-strong); }
  .wapp-bell__text span { font-size: 13px; font-variant-numeric: tabular-nums; color: var(--color-muted); }
  .wapp-bell__when { font-size: 12px; color: var(--color-muted); }
  .wapp-bell__empty { margin: 0; padding: 22px 12px 26px; font-size: 14px; line-height: 1.5; color: var(--color-muted); }
  .wapp-bell__foot { display: grid; gap: 8px; padding: 12px 16px 14px; background: var(--wapp-indigo, var(--color-bg-alt)); border-top: 1px solid var(--wapp-indigo-line, var(--color-border)); }
  .wapp-bell__sound { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--color-strong); }
  .wapp-bell__foot .wapp-bell__link { justify-self: start; }
  .wapp-bell__note { margin: 0; font-size: 12px; line-height: 1.4; color: var(--color-muted); }
  @media (max-width: 960px) { .wapp-bell-pop { left: 16px; right: 16px; width: auto; bottom: 16px; } }

  /* ---- The optional lock: its settings window and the lock screen ---- */
  .wapp-lockdlg { box-sizing: border-box; width: min(480px, calc(100vw - 32px)); max-height: calc(100vh - 32px); padding: 0; color: var(--color-strong); background: var(--color-bg); border: 0; border-radius: var(--radius-xl); box-shadow: 0 24px 80px rgba(10, 6, 50, 0.4); }
  .wapp-lockdlg::backdrop { background: rgba(15, 12, 40, 0.55); }
  .wapp-lockdlg__body { display: grid; gap: 14px; padding: 22px; }
  .wapp-lockdlg__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .wapp-lockdlg__head h2 { margin: 0; font-size: 1.2rem; }
  .wapp-lockdlg__who { margin: 2px 0 0; font-size: 13px; font-family: var(--font-mono); color: var(--color-muted); }
  .wapp-lockdlg__close { flex: none; display: grid; place-items: center; width: 34px; height: 34px; padding: 0; color: var(--color-strong); background: var(--color-bg-alt); border: 0; border-radius: 50%; cursor: pointer; }
  .wapp-lockdlg__close:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-lockdlg__line { margin: 0; font-size: 14px; line-height: 1.55; color: var(--color-muted); }
  .wapp-lockdlg__fine { margin: 0; padding-top: 12px; font-size: 12.5px; line-height: 1.5; color: var(--color-muted); border-top: 1px solid var(--color-border); }
  .wapp-lockdlg__ok { margin: 0; padding: 10px 12px; font-size: 14px; font-weight: 600; color: #0b5f33; background: rgba(27, 138, 75, 0.12); border-radius: 10px; }
  .wapp-lockdlg__err, .wapp-lockscreen__say { margin: 0; min-height: 1.2em; font-size: 13.5px; color: #b3261e; }
  .wapp-lockdlg__form, .wapp-lockdlg__fields { display: grid; gap: 12px; }
