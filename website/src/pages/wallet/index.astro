---
import Base from '../../layouts/Base.astro';
import ProductLogo from '../../components/brand/ProductLogo.astro';
import { ACT, PRODUCTS } from '../../data/site';
import { CHAINS } from '../../swings/core/types';

// SafeSend is not usable on this page (mainnet + Solana only), so its tab reports
// status. Copy comes from PRODUCTS, the single source the features page uses; the network rows
// restate the deployment records (packages/safesend/src/deployments.ts and the bridge config).
type Tone = 'on' | 'warn' | 'off';
interface StatusRow { network: string; state: string; tone: Tone }
const product = (slug: string) => PRODUCTS.find((p) => p.slug === slug)!;
const safesend = product('safesend');
const safesendRows: StatusRow[] = [
  { network: 'Solana mainnet (this page)', state: 'Not deployed', tone: 'off' },
  { network: 'Solana devnet', state: 'Testnet', tone: 'on' },
  { network: 'Ethereum Sepolia', state: 'Testnet', tone: 'on' },
  { network: 'BNB Chain and Polygon mainnet', state: 'Deployed, not audited', tone: 'warn' },
  { network: 'Ethereum mainnet', state: 'Not deployed', tone: 'off' },
];
// Restates what src/pages/carboncredit.astro says is built and not built; keep the two in step.
const carbonRows: StatusRow[] = [
  { network: 'Issue, approve, reconcile, retire workflow', state: 'Built, simulated', tone: 'on' },
  { network: 'Connection to a real registry', state: 'None', tone: 'off' },
  { network: 'Token contract on a network', state: 'Not deployed, not audited', tone: 'off' },
  { network: 'Live carbon credits', state: 'None', tone: 'off' },
];
const carbonSteps = [
  'The registry authorises which credits may go on a chain, how many, and where.',
  'The organisation asks for those exact serial numbers to be tokenised, with a signed, one-time request.',
  'A second person approves. The person who asked cannot.',
  'The registry is asked again just before anything is created. If the credit has changed, it stops.',
  'The token is created, then the registry, the ledger and the chain are compared and any difference is flagged.',
  'A retirement counts only when the registry itself confirms it. Burning a token is not a retirement.',
];
const carbonNeeds = [
  'A carbon registry willing to work with us, with its own documentation, credentials and written approval.',
  'An independent security audit of the token contract and the key management.',
  'Legal and data-protection review, and approval of the issuance and retirement workflows.',
];
const safesendNeeds = [
  'SafeSend deployed on Solana mainnet. Today the Solana program exists on devnet only.',
  'A security audit of the vault and the program before it holds anyone’s real funds.',
];

// Aretia's own bonding curve stays out of the page until the site is built with PUBLIC_CURVE_ENABLED=1, and does nothing on mainnet even then
// until it has an audited, deployed program (see docs/BONDING_CURVE.md).
const curveOn = import.meta.env.PUBLIC_CURVE_ENABLED === '1';
// Limit orders (docs/ORDER_PROGRAM.md) stay out of the page until the site is built with PUBLIC_ORDERS_ENABLED=1, and do nothing on mainnet even
// then: the card shows a notice and no form until the order program has an address.
const ordersOn = import.meta.env.PUBLIC_ORDERS_ENABLED === '1';
const ordersEvmOn = import.meta.env.PUBLIC_ORDERS_EVM_ENABLED === '1';

// Aretia's own pool program (docs/ARETIA_POOL.md) stays out of the page until the site is built with PUBLIC_ARETIA_POOL_ENABLED=1, and does
// nothing on mainnet even then: it has no mainnet program and is unaudited.
const aretiaPoolOn = import.meta.env.PUBLIC_ARETIA_POOL_ENABLED === '1';

// The Ethereum-style version of Aretia's pool (docs/ARETIA_POOL_EVM.md): same rule, its own flag, and nothing on any network without a deployed contract.
const aretiaPoolEvmOn = import.meta.env.PUBLIC_ARETIA_POOL_EVM_ENABLED === '1';

// Sending from an Ethereum-style account stays out of the page until the site is built with PUBLIC_PAY_EVM_SEND=1.
const evmSendOn = import.meta.env.PUBLIC_PAY_EVM_SEND === '1';
const evmSendNetworks = (Object.values(CHAINS) as { id: string; name: string; kind: string }[]).filter((c) => c.kind === 'evm');
const sendTips = [
  'Transfers on Solana cannot be reversed. Check the full address on the review screen.',
  'Aretia never holds your keys. Your wallet shows the transaction and signs it; this page then submits it.',
  'Before it asks your wallet, the page simulates the transaction on a public RPC. A failed simulation blocks the send.',
  'The addresses and amounts involved, and any .sns name you type, are sent to a public Solana RPC.',
  'Sending a token to an address that has no account for it opens one, paid in SOL by you (about 0.002 SOL).',
  `ACT carries a ${ACT.transferFee.totalPercent}% transfer fee on every move, so the recipient gets slightly less than you send.`,
];
---

<Base
  title="Wallet"
  description="Aretia web wallet: connect the Solana wallet you already use to see your balances and activity and trade ACT. Aretia never holds your keys."
  walletConnect
  ctaBands={false}
  footer={false}
>
  <link slot="head" rel="stylesheet" href="/assets/wallet/wallet.css" />
  <!-- The chart and its table read from these two hosts; opening the connections early saves the handshake on the first read. -->
  <link slot="head" rel="preconnect" href="https://api.geckoterminal.com" crossorigin />
  <link slot="head" rel="preconnect" href="https://api.dexscreener.com" crossorigin />
  <script slot="head" is:inline>document.documentElement.dataset.wappSidebar = 'collapsed';</script>

  <div class="wapp" data-wapp data-connected="false" data-view="dashboard">
    <aside class="wapp__side" aria-label="Wallet" data-lenis-prevent>
      <div class="wapp__side-head">
        <a class="wapp__brand" href="/home" aria-label="Aretia Finance home">
          <img src="/assets/logo-mark.png" width="28" height="28" alt="" />
          <span>Aretia</span>
        </a>
      </div>
      <div class="wapp__account" data-account aria-live="polite"></div>
      <nav class="wapp__nav" id="wapp-nav" aria-label="Wallet sections">
        <button type="button" data-nav="dashboard" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="7.5" height="9" rx="2" /><rect x="13.5" y="3" width="7.5" height="5" rx="2" /><rect x="13.5" y="11" width="7.5" height="10" rx="2" /><rect x="3" y="15" width="7.5" height="6" rx="2" /></svg>
          <span class="wapp__label">Dashboard</span>
        </button>
        <button type="button" data-nav="swings">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7" /></svg>
          <span class="wapp__label">Markets</span>
        </button>
        <button type="button" data-nav="send">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          <span class="wapp__label">Pay</span>
        </button>
        <button type="button" data-nav="launch">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3c3 2.3 5 5.2 5 9l-2.2 3.2H9.2L7 12c0-3.8 2-6.7 5-9zM9.2 15.2L7 19l3.2-1.2M14.8 15.2L17 19l-3.2-1.2M12 9.5v.01" /></svg>
          <span class="wapp__label">Launch</span>
        </button>
        <button type="button" data-nav="launchbox">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3.5 8.5L12 4l8.5 4.5v7L12 20l-8.5-4.5zM3.5 8.5L12 13l8.5-4.5M12 13v7" /></svg>
          <span class="wapp__label">Launch Box</span>
        </button>
        <button type="button" data-nav="radar">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><path d="M12 12l5-5" /></svg>
          <span class="wapp__label">Radar</span>
        </button>
        <button type="button" data-nav="carbon">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-14 14zM5 19c3-4 6-7 10-10" /></svg>
          <span class="wapp__label">Carbon Credit</span>
        </button>
        <button type="button" data-nav="safesend">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg>
          <span class="wapp__label">SafeSend</span>
        </button>
        <button type="button" data-nav="shield">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg>
          <span class="wapp__label">Shield</span>
        </button>
        <button type="button" data-nav="favourites">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8 6.8 19.6l1-5.8-4.3-4.1 5.9-.9z" /></svg>
          <span class="wapp__label">Favourites</span>
        </button>
        <button type="button" data-nav="referrals">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2.5 19c.6-2.6 2.8-4 5.5-4s4.9 1.4 5.5 4M14 15.3c.6-.2 1.3-.3 2-.3 2.7 0 4.9 1.4 5.5 4" /></svg>
          <span class="wapp__label">Referrals</span>
        </button>
        <button type="button" data-nav="activity">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
          <span class="wapp__label">Activity</span>
        </button>
      </nav>
      <div class="wapp__side-foot">
        <button type="button" class="wapp__lock wapp__bell" data-bell title="Notifications">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 17V11a6 6 0 0 1 12 0v6l1.5 2h-15zM10 21h4" /></svg>
          <span class="wapp__label">Notifications</span>
          <span class="wapp__bell-count" data-bell-count hidden>0</span>
        </button>
        <button type="button" class="wapp__lock" data-lock title="Optional: protect this wallet on this computer with a password, PIN or your computer's own unlock">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          <span class="wapp__label">Lock wallet</span>
        </button>
      </div>
    </aside>

    <nav class="wapp__rail" data-rail aria-label="Networks"></nav>

    <section class="wapp__main">
      <header class="wapp__top">
        <h1 data-title>Dashboard</h1>
        <div class="wapp__chips">
          <button type="button" class="wapp__chip wapp__chip--btn" data-refresh>Refresh</button>
        </div>
      </header>

      <div class="wapp__gate" data-gate>
        <h2>Connect your wallet</h2>
        <p>
          Connect Phantom, Solflare, Backpack, the Aretia extension or another Solana wallet. Aretia never holds your keys or your recovery phrase: this page only reads public data for the wallet you connect, and your own wallet asks you to approve anything that moves money.
        </p>
        <button type="button" class="wapp__btn wapp__btn--primary" data-connect>Connect wallet</button>
        <p class="wapp__fine">
          No wallet yet? Aretia's own wallet is still in development. <a href="/wallet/about">Read about it and join the waitlist</a>.
        </p>
      </div>

      <div data-pane="dashboard" class="wapp__pane wapp-dash">
        <div class="wapp-dash__main">
          <section class="wapp-dash__hero" aria-label="Portfolio">
            <div class="wapp-dash__hero-top">
              <div class="wapp-dash__value">
                <span class="wapp__eyebrow">Portfolio value</span>
                <div class="wapp__total" data-total>—</div>
                <div class="wapp__sub" data-total-sub></div>
              </div>
              <button type="button" class="wapp__icon" data-hide aria-label="Hide amounts" aria-pressed="false">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
              </button>
            </div>
            <div class="wapp-dash__alloc" data-alloc hidden>
              <div class="wapp-dash__alloc-bar" data-alloc-bar role="img" aria-label="How the portfolio is split between tokens"></div>
              <ul class="wapp-dash__alloc-legend" data-alloc-legend></ul>
            </div>
            <div class="wapp-dash__actions" role="group" aria-label="Quick actions">
              <button type="button" class="wapp-dash__action" data-nav="send"><span aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17L17 7M9 7h8v8" /></svg></span>Send</button>
              <button type="button" class="wapp-dash__action" data-receive><span aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M17 7L7 17M15 17H7V9" /></svg></span>Receive</button>
              <button type="button" class="wapp-dash__action" data-nav="swap"><span aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 8h13l-3-3M20 16H7l3 3" /></svg></span>Swap</button>
              <button type="button" class="wapp-dash__action" data-nav="swings"><span aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 19V11M12 19V5M19 19v-6" /></svg></span>Markets</button>
            </div>
          </section>

          <section class="wapp__card wapp-dash__holdings" id="all-assets" aria-labelledby="dash-holdings">
            <div class="wapp-dash__head">
              <h2 class="wapp__h2" id="dash-holdings">Holdings</h2>
              <span class="wapp-sub" data-token-count></span>
            </div>
            <div data-holdings></div>
          </section>
        </div>

        <aside class="wapp-dash__side" aria-label="Wallet and tools">
          <section class="wapp__card wapp-dash__wallet" data-wallet-card aria-label="This wallet">
            <div class="wapp-dash__head">
              <span class="wapp__eyebrow">Wallet</span>
              <strong class="wapp-dash__wallet-name" data-wallet-name>—</strong>
            </div>
            <div class="wapp-dash__addr">
              <code class="wapp-mono" data-address></code>
              <button type="button" class="wapp__btn wapp__btn--ghost wapp-dash__copy" data-copy>Copy address</button>
            </div>
            <p class="wapp-dash__evm" data-evm-line hidden></p>
            <a class="wapp-dash__link" data-solscan target="_blank" rel="noopener noreferrer" href="https://solscan.io">View on Solscan ↗</a>
          </section>

          <section class="wapp__card wapp-dash__services" aria-labelledby="svc-title">
            <h2 class="wapp__h2" id="svc-title">Everything Aretia does</h2>
            <ul class="wapp-svc__grid">
            <li><button type="button" class="wapp-svc__tile" data-nav="swings"><ProductLogo product="marketplace" size={36} /><strong>Marketplace</strong></button></li>
            <li><button type="button" class="wapp-svc__tile" data-nav="send"><ProductLogo product="pay" size={36} /><strong>Pay</strong></button></li>
            <li><button type="button" class="wapp-svc__tile" data-nav="carbon"><ProductLogo product="carbon" size={36} /><strong>Carbon Credit</strong></button></li>
            <li><button type="button" class="wapp-svc__tile" data-nav="shield"><ProductLogo product="shield" size={36} /><strong>Shield</strong></button></li>
            <li><button type="button" class="wapp-svc__tile" data-nav="safesend"><ProductLogo product="safesend" size={36} /><strong>SafeSend</strong></button></li>
            <li><button type="button" class="wapp-svc__tile" data-nav="radar"><ProductLogo product="radar" size={36} /><strong>Radar</strong></button></li>
            </ul>
          </section>

          <section class="wapp__card wapp-dash__recent" aria-labelledby="dash-recent">
            <div class="wapp-dash__head">
              <h2 class="wapp__h2" id="dash-recent">Recent activity</h2>
              <button type="button" class="wapp-dash__more" data-nav="activity">View all</button>
            </div>
            <ul class="wapp-dash__recent-list" data-recent></ul>
          </section>
        </aside>
      </div>

      <div data-pane="send" class="wapp__pane" hidden>
        <div class="wapp__stack wapp-pay">
          <div class="wapp-pay__hub" role="tablist" aria-label="Pay">
            <button type="button" class="wapp-pay__card" role="tab" data-pay-tab="send" aria-selected="true">
              <span class="wapp-pay__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M7 17L17 7M9 7h8v8" /></svg></span>
              <span class="wapp-pay__text"><strong>Send</strong><span>Send SOL or a token to an address or a .sns name.</span></span>
            </button>
            <button type="button" class="wapp-pay__card" role="tab" data-pay-tab="ramp" aria-selected="false">
              <span class="wapp-pay__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path d="M6.5 9.5v.01M17.5 14.5v.01" /></svg></span>
              <span class="wapp-pay__text"><strong>Cash out or top up</strong><span>Turn USDC into cash, or buy USDC with a card or bank transfer.</span></span>
            </button>
            <button type="button" class="wapp-pay__card" role="tab" data-pay-tab="transfer" aria-selected="false">
              <span class="wapp-pay__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 8h13l-3-3M20 16H7l3 3" /></svg></span>
              <span class="wapp-pay__text"><strong>Move USDC</strong><span>Send USDC from one network to another.</span></span>
            </button>
          </div>
          <p class="wapp__intro" data-pay-intro aria-live="polite"></p>
          <div data-pay-panel="send">
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__stack">
            <div class="wapp__card">
              <h2 class="wapp__h2">Send or pay</h2>
              <p class="wapp__fine">
                Send SOL or a token you hold to a Solana address, or pay a <b>.sns</b> name. You review the full transaction here, then approve it in your own wallet.
              </p>
              <form class="wapp__form" data-send-form>
                {evmSendOn && (
                  <>
                    <label for="send-network" class="wapp__eyebrow">Network</label>
                    <select id="send-network" class="wapp__input" data-send-network>
                      <option value="solana">Solana</option>
                      {evmSendNetworks.map((c) => <option value={c.id}>{c.name}</option>)}
                    </select>
                  </>
                )}
                <label for="send-asset" class="wapp__eyebrow">Asset</label>
                <select id="send-asset" class="wapp__input" data-send-asset disabled><option>Loading your tokens…</option></select>
                <label for="send-to" class="wapp__eyebrow">Recipient address or .sns name</label>
                <input id="send-to" class="wapp__input wapp-mono" data-send-to autocomplete="off" spellcheck="false" placeholder="Address or name.sns" />
                <label for="send-amount" class="wapp__eyebrow">Amount</label>
                <div class="wapp__amount">
                  <input id="send-amount" class="wapp__input" data-send-amount inputmode="decimal" autocomplete="off" placeholder="0.0" />
                  <button type="button" class="wapp__btn wapp__btn--ghost" data-send-max>Max</button>
                </div>
                <button type="submit" class="wapp__btn wapp__btn--primary">Review</button>
              </form>
              <div data-send-review aria-live="polite"></div>
            </div>
          </div>
            <div class="wapp__card">
              <span class="wapp__eyebrow">Before you send</span>
              <ul class="wapp__list">{sendTips.map((tip) => <li>{tip}</li>)}</ul>
            </div>
        </div>
          </div>
          <div data-pay-panel="ramp" class="wapp__stack" hidden></div>
          <div data-pay-panel="transfer" class="wapp__stack" hidden>
            <div class="wapp__seg wapp__seg--sub" role="tablist" aria-label="USDC Transfer" data-transfer-modes>
              <button type="button" class="wapp__chip wapp__chip--btn" role="tab" data-transfer-mode="move" aria-selected="true">Move between networks</button>
              <button type="button" class="wapp__chip wapp__chip--btn" role="tab" data-transfer-mode="plan" aria-selected="false">Buy with cash, then send</button>
            </div>
            <div class="wapp__stack" data-transfer-pane="move"></div>
            <div class="wapp__stack" data-transfer-pane="plan" hidden></div>
          </div>
        </div>
      </div>

      <div data-pane="swings" class="wapp__pane" hidden>
        <div class="wapp__stack">
          <p class="wapp__intro" data-sw-intro aria-live="polite"></p>
          <div data-sw-panel="swap" class="wapp__stack" hidden></div>
          <div data-sw-panel="markets" class="wapp__stack"></div>
          <details class="wapp__fineprint">
            <summary>Good to know before you use Swings</summary>
            <ul>
              <li><strong>Your wallet signs everything.</strong> Aretia never holds your keys or your money.</li>
              <li><strong>You see the cost first.</strong> The quote, the least you will receive and every fee are shown before anything is signed.</li>
              <li><strong>Quotes are not promises.</strong> Prices move, and a quote runs out after a short time.</li>
              <li><strong>Big trades in small pools can be sandwiched.</strong> Swaps are not sent through a protected route.</li>
              <li><strong>A coin being listed is not a recommendation.</strong> Check the safety notes and the address before you buy.</li>
              <li>The swap window marks any network that is switched off.</li>
            </ul>
          </details>
        </div>
      </div>

      <div data-pane="launchbox" class="wapp__pane" hidden>
        <div class="wapp__card wapp-mt__card wapp-lb" data-lb-root aria-live="polite"></div>
      </div>

      <div data-pane="radar" class="wapp__pane" hidden>
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__card">
            <h2 class="wapp__h2">Look up a token with Aretia Radar</h2>
            <p class="wapp__fine">
              Search for a token by name or symbol, or paste its address. Radar gathers what it can find about the token's market, contract and holders, scores it, and shows what it could not find as unknown. It needs no wallet connection and it never trades.
            </p>
            <form class="wapp__form" data-radar-form>
              <label for="radar-input" class="wapp__eyebrow">Token name, symbol or address</label>
              <input id="radar-input" class="wapp__input wapp-mono" autocomplete="off" spellcheck="false" placeholder="Search by name or symbol, or paste an address" />
              <div class="wapp-rd__chains" data-radar-chains role="group" aria-label="Which chain is this token on?" hidden></div>
              <button type="submit" class="wapp__btn wapp__btn--primary">Analyze</button>
            </form>
            <div class="wapp-rd__chains" data-radar-recent aria-label="Recently looked up" hidden></div>
            <div data-radar-result aria-live="polite"></div>
          </div>
          <div class="wapp__card">
            <span class="wapp__eyebrow">Analyzed by Radar</span>
            <div data-radar-home aria-live="polite"><p class="wapp__fine">Loading…</p></div>
            <span class="wapp__eyebrow">What Radar can and cannot tell you</span>
            <ul class="wapp__list">
              <li>Radar is analysis, not advice or a forecast. A high score does not mean a token will rise, and a clean check does not mean it is safe.</li>
              <li>Anything it could not find shows as unknown, and unknown is never counted as a pass.</li>
              <li>Contract checks are as reported by the data sources named in each result, and may be incomplete or late, especially for new tokens.</li>
              <li>A name you search is sent to the wallet's token search (Aretia's registry and GeckoTerminal). The token address you analyze is sent to Aretia's Radar server and its data sources, and nowhere else.</li>
            </ul>
