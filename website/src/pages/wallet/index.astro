  .wapp-lockscreen { box-sizing: border-box; position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 24px; border: 0; background: linear-gradient(180deg, #2c1a9c 0%, #1d1170 100%); }
