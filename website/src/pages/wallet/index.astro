---
import Base from '../../layouts/Base.astro';
import { ACT, POOLS } from '../../data/site';
---

<Base
  title="Wallet"
  description="Aretia web wallet: connect the Solana wallet you already use to see your balances and activity and trade ACT. Aretia never holds your keys."
  walletConnect
  ctaBands={false}
  footer={false}
>
  <link slot="head" rel="stylesheet" href="/assets/wallet/wallet.css" />

  <div class="wapp" data-wapp data-connected="false" data-view="dashboard">
    <aside class="wapp__side" aria-label="Wallet">
      <a class="wapp__brand" href="/home" aria-label="Aretia Finance home">
        <img src="/assets/logo-mark.png" width="28" height="28" alt="" />
        <span>Aretia</span>
      </a>
      <div class="wapp__account" data-account aria-live="polite"></div>
      <nav class="wapp__nav" aria-label="Wallet sections">
        <button type="button" data-nav="dashboard" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="7.5" height="9" rx="2" /><rect x="13.5" y="3" width="7.5" height="5" rx="2" /><rect x="13.5" y="11" width="7.5" height="10" rx="2" /><rect x="3" y="15" width="7.5" height="6" rx="2" /></svg>
          Dashboard
        </button>
        <button type="button" data-nav="trade">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg>
          Trade
        </button>
        <button type="button" data-nav="activity">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
          Activity
        </button>
        <button type="button" data-nav="send">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          Pay
        </button>
        <button type="button" data-nav="shield">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg>
          Shield
        </button>
        <button type="button" data-nav="intent">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg>
          Intent
        </button>
      </nav>
      <div class="wapp__side-foot">
        <button type="button" class="wapp__lock" data-lock title="Disconnect this page from your wallet. Your funds and keys are not affected.">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          Lock wallet
        </button>
        <a href="/wallet/about">About Aretia Wallet</a>
        <a href="/buy">Buy ACT</a>
        <a href="/verify">Verify ACT on-chain</a>
      </div>
    </aside>

    <section class="wapp__main">
      <header class="wapp__top">
        <h1 data-title>Dashboard</h1>
        <div class="wapp__chips">
          <span class="wapp__chip">Solana · mainnet</span>
          <button type="button" class="wapp__chip wapp__chip--btn" data-refresh>Refresh</button>
        </div>
      </header>

      <div class="wapp__gate" data-gate>
        <h2>Connect your wallet</h2>
        <p>
          Connect Phantom, Solflare, Backpack, the Aretia extension or another Solana wallet. Aretia never holds your keys or your recovery phrase: this page only reads public data for the wallet you connect, and your own wallet asks you to approve anything that moves money.
        </p>
        <button type="button" class="wapp__btn wapp__btn--primary" data-connect>Connect wallet</button>
        <p class="wapp__fine">
          No wallet yet? Aretia's own wallet is still in development. <a href="/wallet/about">Read about it and join the waitlist</a>.
        </p>
      </div>

      <div data-pane="dashboard" class="wapp__pane">
        <section class="wapp__hero" aria-label="Overview">
          <div class="wapp__hero-copy">
            <span class="wapp__hero-eyebrow">Aretia Wallet</span>
            <h2 class="wapp__hero-title">One place to hold, send, swap and protect.</h2>
            <p class="wapp__hero-sub">Send · Receive · Swap · Protect</p>
            <div class="wapp__hero-cta">
              <button type="button" class="wapp__pill wapp__pill--solid" data-nav="send">Send</button>
              <button type="button" class="wapp__pill wapp__pill--outline" data-receive>Receive</button>
              <button type="button" class="wapp__pill wapp__pill--outline" data-nav="trade">Trade</button>
            </div>
          </div>

          <div class="wapp__hero-panel">
            <div class="wapp__hero-row">
              <div class="wapp__card wapp__card--wash">
                <div class="wapp__row">
                  <span class="wapp__eyebrow">Portfolio</span>
                  <button type="button" class="wapp__icon" data-hide aria-label="Hide amounts" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                  </button>
                </div>
                <div class="wapp__total" data-total>—</div>
                <div class="wapp__sub" data-total-sub></div>
              </div>
              <div class="wapp__card wapp__hero-stats">
                <div>
                  <span class="wapp__eyebrow">Tokens</span>
                  <div class="wapp__hero-stat" data-token-count>—</div>
                </div>
                <div>
                  <span class="wapp__eyebrow">Wallet</span>
                  <div class="wapp__hero-stat wapp__hero-stat--text" data-wallet-name>—</div>
                </div>
                <a class="wapp__hero-link" data-solscan target="_blank" rel="noopener noreferrer" href="https://solscan.io">View on Solscan</a>
              </div>
            </div>

            <div class="wapp__card wapp__hero-list">
              <div class="wapp__hero-tabs" role="tablist">
                <button type="button" role="tab" class="wapp__hero-tab" data-tab="assets" aria-selected="true">Your assets</button>
                <button type="button" role="tab" class="wapp__hero-tab" data-tab="address" aria-selected="false">Address</button>
                <button type="button" class="wapp__hero-viewall" data-scroll="all-assets">View all</button>
              </div>
              <div data-tabpanel="assets">
                <ul class="wapp__hero-assets" data-top-assets></ul>
              </div>
              <div data-tabpanel="address" class="wapp__receive" hidden>
                <span class="wapp__eyebrow">Your Solana address</span>
                <code class="wapp-mono" data-address></code>
                <button type="button" class="wapp__btn wapp__btn--ghost" data-copy>Copy address</button>
                <p class="wapp__fine">Send only Solana assets to this address.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="wapp__tools" aria-label="Aretia tools">
          <button type="button" class="wapp__tools-arrow" aria-label="Previous tools" data-tools-prev>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <div class="wapp__tools-track" data-tools-track>
          <button type="button" class="wapp__toolcard" data-nav="send"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M7 17L17 7M9 7h8v8" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Pay</span><strong>Send to a name</strong><span>Pay a .sns name instead of a long address.</span></span></button>
          <button type="button" class="wapp__toolcard" data-nav="shield"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Shield</span><strong>Check before you send</strong><span>Look up an address for no history or a smart contract.</span></span></button>
          <button type="button" class="wapp__toolcard" data-nav="intent"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Intent</span><strong>Type it, then review</strong><span>Write "swap 0.1 SOL for ACT" and confirm on the normal screen.</span></span></button>
          <a class="wapp__toolcard" href="/wallet/about"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M3 18v-2a9 9 0 0 1 18 0v2M3 18h18M8 18v-5M16 18v-5M12 18v-7" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia Universal<span class="wapp__toolcard-badge">Extension</span></span><strong>Move ACT across chains</strong><span>Bridge ACT between Solana and Ethereum. In the Aretia extension, testnet only today.</span></span></a>
          <a class="wapp__toolcard" href="/wallet/about"><span class="wapp__toolcard-art" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" /></svg></span><span class="wapp__toolcard-text"><span class="wapp__toolcard-tag">Aretia SafeSend<span class="wapp__toolcard-badge">Extension</span></span><strong>Send with a safety delay</strong><span>Hold a transfer in escrow so you can cancel it first. In the Aretia extension.</span></span></a>
          </div>
          <button type="button" class="wapp__tools-arrow" aria-label="Next tools" data-tools-next>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </section>

        <div class="wapp__section-head" id="all-assets">
          <h2>Everything in this wallet.</h2>
          <p>Every token this wallet holds, with prices where one exists.</p>
        </div>
        <div class="wapp__card">
          <h2 class="wapp__h2">Holdings</h2>
          <div data-holdings></div>
        </div>
      </div>

      <div data-pane="trade" class="wapp__pane" hidden>
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__card wapp__card--widget">
            <div id="jupiter-terminal" class="wapp__terminal"><span class="wapp__sub">Loading swap widget…</span></div>
          </div>
          <div class="wapp__card">
            <h2 class="wapp__h2">Trading ACT</h2>
            <p class="wapp__fine">Swaps are routed by Jupiter and signed in your own wallet. You see the full transaction before you approve it.</p>
            <ul class="wapp__list">
              <li>ACT carries a {ACT.transferFee.totalPercent}% transfer fee on every move, on top of pool and router fees.</li>
              <li>The launch pools open at a $0.005 floor, so buying below it is impossible. You can only sell back as much as buyers have paid in.</li>
              <li>Jupiter may show "Not sellable" and other warnings for new, thin tokens. They are automatic and don't mean ACT can't be sold.</li>
            </ul>
            <p class="wapp__eyebrow">ACT mint</p>
            <code class="wapp-mono wapp__mint">{ACT.mint}</code>
            <p class="wapp__fine">Other tokens can copy ACT's name. Only this mint is ACT.</p>
            <p class="wapp__eyebrow">Pools</p>
            {POOLS.map((p) => (
              <p class="wapp__fine"><a href={p.explorer} target="_blank" rel="noopener noreferrer">{p.pair}</a>{p.chart && <> · <a href={p.chart} target="_blank" rel="noopener noreferrer">chart</a></>}</p>
            ))}
          </div>
        </div>
      </div>

      <div data-pane="send" class="wapp__pane" hidden>
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__card">
            <h2 class="wapp__h2">Send or pay</h2>
            <p class="wapp__fine">
              Send SOL or a token you hold to a Solana address, or pay a <b>.sns</b> name. You review the full transaction here, then approve it in your own wallet.
            </p>
            <form class="wapp__form" data-send-form>
              <label for="send-asset" class="wapp__eyebrow">Asset</label>
              <select id="send-asset" class="wapp__input" data-send-asset disabled><option>Loading your tokens…</option></select>
              <label for="send-to" class="wapp__eyebrow">Recipient address or .sns name</label>
              <input id="send-to" class="wapp__input wapp-mono" data-send-to autocomplete="off" spellcheck="false" placeholder="Address or name.sns" />
              <label for="send-amount" class="wapp__eyebrow">Amount</label>
              <div class="wapp__amount">
                <input id="send-amount" class="wapp__input" data-send-amount inputmode="decimal" autocomplete="off" placeholder="0.0" />
                <button type="button" class="wapp__btn wapp__btn--ghost" data-send-max>Max</button>
              </div>
              <button type="submit" class="wapp__btn wapp__btn--primary">Review</button>
            </form>
            <div data-send-review aria-live="polite"></div>
          </div>
          <div class="wapp__card">
            <span class="wapp__eyebrow">Before you send</span>
            <ul class="wapp__list">
              <li>Transfers on Solana cannot be reversed. Check the full address on the review screen.</li>
              <li>Aretia never holds your keys. Your wallet shows the transaction and signs it; this page then submits it.</li>
              <li>Before it asks your wallet, the page simulates the transaction on a public RPC. A failed simulation blocks the send.</li>
              <li>The addresses and amounts involved, and any .sns name you type, are sent to a public Solana RPC.</li>
              <li>Sending a token to an address that has no account for it opens one, paid in SOL by you (about 0.002 SOL).</li>
              <li>ACT carries a {ACT.transferFee.totalPercent}% transfer fee on every move, so the recipient gets slightly less than you send.</li>
            </ul>
          </div>
        </div>
      </div>

      <div data-pane="shield" class="wapp__pane" hidden>
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__card">
            <h2 class="wapp__h2">Check an address before you send</h2>
            <p class="wapp__fine">
              Paste a Solana address. Shield looks the account up on-chain and flags an address that has never been used, or one that is a program or token account rather than a person's wallet. It needs no wallet connection.
            </p>
            <form class="wapp__form" data-shield-form>
              <label for="shield-input" class="wapp__eyebrow">Solana address</label>
              <input id="shield-input" class="wapp__input wapp-mono" autocomplete="off" spellcheck="false" placeholder="Paste an address" />
              <button type="submit" class="wapp__btn wapp__btn--primary">Check</button>
            </form>
            <div data-shield-result aria-live="polite"></div>
          </div>
          <div class="wapp__card">
            <span class="wapp__eyebrow">What Shield can and cannot tell you</span>
            <ul class="wapp__list">
              <li>It reads the account straight from a public Solana RPC. The address you check is sent to that RPC, and nowhere else.</li>
              <li>"No risks found" means nothing unusual was seen. It does not mean the address is safe. Confirm it with the recipient another way.</li>
              <li>Names such as bob.sns are not looked up on this page yet. Paste the address.</li>
            </ul>
          </div>
        </div>
      </div>

      <div data-pane="intent" class="wapp__pane" hidden>
        <div class="wapp__grid wapp__grid--trade">
          <div class="wapp__card">
            <h2 class="wapp__h2">Say what you want to do</h2>
            <p class="wapp__fine">
              Type a phrase and Intent shows how it read it. A swap opens the Trade tab, and a send opens the Send tab, with everything filled in. Nothing happens until you approve it in your own wallet.
            </p>
            <form class="wapp__form" data-intent-form>
              <label for="intent-input" class="wapp__eyebrow">What would you like to do?</label>
              <input id="intent-input" class="wapp__input" autocomplete="off" spellcheck="false" placeholder="swap 0.1 SOL for ACT" />
              <button type="submit" class="wapp__btn wapp__btn--primary">Read it</button>
            </form>
            <div class="wapp__examples">
              <button type="button" class="wapp__chip wapp__chip--btn" data-example="swap 0.1 SOL for ACT">swap 0.1 SOL for ACT</button>
              <button type="button" class="wapp__chip wapp__chip--btn" data-example="swap 5 USDC for SOL">swap 5 USDC for SOL</button>
              <button type="button" class="wapp__chip wapp__chip--btn" data-example="send 0.5 SOL to bob.sns">send 0.5 SOL to bob.sns</button>
            </div>
            <div data-intent-result aria-live="polite"></div>
          </div>
          <div class="wapp__card">
            <span class="wapp__eyebrow">How Intent works</span>
            <ul class="wapp__list">
              <li>It understands a fixed set of phrases ("swap 10 USDC for SOL", "send 0.5 SOL to …"). It is not an AI model, and it refuses anything else instead of guessing.</li>
              <li>Amounts must be plain numbers: not "$50", "half" or "all".</li>
              <li>Swaps use tokens you hold, plus SOL, USDC, USDT and ACT by their real mint addresses. If a name matches more than one token, you pick which one, so a lookalike token is never chosen for you.</li>
              <li>A send phrase opens the Send tab with the asset, address and amount filled in. You still review it there and approve it in your own wallet.</li>
            </ul>
          </div>
        </div>
      </div>

      <div data-pane="activity" class="wapp__pane" hidden>
        <div class="wapp__card">
          <h2 class="wapp__h2">Recent transactions</h2>
          <div data-activity></div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>
  <!-- ?v= busts the long browser cache on /assets (served as immutable); bump it whenever wallet.js changes. -->
  <script is:inline src="/assets/wallet/wallet.js?v=20261003b"></script>
  <script>
    import { initWalletApp } from '../../scripts/walletApp';
    initWalletApp();
  </script>
</Base>

<style is:global>
  /* The site nav is fixed to the top; pages offset their content by --nav-height. */
  .wapp { display: grid; grid-template-columns: 248px minmax(0, 1fr); box-sizing: border-box; min-height: 100vh; background: var(--color-bg-alt); }
  .wapp__side { position: sticky; top: 0; z-index: 60; align-self: start; display: flex; flex-direction: column; gap: 18px; height: 100vh; box-sizing: border-box; overflow-y: auto; padding: 22px 14px; background: linear-gradient(180deg, #2c1a9c 0%, #1d1170 100%); border-right: 0; }
  .wapp__account { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: var(--radius-lg); background: rgba(255, 255, 255, 0.12); }
  .wapp__account strong { font-size: 14px; color: #fff; }
  .wapp__account span { font-size: 12px; color: rgba(255, 255, 255, 0.78); }
  .wapp-mono { font-family: var(--font-mono); }
  .wapp__nav { display: grid; gap: 4px; }
  .wapp__nav button { display: flex; align-items: center; gap: 12px; padding: 10px 12px; font: inherit; font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.8); background: none; border: 0; border-radius: var(--radius-md); text-align: left; cursor: pointer; }
  .wapp__nav button svg, .wapp__icon svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wapp__nav button:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .wapp__nav button[aria-current='page'] { background: #fff; color: var(--color-brand); font-weight: 600; }
  .wapp__brand { display: flex; align-items: center; gap: 10px; padding: 0 6px; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; color: #fff; text-decoration: none; }
  .wapp__brand img { box-sizing: border-box; width: 30px; height: 30px; padding: 3px; background: #fff; border-radius: 9px; }
  .wapp__brand:focus-visible, .wapp__lock:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .wapp__lock { display: flex; align-items: center; gap: 12px; padding: 10px 12px; font: inherit; font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.85); background: rgba(255, 255, 255, 0.1); border: 0; border-radius: var(--radius-md); text-align: left; cursor: pointer; }
  .wapp__lock svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wapp__lock:hover { background: rgba(255, 255, 255, 0.2); color: #fff; }
  .wapp[data-connected='false'] [data-lock] { display: none; }
  .wapp__side-foot { margin-top: auto; display: grid; gap: 8px; font-size: 13px; }
  .wapp__side-foot a { color: rgba(255, 255, 255, 0.78); }
  .wapp__side-foot a:hover { color: #fff; }
  .wapp__side :focus-visible { outline-color: #fff; }

  .wapp__main { min-width: 0; padding: calc(var(--nav-height) + 16px) 36px 56px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-content: start; }
  .wapp__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .wapp[data-view='dashboard'] .wapp__top h1 { display: none; }
  .wapp__chips { margin-left: auto; }
  .wapp__top h1 { margin: 0; font-size: 1.75rem; font-weight: 700; letter-spacing: -0.01em; color: var(--color-strong); }
  .wapp__chips { display: flex; gap: 8px; }
  .wapp__chip { padding: 6px 12px; font: inherit; font-size: 12px; font-weight: 600; color: var(--color-brand); background: var(--color-brand-soft); border: 0; border-radius: var(--radius-pill); }
  .wapp__chip--btn { cursor: pointer; }
  .wapp__chip--btn:hover { background: var(--color-bg); box-shadow: inset 0 0 0 1px var(--color-border-strong); }

  .wapp__card { padding: 22px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); display: grid; gap: 12px; align-content: start; }
  .wapp__card--wash { background: linear-gradient(135deg, #4a2ee0 0%, #3a22c8 50%, #26168a 100%); border-color: transparent; box-shadow: 0 14px 30px rgba(38, 22, 138, 0.3); }
  .wapp__card--wash .wapp__eyebrow, .wapp__card--wash .wapp__sub, .wapp__card--wash .wapp-sub { color: rgba(255, 255, 255, 0.78); }
  .wapp__card--wash .wapp__total { color: #fff; }
  .wapp__card--wash .wapp__icon { background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.28); color: #fff; }
  .wapp__card--wash .wapp__btn--primary { background: #fff; color: #190880; }
  .wapp__card--wash .wapp__btn--primary:hover { background: #e4defc; }
  .wapp__card--wash .wapp__btn--dark { background: rgba(10, 6, 48, 0.7); }
  .wapp__card--wash .wapp__btn--ghost { background: transparent; border-color: rgba(255, 255, 255, 0.5); color: #fff; }
  .wapp__card--wash :focus-visible { outline-color: #fff; }
  .wapp__card--widget { padding: 12px; }
  .wapp__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .wapp__grid--trade { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .wapp__row { display: flex; align-items: center; justify-content: space-between; }
