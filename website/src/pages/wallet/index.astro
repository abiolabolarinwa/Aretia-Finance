  .lh-side { gap: 14px; }
  .lh-side__h { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); }
  .lh-side__fine { margin: 0; font-size: 12px; line-height: 1.5; color: var(--color-muted); }
  .lh-token__top { display: flex; align-items: center; gap: 14px; }
  .lh-token__avatar { flex: none; display: grid; place-items: center; width: 56px; height: 56px; font-size: 14px; font-weight: 800; color: #fff; background: linear-gradient(135deg, #4a2ee0 0%, #26168a 100%); border-radius: 50%; }
  [data-hub-preview][data-empty='1'] .lh-token__avatar { background: var(--wapp-indigo, #e9e6fc); color: var(--color-brand); }
  [data-hub-preview][data-empty='1'] .lh-token__name { color: var(--color-muted); }
  .lh-token__head { display: grid; gap: 2px; min-width: 0; }
