  .lh-nav__back:disabled { opacity: 0.5; cursor: not-allowed; }
  .lh-nav__back:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 6px; }

  .lh-live { justify-items: center; text-align: center; gap: 14px; padding: 34px 26px; }
  .lh-live__mark { display: grid; place-items: center; width: 64px; height: 64px; font-size: 19px; font-weight: 800; color: #fff; background: #1f7a46; border-radius: 50%; animation: lh-pop 360ms cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .lh-live__title { margin: 0; font-size: 18px; letter-spacing: -0.01em; color: var(--color-strong); }
  .lh-live__lead { margin: 0; max-width: 44ch; font-size: 13px; line-height: 1.55; color: var(--color-muted); }
  .lh-live__rows { margin: 6px 0 0; display: grid; gap: 10px; width: 100%; text-align: left; }
  .lh-live__rows > div { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; padding: 12px 14px; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 14px; }
  .lh-live__rows dt { grid-column: 1 / -1; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-muted); }
  .lh-live__rows dd { margin: 0; min-width: 0; font-size: 12px; overflow-wrap: anywhere; color: var(--color-strong); }
  .lh-live__copy { min-height: 36px; padding: 0 14px; font: inherit; font-size: 12px; font-weight: 600; color: var(--color-brand); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px; cursor: pointer; }
  .lh-live__copy:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
