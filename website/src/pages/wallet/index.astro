  .wapp__step-list .wapp__step-n { display: grid; place-items: center; width: 22px; height: 22px; font-size: 12px; font-weight: 700; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 50%; }
  .wapp__step-list small { display: block; color: var(--color-muted); }
  /* The swap stays in view while the long chart and trade list scroll past it. */
  @media (min-width: 1000px) {
    [data-sw-panel='swap'] .wapp__grid--trade { align-items: start; }
    [data-sw-panel='swap'] .wapp__grid--trade > .wapp__swap { position: sticky; top: 16px; }
  }

  /* ---- Swings layout: network logos in a slim column beside the sidebar, centred tabs, a chart that fills the screen ---- */
  .wapp__rail { display: none; }
  .wapp:is([data-view='swings'], [data-view='swap']) { grid-template-columns: var(--wapp-side) 76px minmax(0, 1fr); }
  .wapp:is([data-view='swings'], [data-view='swap']) .wapp__rail { position: sticky; top: 0; z-index: 40; align-self: start; display: flex; flex-direction: column; align-items: center; gap: 10px; box-sizing: border-box; height: 100vh; padding: calc(var(--nav-height) + 16px) 0 16px; overflow-x: hidden; overflow-y: auto; background: var(--color-bg); border-right: 1px solid var(--color-border); }
  body:has(.wapp:is([data-view='swings'], [data-view='swap'])) .nav--wallet .nav__bar { padding-left: calc(var(--wapp-side, 248px) + 76px + 36px); }
  .wapp__netbtn { position: relative; display: grid; place-items: center; flex: none; width: 48px; height: 48px; padding: 0; background: var(--color-bg-alt); border: 2px solid transparent; border-radius: 50%; cursor: pointer; transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease; }
  .wapp__netbtn img { display: block; width: 36px; height: 36px; object-fit: cover; border-radius: 50%; }
  .wapp__netbtn:hover { transform: scale(1.06); box-shadow: 0 4px 14px rgba(20, 10, 80, 0.16); }
  .wapp__netbtn:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp__netbtn[aria-pressed='true'] { border-color: var(--color-brand); box-shadow: 0 0 0 3px var(--color-brand-soft); }
  .wapp__netbtn[data-off='true'] { opacity: 0.45; filter: grayscale(0.8); }
  .wapp__netbtn[data-off='true']:hover { opacity: 0.8; }
  .wapp__seg--tabs { justify-content: center; gap: 10px; }
  .wapp__seg--tabs .wapp__chip { padding: 9px 18px; font-size: 14px; }
  .wapp__seg--sub { justify-content: center; }
  .wapp__intro { margin-inline: auto; text-align: center; }
  /* Search box in the top bar, on the same line as the network and price chips */
  .wapp-search { position: relative; flex: 1 1 auto; min-width: 200px; max-width: 560px; margin: 0 auto; }
  .wapp-search__icon { position: absolute; left: 14px; top: 50%; display: grid; color: var(--color-muted); transform: translateY(-50%); pointer-events: none; }
  .wapp-search__icon svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .wapp-search__input { box-sizing: border-box; width: 100%; height: 40px; padding: 0 14px 0 38px; font: inherit; font-size: 14px; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px; }
  .wapp-search__input:focus { outline: 2px solid var(--color-brand); outline-offset: 1px; }
  .wapp-search__list { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 90; display: grid; gap: 2px; max-height: min(70vh, 460px); margin: 0; padding: 6px; overflow-y: auto; list-style: none; background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 16px; box-shadow: 0 16px 40px rgba(20, 10, 80, 0.18); }
  .wapp-search__list[hidden] { display: none; }
  .wapp-search__note { padding: 10px 12px; font-size: 13px; color: var(--color-muted); }
  .wapp-search__item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; font: inherit; text-align: left; color: var(--color-strong); background: none; border: 0; border-radius: 12px; cursor: pointer; }
  .wapp-search__row[aria-selected='true'] .wapp-search__item, .wapp-search__item:hover { background: var(--color-brand-soft); }
  .wapp-search__logo { width: 28px; height: 28px; font-size: 10px; }
  .wapp-search__text { display: grid; flex: 1; min-width: 0; }
  .wapp-search__text strong { font-size: 14px; }
  .wapp-search__text small { overflow: hidden; font-size: 12px; color: var(--color-muted); text-overflow: ellipsis; white-space: nowrap; }
  .wapp-search__side { display: grid; justify-items: end; gap: 2px; font-size: 11px; color: var(--color-muted); }
  .wapp-search__new { padding: 1px 8px; font-size: 11px; font-weight: 700; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 999px; }
  @media (max-width: 1080px) { .wapp__top .wapp-search { order: 3; flex-basis: 100%; max-width: none; } .wapp__top { flex-wrap: wrap; } }
  @media (max-width: 960px) {
    .wapp:is([data-view='swings'], [data-view='swap']) { grid-template-columns: minmax(0, 1fr); }
    .wapp:is([data-view='swings'], [data-view='swap']) .wapp__rail { position: static; flex-direction: row; height: auto; padding: 10px 16px; overflow-x: auto; overflow-y: hidden; border-right: 0; border-bottom: 1px solid var(--color-border); }
    body:has(.wapp:is([data-view='swings'], [data-view='swap'])) .nav--wallet .nav__bar { padding-left: 16px; }
  }

  /* Swings: no page title; the tabs sit in the top bar beside the search box; the chart takes the freed space */
  .wapp:is([data-view='swings'], [data-view='swap']) .wapp__top h1 { display: none; }
  .wapp:is([data-view='swings'], [data-view='swap']) .wapp__top:not(:has(.wapp__chips, .wapp-search, .wapp__seg--tabs)) { display: none; }
  .nav__bar > .wapp__seg--tabs { flex: none; flex-wrap: nowrap; gap: 6px; margin: 0 0 0 12px; }
  .nav__bar > .wapp__seg--tabs .wapp__chip { padding: 7px 11px; font-size: 12.5px; white-space: nowrap; }
  body:not(:has(.wapp[data-view='swings'])) .nav__bar > .wapp__seg--tabs { display: none; }
  .nav__bar > .wapp-search { flex: 1 1 280px; min-width: 170px; max-width: 380px; margin: 0; }
  [data-sw-panel='swap'] .wapp__chart-plot { height: calc(100vh - 300px); }

  .wapp[data-view='swap'] [data-sw-tabs], .wapp[data-view='swap'] [data-sw-intro] { display: none; }

  /* ---- Pay: three ways to move money, as cards ---- */
  .wapp-pay__hub { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .wapp-pay__card { display: flex; align-items: center; gap: 14px; padding: 16px 18px; font: inherit; text-align: left; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); cursor: pointer; transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease; }
  .wapp-pay__card:hover { transform: translateY(-1px); border-color: var(--color-border-strong); }
  .wapp-pay__card:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-pay__card[aria-selected='true'] { border-color: var(--color-brand); box-shadow: 0 0 0 3px var(--color-brand-soft); }
  .wapp-pay__icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 14px; }
  .wapp-pay__icon svg { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .wapp-pay__text { display: grid; gap: 3px; min-width: 0; }
  .wapp-pay__text strong { font-size: 15px; }
  .wapp-pay__text span { font-size: 12.5px; line-height: 1.4; color: var(--color-muted); }
  @media (max-width: 860px) { .wapp-pay__hub { grid-template-columns: minmax(0, 1fr); } }

  /* ---- Swap opened over the page it was started from ---- */
  .wapp-swapdlg { position: fixed; inset: 0; z-index: 300; display: grid; place-items: start center; overflow-y: auto; padding: calc(var(--nav-height, 64px) + 12px) 16px 32px; background: rgba(15, 12, 40, 0.5); }
  .wapp-swapdlg[hidden] { display: none; }
  /* Just the swap card, centred over the dimmed page: no second panel behind it and no title. */
  .wapp-swapdlg__box { position: relative; box-sizing: border-box; width: min(440px, 100%); margin-inline: auto; }
  .wapp-swapdlg [data-swap-dialog-slot] .wapp__grid.wapp__grid--trade { grid-template-columns: minmax(0, 1fr); justify-items: stretch; }
  .wapp-swapdlg .wapp__trade-side { display: none; }
  .wapp-swapdlg .wapp__swap { width: 100%; box-shadow: 0 24px 80px rgba(10, 6, 50, 0.35); }
  .wapp-swapdlg__bar { position: absolute; top: 12px; right: 12px; z-index: 3; }
  .wapp-swapdlg__close { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; font: inherit; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 50%; cursor: pointer; }
  .wapp-swapdlg__close:hover { background: var(--color-brand-soft); }
  .wapp-swapdlg__close:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  body:has(.wapp-swapdlg:not([hidden])) { overflow: hidden; }

  /* ---- Find Tokens and Marketplace: a light table of tokens, one row each ---- */
  .wapp-mt__starcell, .wapp-mt__starhead { width: 28px; padding-right: 0; }
  .wapp-mt__star { padding: 2px 4px; font-size: 17px; line-height: 1; color: var(--color-muted); background: none; border: 0; border-radius: 6px; cursor: pointer; }
  .wapp-mt__star[aria-pressed='true'] { color: #d99a00; }
  .wapp-mt__star:hover { color: #d99a00; }
  .wapp-mt__star:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 1px; }
  .wapp-acct { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .wapp-mt__lock { display: inline-flex; vertical-align: -2px; margin-right: 5px; color: #16a34a; cursor: help; }
  .wapp-mt__pager { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 14px; }
  .wapp-mt__pager .wapp-mt__pageno { width: 64px; min-width: 0; text-align: center; }
  .wapp__card.wapp-mt__card { padding: 14px 18px 16px; gap: 10px; }
  .wapp-mt__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .wapp-mt__bar .wapp__input { width: auto; min-width: 150px; }
  .wapp-mt__check { display: inline-flex; align-items: center; gap: 8px; }
  .wapp-mt { overflow-x: auto; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 14px; }
  .wapp-mt__table { width: 100%; min-width: 1080px; border-collapse: separate; border-spacing: 0; font-size: 12px; font-variant-numeric: tabular-nums; color: var(--color-strong); }
  .wapp-mt__table th { position: sticky; top: 0; z-index: 1; padding: 8px 10px; font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-align: right; text-transform: uppercase; white-space: nowrap; color: var(--color-muted); background: var(--color-bg-alt); border-bottom: 1px solid var(--color-border); }
  .wapp-mt__table th.wapp-mt__rank, .wapp-mt__table th.wapp-mt__tokenhead { text-align: left; }
  .wapp-mt__sort { padding: 0; font: inherit; color: inherit; letter-spacing: inherit; text-transform: inherit; background: none; border: 0; cursor: pointer; }
  .wapp-mt__sort:hover, .wapp-mt__sort:focus-visible { color: var(--color-brand); outline: none; }
  .wapp-mt__row td { padding: 6px 10px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--color-border); }
  .wapp-mt__row { cursor: pointer; }
  .wapp-mt__row:hover td { background: var(--color-brand-soft); }
  .wapp-tp { display: grid; gap: 14px; }
  .wapp-tp[hidden] { display: none; }
  .wapp-tp__top { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .wapp-tp__title { display: flex; align-items: center; gap: 10px; }
  .wapp-tp__logo { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .wapp-tp__name { font-size: 20px; color: var(--color-strong); }
  .wapp-tp__net { font-size: 13px; color: var(--color-muted); }
  .wapp-tp__grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 14px; align-items: start; }
  .wapp-tp__chart, .wapp-tp__side { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 14px; padding: 12px; }
  .wapp-tp__frame { display: block; width: 100%; height: max(640px, calc(100vh - 190px)); border: 0; border-radius: 10px; background: #fff; }
  .wapp-tp__side { display: grid; gap: 12px; }
  .wapp-tp__pair { margin: 0; font-size: 18px; color: var(--color-strong); }
  .wapp-tp__duo, .wapp-tp__trio, .wapp-tp__quad { display: grid; gap: 8px; }
  .wapp-tp__duo { grid-template-columns: 1fr 1fr; }
  .wapp-tp__trio { grid-template-columns: repeat(3, 1fr); }
  .wapp-tp__quad { grid-template-columns: repeat(4, 1fr); }
  .wapp-tp__stat { display: grid; gap: 2px; padding: 8px 10px; text-align: center; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 10px; min-width: 0; }
  .wapp-tp__k { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .wapp-tp__v { font-size: 14px; font-variant-numeric: tabular-nums; color: var(--color-strong); overflow-wrap: anywhere; }
  .wapp-tp__stat.is-up .wapp-tp__v { color: #1b8a4b; }
  .wapp-tp__stat.is-down .wapp-tp__v { color: #b3261e; }
  .wapp-tp__trio .wapp-tp__meter { grid-column: 1 / -1; }
  .wapp-tp__meter { height: 6px; overflow: hidden; background: #d9534f; border-radius: 3px; }
  .wapp-tp__meter-buy { display: block; height: 100%; background: #1b8a4b; }
  .wapp-tp__links { display: flex; flex-wrap: wrap; gap: 6px; }
  .wapp-tp__risk { margin: 0; padding: 10px 12px; font-size: 13px; color: var(--color-strong); background: var(--color-brand-soft); border-radius: 10px; }
  .wapp-tp__actions { display: grid; gap: 8px; }
  @media (max-width: 1000px) {
    .wapp-tp__grid { grid-template-columns: 1fr; }
    .wapp-tp__frame { height: 560px; }
  }
  .wapp-mt__row:focus-visible { outline: 2px solid var(--color-brand); outline-offset: -2px; }
  .wapp-mt__row:last-child td { border-bottom: 0; }
  .wapp-mt__table td.wapp-mt__rank { width: 40px; color: var(--color-muted); text-align: left; }
  .wapp-mt__token { min-width: 220px; text-align: left; }
  .wapp-mt__cell { display: flex; align-items: center; gap: 8px; }
  .wapp-mt__logo { width: 24px; height: 24px; font-size: 9px; }
  .wapp-mt__names { display: grid; min-width: 0; }
  .wapp-mt__line { display: flex; align-items: baseline; gap: 6px; }
  .wapp-mt__line strong { font-size: 12.5px; }
  .wapp-mt__line small, .wapp-mt__fullname { font-size: 10.5px; line-height: 1.25; color: var(--color-muted); }
  .wapp-mt__fullname { display: block; max-width: 170px; overflow: hidden; text-overflow: ellipsis; }
  .wapp-mt__chain { flex: none; width: 14px; height: 14px; margin-left: auto; border-radius: 50%; }
  .wapp-mt__num.is-up { color: #1b8a4b; }
  .wapp-mt__num.is-down { color: #b3261e; }
  /* Swap Coins: a narrow swap panel and a chart that takes the rest of the screen */
  [data-sw-panel='swap'] .wapp__grid--trade { grid-template-columns: minmax(300px, 380px) minmax(0, 1fr); }
  @media (max-width: 960px) { [data-sw-panel='swap'] .wapp__grid--trade { grid-template-columns: minmax(0, 1fr); } }
  [data-sw-panel='swap'] .wapp__chart-plot { min-height: 460px; }
  [data-sw-panel='swap'] .wapp__chart-frame { height: calc(100% + var(--dex-footer-crop)); margin-bottom: 0; }
  /* The frame is taller than its window so DexScreener's footer strip falls outside it; anchor the frame to the TOP so only the footer is cut, not the toolbar. */
  [data-sw-panel='swap'] .wapp__chart-plot { align-items: start; }
  /* Base's own mark is a rounded blue square, not a circle. */
  .wapp__netbtn img[src$='/base.png'] { border-radius: 22%; }
  .wapp__chart { gap: 10px; }
  .wapp__chart-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .wapp__chart-title { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--color-strong); }
  .wapp__chart-title .wapp-avatar { width: 30px; height: 30px; }
  .wapp__chart-title small { font-size: 12px; font-weight: 500; color: var(--color-muted); }
  .wapp__live { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; font-size: 12px; font-weight: 600; color: var(--color-ok); background: rgba(27, 138, 75, 0.1); border-radius: var(--radius-pill); }
  .wapp__live i { width: 7px; height: 7px; background: currentColor; border-radius: 50%; animation: wapp-pulse 1.6s ease-in-out infinite; }
  .wapp__live[hidden] { display: none; }
  @keyframes wapp-pulse { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { .wapp__live i { animation: none; } }
  .wapp__chart-price { display: flex; align-items: baseline; gap: 10px; }
  .wapp__chart-price strong { font-size: 1.8rem; letter-spacing: -0.02em; color: var(--color-strong); }
  .wapp__chart-price span { font-size: 14px; font-weight: 600; }
  .wapp__chart-price .is-up { color: var(--color-ok); }
  .wapp__chart-price .is-down { color: #b3261e; }
  .wapp__chart-plot { position: relative; min-height: 360px; display: grid; align-items: center; overflow: hidden; border-radius: 14px; border: 1px solid var(--color-border); }
  /* The embed ends with a DexScreener footer strip; the plot clips that strip off. Tune the crop here. */
  .wapp__chart { --dex-footer-crop: 46px; }
  .wapp__chart-frame { display: block; width: 100%; height: clamp(520px, 78vh, 700px); margin-bottom: calc(var(--dex-footer-crop) * -1); border: 0; background: #fff; }
  .wapp__chart-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; }
  .wapp__chart-stats:empty { display: none; }
  .wapp__chart-stats > div { display: grid; gap: 2px; padding: 8px 10px; background: var(--color-bg-alt); border-radius: 12px; }
  .wapp__chart-stats dt { font-size: 11px; color: var(--color-muted); }
  .wapp__chart-stats dd { margin: 0; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--color-strong); }
  .wapp__guide { display: grid; gap: 12px; }
  .wapp__guide > summary { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 2px; list-style: none; cursor: pointer; }
  .wapp__guide > summary::-webkit-details-marker { display: none; }
  .wapp__guide > summary h2 { margin: 0; }
  .wapp__guide > summary svg { flex: none; fill: none; stroke: var(--color-muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 160ms ease; }
  .wapp__guide[open] > summary svg { transform: rotate(180deg); }
  .wapp__guide > summary:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 8px; }
  .wapp__guide[open] { gap: 12px; }
  .wapp__guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .wapp__tile { display: grid; align-content: start; gap: 6px; padding: 16px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 18px; }
  .wapp__tile h3 { margin: 0; font-size: 14px; color: var(--color-strong); }
  .wapp__tile p { margin: 0; font-size: 12.5px; line-height: 1.55; color: var(--color-muted); }
  .wapp__tile a { color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
  .wapp__tile .wapp__mint { display: block; font-size: 11px; }
  .wapp__tile-icon { display: grid; place-items: center; width: 34px; height: 34px; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 10px; }
  .wapp__tile-icon svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wapp-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .wapp-table th { padding: 0 10px 10px; text-align: left; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .wapp-table td { padding: 12px 10px; border-top: 1px solid var(--color-border); vertical-align: middle; }
  .wapp-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .wapp-asset { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .wapp-asset > div { display: grid; min-width: 0; }
  .wapp-asset strong { color: var(--color-strong); }
  .wapp-avatar { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--color-brand-soft); color: var(--color-brand); font-size: 11px; font-weight: 700; object-fit: cover; }
  .wapp-flag { margin-left: 4px; padding: 1px 6px; font-size: 10px; font-weight: 600; color: var(--color-warn); background: rgba(178, 94, 9, 0.1); border-radius: var(--radius-pill); }
  .wapp-weight { display: inline-flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; }
  .wapp-bar { display: inline-block; width: 72px; height: 6px; border-radius: 999px; background: var(--color-brand-soft); overflow: hidden; }
  .wapp-bar > span { display: block; height: 100%; background: var(--color-brand); border-radius: inherit; }
  .wapp-status { padding: 3px 10px; font-size: 12px; font-weight: 600; border-radius: var(--radius-pill); }
  .wapp-status.is-ok { color: var(--color-ok); background: rgba(27, 138, 75, 0.1); }
  .wapp-status.is-fail { color: #b3261e; background: rgba(179, 38, 30, 0.1); }
  .wapp-error { margin: 0; padding: 12px 14px; font-size: 13px; color: #b3261e; background: rgba(179, 38, 30, 0.08); border-radius: var(--radius-md); }

  /* Desktop: the sidebar rests as a narrow icon rail and opens, over the page, only while the
     pointer is on it (or keyboard focus is in it). The page never reflows. */
  @media (min-width: 961px) {
    .wapp__side { justify-self: start; width: 248px; overflow-x: hidden; transition: width 200ms ease, box-shadow 200ms ease; }
    .wapp__side .wapp__label, .wapp__side .wapp__brand span, .wapp__side-foot a { white-space: nowrap; }
    html[data-wapp-sidebar='collapsed'][data-wapp-peek] .wapp__side { box-shadow: 12px 0 40px rgba(10, 6, 50, 0.35); }
