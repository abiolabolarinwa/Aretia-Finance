  .wapp__token-btn { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px 8px 8px; font: inherit; font-size: 15px; font-weight: 700; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px; cursor: pointer; }
  .wapp__token-btn:hover { border-color: var(--color-strong); }
  .wapp__token-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
