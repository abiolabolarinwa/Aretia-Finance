  .lh-step.is-current .lh-step__mark, .lh-step.is-busy .lh-step__mark { color: #fff; background: var(--color-brand); }
  .lh-step.is-done .lh-step__mark { color: #fff; background: #1f7a46; animation: lh-pop 320ms cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  @keyframes lh-pop { from { transform: scale(0.6); } to { transform: scale(1); } }
  .lh-step.is-upcoming { background: transparent; }

  .lh__grid { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 22px; align-items: start; }
