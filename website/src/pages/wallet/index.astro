  .wapp-ad__by { font-size: 12px; color: var(--color-muted); }
  .wapp-ad__body { display: flex; gap: 10px; align-items: flex-start; }
  .wapp-ad__img { flex: none; width: 36px; height: 36px; border-radius: 8px; object-fit: cover; background: var(--color-bg-alt); }
  .wapp-ad__text { display: grid; gap: 2px; min-width: 0; }
  .wapp-ad__text strong { font-size: 12.5px; color: var(--color-strong); }
  .wapp-ad__text p { margin: 0; font-size: 12px; line-height: 1.45; color: var(--color-muted); }
  .wapp-ad__cta { justify-self: start; font-size: 12px; font-weight: 600; color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
  .wapp-mt__card > .wapp-ad { max-width: 560px; }

  /* ---- Shield: know before you sign ---- */
  .wapp[data-view='shield'] .wapp__top h1 { display: none; }
  .wapp[data-view='shield'] [data-refresh] { display: none; }
  .wapp[data-view='shield'] .wapp__gate { display: none; }
  .wapp-sh { display: grid; gap: 16px; width: min(1040px, 100%); margin-inline: auto; }
  .wapp-sh [hidden] { display: none !important; }
  .wapp-sh__hero { display: grid; gap: 18px; padding: 30px 32px 26px; color: #fff; background: linear-gradient(135deg, #4a2ee0 0%, #3a22c8 55%, #26168a 100%); border-radius: var(--radius-xl); box-shadow: 0 14px 30px rgba(38, 22, 138, 0.28); }
  .wapp-sh__kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.78); }
  .wapp-sh__title { margin: 4px 0 0; font-family: var(--font-display); font-size: clamp(1.35rem, 2.3vw, 1.7rem); font-weight: 700; letter-spacing: -0.02em; color: #fff; }
  .wapp-sh__lede { max-width: 56ch; margin: 8px 0 0; font-size: 13px; line-height: 1.55; color: rgba(255, 255, 255, 0.86); }
  .wapp-sh__form { display: flex; gap: 8px; align-items: stretch; }
  .wapp-sh__form--small { margin-top: 4px; }
  .wapp-sh__field { position: relative; flex: 1; min-width: 0; display: flex; }
  .wapp-sh__suggest { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 40; display: grid; gap: 2px; margin: 0; padding: 6px; max-height: min(60vh, 420px); overflow-y: auto; list-style: none; text-align: left; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 16px; box-shadow: 0 16px 40px rgba(20, 10, 80, 0.28); }
  .wapp-sh__suggest[hidden] { display: none; }
  .wapp-sh__note { padding: 12px 14px; font-size: 12.5px; color: var(--color-muted); }
  .wapp-sh__sug { display: flex; align-items: center; gap: 12px; padding: 9px 10px; border-radius: 12px; cursor: pointer; }
  .wapp-sh__sug:hover, .wapp-sh__sug[aria-selected='true'] { background: var(--wapp-indigo, #e9e6fc); }
  .wapp-sh__sugpic { flex: none; display: grid; place-items: center; width: 32px; height: 32px; overflow: hidden; font-size: 11px; font-weight: 700; color: var(--color-brand); background: var(--wapp-indigo, #e9e6fc); border-radius: 50%; }
  .wapp-sh__sugpic img { width: 100%; height: 100%; object-fit: cover; }
  .wapp-sh__sugtext { display: grid; flex: 1; min-width: 0; }
  .wapp-sh__sugtext strong { font-size: 14.5px; }
  .wapp-sh__sugtext small, .wapp-sh__sugmeta small { font-size: 12px; color: var(--color-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wapp-sh__sugmeta { display: grid; justify-items: end; gap: 2px; }
  .wapp-sh__sugchain { padding: 1px 8px; font-size: 11px; font-weight: 700; color: #3f3a8a; background: var(--wapp-indigo, #e9e6fc); border-radius: 999px; }
  .wapp-sh__input { flex: 1; min-width: 0; padding: 15px 18px; font-size: 13px; font-family: var(--font-mono); color: var(--color-strong); background: #fff; border: 2px solid transparent; border-radius: 14px; }
  .wapp-sh__input:focus { outline: none; border-color: #b9b0ec; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25); }
  .wapp-sh__go { flex: none; padding: 0 26px; font-size: 13px; color: #190880; background: #fff; border-radius: 14px; }
  .wapp-sh__go:hover { background: #e9e6fc; }
  .wapp-sh__go:disabled { opacity: 0.6; cursor: progress; }
  .wapp-sh__card .wapp-sh__go { padding-block: 12px; color: #fff; background: var(--color-brand); }
  .wapp-sh__card .wapp-sh__go:hover { background: var(--color-brand-bright); }
  .wapp-sh__card .wapp-sh__input { border-color: var(--color-border-strong); font-size: 12.5px; padding: 12px 14px; }
  .wapp-sh__ghost { flex: none; padding: 0 16px; font: inherit; font-size: 12.5px; font-weight: 600; color: #fff; background: rgba(255, 255, 255, 0.14); border: 0; border-radius: 14px; cursor: pointer; }
  .wapp-sh__ghost:hover { background: rgba(255, 255, 255, 0.24); }
  .wapp-sh__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 30px; }
  .wapp-sh__chiphint { font-size: 12px; color: rgba(255, 255, 255, 0.78); }
  .wapp-sh__chip { padding: 6px 12px; font: inherit; font-size: 12px; font-weight: 600; color: #fff; background: rgba(255, 255, 255, 0.14); border: 0; border-radius: 999px; cursor: pointer; }
  .wapp-sh__chip:hover { background: rgba(255, 255, 255, 0.26); }
  .wapp-sh :focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-sh__hero :focus-visible { outline-color: #fff; }

  .wapp-sh__tabs { display: flex; gap: 6px; padding: 5px; width: fit-content; max-width: 100%; background: var(--wapp-indigo, #e9e6fc); border-radius: 14px; }
  .wapp-sh__tab { padding: 9px 18px; font: inherit; font-size: 12.5px; font-weight: 600; color: #3f3a8a; background: transparent; border: 0; border-radius: 10px; cursor: pointer; }
  .wapp-sh__tab[aria-selected='true'] { color: #fff; background: var(--color-brand); }
  .wapp-sh__panel { display: grid; gap: 16px; align-content: start; }

  .wapp-sh__intro { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .wapp-sh__introcard { display: grid; gap: 6px; padding: 18px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 16px; }
  .wapp-sh__introcard strong { color: var(--color-strong); }
  .wapp-sh__introcard span { font-size: 12.5px; line-height: 1.5; color: var(--color-muted); }

  .wapp-sh__card { display: grid; gap: 14px; padding: 22px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); }
  .wapp-sh__h { margin: 0; font-size: 1rem; color: var(--color-strong); }
  .wapp-sh__clear { margin: 0; padding: 12px 14px; font-size: 12.5px; color: var(--color-muted); background: var(--wapp-indigo, #e9e6fc); border-radius: 12px; }
  .wapp-sh__pad { padding: 0 4px; }
  .wapp-sh__verdict { padding: 0; overflow: hidden; gap: 0; }
  .wapp-sh__verdict > :not(.wapp-sh__bar) { margin: 0; padding-inline: 22px; }
  .wapp-sh__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; padding: 20px 22px; }
  .wapp-sh__bar--green { color: #fff; background: #1b8a4b; }
  .wapp-sh__bar--yellow { color: #2b2200; background: #f0be00; }
  .wapp-sh__bar--orange { color: #fff; background: #d9610a; }
  .wapp-sh__bar--red { color: #fff; background: #c62a1f; }
  .wapp-sh__bar--grey { color: #fff; background: #8d8aa8; min-height: 56px; }
  .wapp-sh__bandword { font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; }
  .wapp-sh__headline { flex: 1 1 320px; margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .wapp-sh__loading { overflow: hidden; padding: 0; gap: 0; }
  .wapp-sh__loading .wapp__fine { margin: 0; padding: 18px 22px; }
  .wapp-sh__loading .wapp-sh__bar { animation: wapp-sh-pulse 1.2s ease-in-out infinite; }
  @keyframes wapp-sh-pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }
  .wapp-sh__who { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding-block: 18px 6px !important; }
  .wapp-sh__avatar { flex: none; display: grid; place-items: center; width: 52px; height: 52px; overflow: hidden; font-size: 13px; font-weight: 700; color: var(--color-brand); background: var(--wapp-indigo, #e9e6fc); border-radius: 50%; }
  .wapp-sh__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .wapp-sh__names { display: grid; gap: 3px; min-width: 0; flex: 1 1 260px; }
  .wapp-sh__names strong { font-size: 1rem; color: var(--color-strong); overflow-wrap: anywhere; }
  .wapp-sh__sub { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; color: var(--color-muted); }
  .wapp-sh__value { font-size: 12px; color: var(--color-muted); overflow-wrap: anywhere; }
  .wapp-sh__link { font-size: 12px; font-weight: 600; color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
  .wapp-sh__facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; margin-block: 14px !important; margin-inline: 22px !important; padding: 0 !important; overflow: hidden; background: var(--wapp-indigo-line, #cdc6f3); border: 1px solid var(--wapp-indigo-line, #cdc6f3); border-radius: 12px; }
  .wapp-sh__facts > div { display: grid; gap: 2px; padding: 10px 14px; background: var(--color-bg); }
  .wapp-sh__facts dt { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-muted); }
  .wapp-sh__facts dd { margin: 0; font-size: 14.5px; font-weight: 600; color: var(--color-strong); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .wapp-sh__findings { list-style: none; display: grid; gap: 4px; padding: 0 12px !important; margin-block: 4px 10px !important; }
  .wapp-sh__finding { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 12px; border-radius: 12px; }
  .wapp-sh__finding--bad { background: rgba(198, 42, 31, 0.08); }
  .wapp-sh__finding--warn { background: rgba(238, 112, 14, 0.09); }
  .wapp-sh__finding--note { background: rgba(240, 190, 0, 0.12); }
  .wapp-sh__glyph { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; }
  .wapp-sh__glyph svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wapp-sh__finding--bad .wapp-sh__glyph { color: #c62a1f; }
  .wapp-sh__finding--warn .wapp-sh__glyph { color: #d9610a; }
  .wapp-sh__finding--note .wapp-sh__glyph { color: #9a7600; }
  .wapp-sh__finding--ok .wapp-sh__glyph { color: #1b8a4b; }
  .wapp-sh__finding--info .wapp-sh__glyph { color: var(--color-muted); }
  .wapp-sh__ftext { display: grid; gap: 3px; min-width: 0; }
  .wapp-sh__ftext strong { font-size: 14.5px; line-height: 1.4; color: var(--color-strong); }
  .wapp-sh__fdetail { font-size: 12.5px; line-height: 1.5; color: var(--color-muted); overflow-wrap: anywhere; }
  .wapp-sh__ftag { align-self: start; padding: 2px 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 999px; white-space: nowrap; }
  .wapp-sh__finding--bad .wapp-sh__ftag { color: #8a1c14; border-color: rgba(198, 42, 31, 0.3); }
  .wapp-sh__finding--warn .wapp-sh__ftag { color: #7a3300; border-color: rgba(238, 112, 14, 0.35); }
  .wapp-sh__cannot { margin-block: 4px 12px !important; font-size: 12.5px; color: var(--color-muted); }
  .wapp-sh__cannot summary { cursor: pointer; font-weight: 600; color: var(--color-brand); }
  .wapp-sh__cannot ul { margin: 8px 0 0; padding-left: 20px; display: grid; gap: 4px; line-height: 1.5; }
  .wapp-sh__actions, .wapp-sh__rowactions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .wapp-sh__actions { padding-block: 6px 14px !important; }
  .wapp-sh__rowactions { margin-top: 6px; }
  .wapp-sh__action { padding: 9px 16px; font: inherit; font-size: 12.5px; font-weight: 600; color: var(--color-brand); background: var(--wapp-indigo, #e9e6fc); border: 0; border-radius: 999px; cursor: pointer; }
  .wapp-sh__action:hover { background: var(--wapp-indigo-line, #cdc6f3); }
  .wapp-sh__action:disabled { opacity: 0.6; cursor: progress; }
  .wapp-sh__action--primary { color: #fff; background: var(--color-brand); }
  .wapp-sh__action--primary:hover { background: var(--color-brand-bright); }
  .wapp-sh__action[aria-pressed='true'] { color: #fff; background: #3a22c8; }
  .wapp-sh__name { width: 200px; padding: 8px 12px !important; border-radius: 999px !important; }
  .wapp-sh__stamp { padding-block: 0 18px !important; font-size: 12px; color: var(--color-muted); }
  .wapp-sh__watchlist { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .wapp-sh__watch { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px 14px; background: var(--wapp-indigo, #e9e6fc); border-radius: 12px; }
  .wapp-sh__watch .wapp-sh__rowactions { margin: 0; justify-content: flex-end; }
  .wapp-sh__watch .wapp-sh__action { background: var(--color-bg); }
  .wapp-sh__dot { width: 14px; height: 14px; border-radius: 50%; }
  .wapp-sh__dot--green { background: #1b8a4b; }
  .wapp-sh__dot--yellow { background: #f0be00; }
  .wapp-sh__dot--orange { background: #ee700e; }
  .wapp-sh__dot--red { background: #c62a1f; }
  .wapp-sh__dot--grey { background: #9a97b8; }
  .wapp-sh__foot { margin: 0; padding: 0 4px; font-size: 12px; line-height: 1.5; color: var(--color-muted); }
  .wapp-sh .wapp__state--green { color: #0b5f33; background: rgba(27, 138, 75, 0.16); }
  @media (max-width: 760px) {
    .wapp-sh__hero { padding: 22px 18px; }
    .wapp-sh__form { flex-wrap: wrap; }
    .wapp-sh__input { flex-basis: 100%; }
    .wapp-sh__go { flex: 1; padding: 13px 20px; }
    .wapp-sh__intro { grid-template-columns: 1fr; }
    .wapp-sh__finding { grid-template-columns: auto minmax(0, 1fr); }
    .wapp-sh__ftag { display: none; }
    .wapp-sh__watch { grid-template-columns: auto minmax(0, 1fr); }
    .wapp-sh__watch .wapp-sh__rowactions { grid-column: 1 / -1; justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .wapp-sh__loading .wapp-sh__bar { animation: none; } }

  /* ---- Notification bell (sidebar) and its list ---- */
  .wapp__lock { position: relative; }
  .wapp__bell-count { position: absolute; top: 4px; left: 28px; min-width: 17px; padding: 1px 5px; box-sizing: border-box; font-size: 10.5px; font-weight: 700; line-height: 15px; text-align: center; color: #fff; background: #e5484d; border-radius: 999px; box-shadow: 0 0 0 2px #2a1a9a; }
  .wapp__bell-count[hidden] { display: none; }
  .wapp__lock[data-lock-on='true']::after { content: ''; position: absolute; top: 9px; left: 26px; width: 8px; height: 8px; background: #3ddc84; border-radius: 50%; box-shadow: 0 0 0 2px #2a1a9a; }
  .wapp-bell-pop { position: fixed; left: 258px; bottom: 16px; z-index: 90; display: flex; flex-direction: column; box-sizing: border-box; width: min(380px, calc(100vw - 280px)); max-height: min(600px, calc(100vh - 32px)); overflow: hidden; background: var(--color-bg); border: 1px solid var(--wapp-indigo-line, var(--color-border)); border-radius: 16px; box-shadow: 0 24px 60px -12px rgba(10, 6, 50, 0.45); }
  .wapp-bell-pop[hidden] { display: none; }
  .wapp-bell__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px 10px; }
  .wapp-bell__title { margin: 0; font-size: 1rem; color: var(--color-strong); }
  .wapp-bell__actions { display: flex; gap: 12px; }
  .wapp-bell__link { padding: 0; font: inherit; font-size: 12px; font-weight: 600; color: var(--color-brand); background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .wapp-bell__link:disabled { color: var(--color-muted); cursor: default; text-decoration: none; opacity: 0.6; }
  .wapp-bell__link:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 4px; }
  .wapp-bell__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 8px 8px; }
  .wapp-bell__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .wapp-bell__item { display: flex; gap: 10px; align-items: flex-start; padding: 10px 10px; border-radius: 12px; border-left: 3px solid transparent; }
  .wapp-bell__item.is-unread { background: var(--wapp-indigo, var(--color-brand-soft)); }
  .wapp-po__form { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; }
  .wapp-po__form select, .wapp-po__form input { flex: 1 1 140px; min-width: 0; padding: 9px 10px; border: 1px solid var(--wapp-line, #d9dce8); border-radius: 10px; font: inherit; background: #fff; }
  .wapp-po__list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px; }
  .wapp-po__list li { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 0.85rem; }
  .wapp-bell__item.is-link { cursor: pointer; }
  .wapp-bell__item.is-link:hover, .wapp-bell__item.is-link:focus-visible { background: var(--wapp-indigo, var(--color-brand-soft)); outline: none; }
  .wapp-bell__item--up { border-left-color: #1b8a4b; }
  .wapp-bell__item--down { border-left-color: #c62a1f; }
  .wapp-bell__img { flex: none; width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: var(--color-bg-alt); }
  .wapp-bell__text { display: grid; gap: 2px; min-width: 0; }
  .wapp-bell__text strong { font-size: 12.5px; color: var(--color-strong); }
  .wapp-bell__text span { font-size: 12px; font-variant-numeric: tabular-nums; color: var(--color-muted); }
  .wapp-bell__when { font-size: 12px; color: var(--color-muted); }
  .wapp-bell__empty { margin: 0; padding: 22px 12px 26px; font-size: 12.5px; line-height: 1.5; color: var(--color-muted); }
  .wapp-bell__foot { display: grid; gap: 8px; padding: 12px 16px 14px; background: var(--wapp-indigo, var(--color-bg-alt)); border-top: 1px solid var(--wapp-indigo-line, var(--color-border)); }
  .wapp-bell__sound { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--color-strong); }
  .wapp-bell__foot .wapp-bell__link { justify-self: start; }
  .wapp-bell__note { margin: 0; font-size: 12px; line-height: 1.4; color: var(--color-muted); }
  @media (max-width: 960px) { .wapp-bell-pop { left: 16px; right: 16px; width: auto; bottom: 16px; } }

  /* ---- The optional lock: its settings window and the lock screen ---- */
  .wapp-lockdlg { box-sizing: border-box; width: min(480px, calc(100vw - 32px)); max-height: calc(100vh - 32px); padding: 0; color: var(--color-strong); background: var(--color-bg); border: 0; border-radius: var(--radius-xl); box-shadow: 0 24px 80px rgba(10, 6, 50, 0.4); }
  .wapp-lockdlg::backdrop { background: rgba(15, 12, 40, 0.55); }
  .wapp-lockdlg__body { display: grid; gap: 14px; padding: 22px; }
  .wapp-lockdlg__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .wapp-lockdlg__head h2 { margin: 0; font-size: 1rem; }
  .wapp-lockdlg__who { margin: 2px 0 0; font-size: 12px; font-family: var(--font-mono); color: var(--color-muted); }
  .wapp-lockdlg__close { flex: none; display: grid; place-items: center; width: 34px; height: 34px; padding: 0; color: var(--color-strong); background: var(--color-bg-alt); border: 0; border-radius: 50%; cursor: pointer; }
  .wapp-lockdlg__close:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-lockdlg__line { margin: 0; font-size: 12.5px; line-height: 1.55; color: var(--color-muted); }
  .wapp-lockdlg__fine { margin: 0; padding-top: 12px; font-size: 12px; line-height: 1.5; color: var(--color-muted); border-top: 1px solid var(--color-border); }
  .wapp-lockdlg__ok { margin: 0; padding: 10px 12px; font-size: 12.5px; font-weight: 600; color: #0b5f33; background: rgba(27, 138, 75, 0.12); border-radius: 10px; }
  .wapp-lockdlg__err, .wapp-lockscreen__say { margin: 0; min-height: 1.2em; font-size: 12.5px; color: #b3261e; }
  .wapp-lockdlg__form, .wapp-lockdlg__fields { display: grid; gap: 12px; }
  .wapp-lockdlg__methods { display: grid; gap: 8px; margin: 0; padding: 0; border: 0; }
  .wapp-lockdlg__methods legend { margin-bottom: 6px; padding: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-muted); }
  .wapp-lockdlg__method { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; cursor: pointer; border: 1.5px solid var(--color-border-strong); border-radius: 14px; }
  .wapp-lockdlg__method:has(input:checked) { background: var(--wapp-indigo, var(--color-brand-soft)); border-color: var(--color-brand); }
  .wapp-lockdlg__method:focus-within { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-lockdlg__method span { display: grid; gap: 2px; }
  .wapp-lockdlg__method small { font-size: 12px; color: var(--color-muted); }
  .wapp-lockdlg__field { display: grid; gap: 6px; font-size: 12.5px; color: var(--color-muted); }
  .wapp-lockdlg__row { display: flex; flex-wrap: wrap; gap: 10px; }
  .wapp-lockscreen { box-sizing: border-box; position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 24px; border: 0; background: linear-gradient(180deg, #2c1a9c 0%, #1d1170 100%); }
  .wapp-lockscreen[open] { display: grid; place-items: center; }
  .wapp-lockscreen::backdrop { background: #1d1170; }
  .wapp-lockscreen__box { display: grid; justify-items: center; gap: 14px; box-sizing: border-box; width: min(400px, 100%); padding: 32px 28px; text-align: center; color: var(--color-strong); background: var(--color-bg); border-radius: 22px; box-shadow: 0 30px 90px rgba(5, 2, 40, 0.5); }
  .wapp-lockscreen__mark { width: 40px; height: 40px; }
  .wapp-lockscreen__box h2 { margin: 0; font-size: 1.05rem; }
  .wapp-lockscreen__who { margin: 0; font-size: 12.5px; font-family: var(--font-mono); color: var(--color-muted); }
  .wapp-lockscreen__form { display: grid; gap: 10px; width: 100%; }
  .wapp-lockscreen__box > .wapp__btn { width: 100%; }
  .wapp-lockscreen__say { text-align: center; }
  .wapp-lockscreen__link { padding: 0; font: inherit; font-size: 12.5px; font-weight: 600; color: var(--color-brand); background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .wapp-lockscreen__link:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 3px; border-radius: 4px; }
  .wapp-lockscreen__reset { display: grid; gap: 10px; justify-items: center; padding: 14px; width: 100%; box-sizing: border-box; font-size: 12.5px; line-height: 1.5; color: var(--color-muted); background: var(--wapp-indigo, var(--color-bg-alt)); border-radius: 12px; }
  .wapp-lockscreen__reset[hidden] { display: none; }
  .wapp-lockscreen__reset p { margin: 0; }
  .wapp-lockscreen__fine { margin: 0; font-size: 12px; line-height: 1.5; color: var(--color-muted); }

  /* ---- Price-alert pop-up (two seconds, then gone) and the Favourites page's alert list ---- */
  .wapp-toasts { position: fixed; right: 20px; bottom: 20px; z-index: 300; display: grid; justify-items: end; pointer-events: none; }
  .wapp-toast { display: flex; align-items: center; gap: 10px; min-width: 220px; max-width: min(360px, calc(100vw - 40px)); padding: 12px 16px; color: #fff; background: var(--color-strong); border-radius: 14px; border-left: 4px solid #8f8bd6; box-shadow: 0 18px 50px -12px rgba(10, 6, 50, 0.55); animation: wapp-toast-in 160ms ease-out; }
  .wapp-toast--up { border-left-color: #2fbf71; }
  .wapp-toast--down { border-left-color: #ef5b50; }
  .wapp-toast img { flex: none; width: 28px; height: 28px; border-radius: 50%; background: #fff; object-fit: cover; }
  .wapp-toast div { display: grid; gap: 2px; min-width: 0; }
  .wapp-toast strong { font-size: 12.5px; }
  .wapp-toast span { font-size: 12px; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, 0.78); }
  @keyframes wapp-toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .wapp-alerts { display: grid; gap: 8px; margin-top: 4px; }
  .wapp-alerts__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; font-size: 12px; font-variant-numeric: tabular-nums; }
  .wapp-alerts__list .is-up { color: #1b8a4b; }
  .wapp-alerts__list .is-down { color: #b3261e; }
  /* Token cards: a grid of squares, each one a whole token at a glance. */
  .wapp__tokengrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; }
  .wapp__tokencard { display: grid; grid-template-rows: auto auto 1fr auto; gap: 10px; aspect-ratio: 1 / 1; min-width: 0; padding: 14px; font: inherit; text-align: left; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border); border-top: 3px solid var(--color-border-strong); border-radius: 16px; cursor: pointer; transition: box-shadow 140ms ease, transform 140ms ease; }
  .wapp__tokencard:hover { box-shadow: 0 6px 18px rgba(20, 10, 80, 0.1); transform: translateY(-1px); }
  .wapp__tokencard:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp__tokencard--warn { border-top-color: #d08a1f; }
  .wapp__tokencard--bad { border-top-color: #b3261e; }
  .wapp__tokencard-head { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .wapp__tokencard-logo { width: 40px; height: 40px; font-size: 12px; }
  .wapp__tokencard-name { display: grid; min-width: 0; }
  .wapp__tokencard-name strong { overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .wapp__tokencard-name small { overflow: hidden; font-size: 12px; color: var(--color-muted); text-overflow: ellipsis; white-space: nowrap; }
  .wapp__tokencard-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .wapp__tokencard-chain { padding: 3px 10px; font-size: 12px; font-weight: 600; color: var(--color-brand); background: var(--color-brand-soft); border-radius: var(--radius-pill); }
  .wapp__tokencard-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: 8px 10px; margin: 0; }
  .wapp__tokencard-stats dt { font-size: 11px; color: var(--color-muted); }
  .wapp__tokencard-stats dd { margin: 0; overflow: hidden; font-size: 12.5px; font-weight: 600; font-variant-numeric: tabular-nums; text-overflow: ellipsis; white-space: nowrap; }
  .wapp__tokencard-foot { overflow: hidden; font-size: 11px; color: var(--color-muted); text-overflow: ellipsis; white-space: nowrap; }
  .wapp[data-connected='false'][data-view='shield'] .wapp__gate,
  .wapp[data-connected='false'][data-view='radar'] .wapp__gate,
  .wapp[data-view='shield'] [data-refresh], .wapp[data-view='radar'] [data-refresh] { display: none; }
  .wapp-rd__chains { display: flex; flex-wrap: wrap; gap: 8px; }
  .wapp-rd__chains[hidden] { display: none; }
  .wapp-rd__chain { padding: 6px 12px; font: inherit; font-size: 12px; color: var(--color-strong); background: var(--color-bg); border: 1.5px solid var(--color-border-strong); border-radius: 999px; cursor: pointer; }
  .wapp-rd__chain[aria-pressed='true'] { color: #fff; background: var(--color-brand); border-color: var(--color-brand); }
  .wapp-rd__chain:focus-visible, .wapp-rd__row:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-rd__asset { gap: 14px; }
  .wapp-rd__head, .wapp-rd__sec-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .wapp-rd__addr { display: block; margin-top: 2px; font-size: 11.5px; color: var(--color-muted); overflow-wrap: anywhere; }
  .wapp-rd__title { margin: 0; font-size: 1.05rem; color: var(--color-strong); }
  .wapp-rd__pill { display: inline-block; padding: 3px 10px; font-size: 12px; font-weight: 600; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px; white-space: nowrap; }
  .wapp-rd__pill--warn { color: #150681; background: rgba(42, 20, 176, 0.08); border-color: transparent; }
  .wapp-rd__pill--bad { color: #8a1c1c; background: rgba(190, 40, 40, 0.12); border-color: transparent; }
  .wapp-rd__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; }
  .wapp-rd__tile { display: grid; gap: 2px; padding: 10px 12px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .wapp-rd__tile strong { font-size: 1.05rem; color: var(--color-strong); }
  .wapp-rd__tile-label { font-size: 12px; font-weight: 600; color: var(--color-muted); }
  .wapp-rd__tile-note { font-size: 11px; color: var(--color-muted); }
  .wapp-rd__kv { display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; margin: 0; font-size: 12px; }
  .wapp-rd__kv dt { color: var(--color-muted); }
  .wapp-rd__kv dd { margin: 0; text-align: right; color: var(--color-strong); }
  .wapp-rd__banner { margin: 0; padding: 10px 12px; font-size: 12px; line-height: 1.5; color: #1c3fa8; background: rgba(28, 63, 168, 0.08); border-radius: var(--radius-md); }
  .wapp-rd__banner--warn { color: #150681; background: rgba(42, 20, 176, 0.08); }
  .wapp-rd__actions { display: grid; gap: 6px; justify-items: start; }
  .wapp-rd__home { display: grid; gap: 8px; }
  .wapp-rd__row { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 12px; font: inherit; text-align: left; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); cursor: pointer; }
  .wapp-rd__row-main { display: grid; flex: 1; min-width: 0; }
  .wapp-rd__row-nums { display: grid; font-size: 12px; color: var(--color-muted); text-align: right; }
  .wapp[data-connected='false']:is([data-view='swings'], [data-view='swap']) .wapp__gate { display: none; }
  .wapp:is([data-view='swings'], [data-view='swap']) [data-refresh] { display: none; }
  .wapp__seg [role='tab'][aria-selected='true'] { color: #fff; background: var(--color-brand); }
  .wapp__form { display: grid; gap: 10px; }
  .wapp__input { box-sizing: border-box; width: 100%; padding: 12px 14px; font: inherit; font-size: 12.5px; color: var(--color-strong); background: var(--color-bg); border: 1.5px solid var(--color-border-strong); border-radius: var(--radius-md); }
  .wapp__input:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp__examples { display: flex; flex-wrap: wrap; gap: 8px; }
  .wapp__result { display: grid; gap: 10px; margin-top: 4px; padding: 16px; background: var(--color-bg-alt); border-radius: var(--radius-lg); }
  .wapp__result code { font-size: 12px; overflow-wrap: anywhere; }
  .wapp__banner { margin: 0; padding: 10px 12px; font-size: 12px; line-height: 1.5; border-radius: var(--radius-md); }
  .wapp__banner--warn { color: #150681; background: rgba(42, 20, 176, 0.08); }
  .wapp__banner--info { color: #1c3fa8; background: rgba(28, 63, 168, 0.08); }
  .wapp__banner--ok { color: #14663a; background: rgba(27, 138, 75, 0.1); }
  .wapp__banner[hidden] { display: none; }
  .wapp__pick { display: grid; gap: 6px; font-size: 12px; }
  .wapp__pick label { display: flex; align-items: center; gap: 8px; }

  /* Dashboard: the balance and what to do with it first, holdings straight under it, the wallet and tools beside. */
  .wapp-dash { grid-template-columns: minmax(0, 1fr) 340px; gap: 20px; align-items: start; max-width: 1240px; margin-inline: auto; width: 100%; }
  .wapp-dash svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wapp-dash__main, .wapp-dash__side { display: grid; gap: 16px; min-width: 0; align-content: start; }
  .wapp-dash__side { position: sticky; top: calc(var(--nav-height) + 16px); }
  .wapp-dash__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .wapp-dash__hero { position: relative; overflow: hidden; isolation: isolate; display: grid; gap: 20px; padding: 28px; color: #fff; background: linear-gradient(135deg, #4a2ee0 0%, #3a22c8 50%, #26168a 100%); border-radius: var(--radius-xl); box-shadow: 0 18px 40px rgba(38, 22, 138, 0.32); }
  .wapp-dash__hero::before { content: ''; position: absolute; z-index: -1; inset: -40% -10% auto auto; width: 420px; height: 420px; background: radial-gradient(circle, rgba(140, 120, 255, 0.55), rgba(140, 120, 255, 0) 65%); pointer-events: none; }
  .wapp-dash__hero::after { content: ''; position: absolute; z-index: -1; inset: auto auto -50% -8%; width: 360px; height: 360px; background: radial-gradient(circle, rgba(70, 200, 255, 0.22), rgba(70, 200, 255, 0) 65%); pointer-events: none; }
  .wapp-dash__hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .wapp-dash__hero .wapp__eyebrow, .wapp-dash__hero .wapp__sub { color: rgba(255, 255, 255, 0.78); }
  .wapp-dash__hero .wapp__total { margin: 6px 0 4px; font-size: clamp(1.75rem, 3vw, 2.4rem); color: #fff; }
  .wapp-dash__hero .wapp__icon { color: #fff; background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.28); }
  .wapp-dash__hero :focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .wapp-dash__alloc { display: grid; gap: 10px; }
  .wapp-dash__alloc[hidden] { display: none; }
  .wapp-dash__alloc-bar { display: flex; gap: 3px; height: 10px; overflow: hidden; border-radius: 999px; background: rgba(255, 255, 255, 0.14); }
  .wapp-dash__alloc-bar span { display: block; height: 100%; min-width: 4px; border-radius: 999px; }
  .wapp-dash__alloc-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding: 0; list-style: none; font-size: 12px; color: rgba(255, 255, 255, 0.86); }
  .wapp-dash__alloc-legend li { display: inline-flex; align-items: center; gap: 7px; }
  .wapp-dash__alloc-legend i { width: 9px; height: 9px; border-radius: 50%; }
  .wapp-dash__alloc-legend b { font-weight: 600; color: #fff; }
  .wapp-dash__actions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .wapp-dash__action { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 10px 8px; font: inherit; font-size: 12.5px; font-weight: 600; color: #fff; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 18px; cursor: pointer; transition: background-color 160ms ease, transform 160ms ease; }
  .wapp-dash__action span { display: grid; place-items: center; flex: none; width: 32px; height: 32px; color: #26168a; background: #fff; border-radius: 50%; }
  .wapp-dash__action:hover { background: rgba(255, 255, 255, 0.22); transform: translateY(-2px); }
  .wapp-dash__holdings { padding: 22px 22px 16px; }
  .wapp-dash__holdings .wapp-weight { display: flex; width: 100%; max-width: 220px; }
  .wapp-dash__holdings .wapp-bar { flex: 1; width: auto; }
  .wapp-dash__wallet { gap: 10px; }
  .wapp-dash__wallet-name { font-size: 13px; color: var(--color-strong); }
  .wapp-dash__addr { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 8px 8px 12px; background: var(--color-bg-alt); border-radius: var(--radius-md); }
  .wapp-dash__addr code { min-width: 0; font-size: 12px; overflow-wrap: anywhere; color: var(--color-strong); }
  .wapp-dash__copy { flex: none; padding: 7px 12px; font-size: 12px; }
  .wapp-dash__wallet.is-nudged { animation: dash-nudge 1.4s ease; }
  @keyframes dash-nudge { 0%, 60% { box-shadow: 0 0 0 3px var(--color-brand); } 100% { box-shadow: var(--shadow-soft); } }
  .wapp-dash__evm { margin: 0; font-size: 12px; color: var(--color-muted); overflow-wrap: anywhere; }
  .wapp-dash__evm[hidden] { display: none; }
  .wapp-dash__link, .wapp-dash__more { padding: 0; font: inherit; font-size: 12px; color: var(--color-brand); background: none; border: 0; cursor: pointer; text-decoration: none; }
  .wapp-dash__link:hover, .wapp-dash__more:hover { text-decoration: underline; }
  /* The services: a small 3 by 2 matrix in the side column, each tile opens its screen. */
  .wapp-dash__services { gap: 12px; padding: 18px; }
  .wapp-svc__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .wapp-svc__grid li { display: flex; }
  .wapp-svc__tile { display: grid; justify-items: center; align-content: center; gap: 8px; width: 100%; min-height: 92px; padding: 12px 6px; font: inherit; text-align: center; color: var(--color-strong); background: #f6f6fa; border: 1px solid transparent; border-radius: 16px; cursor: pointer; transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }
  .wapp-svc__tile strong { font-size: 12px; font-weight: 600; line-height: 1.2; }
  .wapp-svc__tile:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  @media (hover: hover) { .wapp-svc__tile:hover { background: #fff; border-color: #d9d6f5; box-shadow: 0 8px 18px rgba(38, 22, 138, 0.12); transform: translateY(-2px); } }
  /* Before a wallet is connected only the services are shown, under the Connect card. */
  .wapp[data-connected='false'][data-view='dashboard'] [data-pane='dashboard'] { display: grid; grid-template-columns: minmax(0, 560px); justify-content: center; }
  .wapp[data-connected='false'] .wapp-dash__main, .wapp[data-connected='false'] .wapp-dash__wallet, .wapp[data-connected='false'] .wapp-dash__recent { display: none; }
  .wapp[data-connected='false'] .wapp-dash__side { position: static; }
  .wapp-dash__more:focus-visible, .wapp-dash__link:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-dash__recent-list { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .wapp-dash__recent-list li { display: flex; align-items: center; gap: 10px; padding: 8px 2px; font-size: 12px; border-top: 1px solid var(--color-border); }
  .wapp-dash__recent-list li:first-child { border-top: 0; }
  .wapp-dash__recent-list .wapp-sub { padding: 4px 0; }
  .wapp-dash__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--color-ok); }
  .wapp-dash__dot.is-fail { background: #b3261e; }
  .wapp-dash__recent-list a { color: var(--color-strong); }
  .wapp-dash__recent-list time { margin-left: auto; font-size: 12px; color: var(--color-muted); white-space: nowrap; }

  .wapp__swap { gap: 10px; position: relative; }
  .wapp__swap-box { display: grid; gap: 8px; padding: 14px 16px; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 18px; }
  .wapp__swap-main { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .wapp__token-btn { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px 8px 8px; font: inherit; font-size: 13px; font-weight: 700; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px; cursor: pointer; }
  .wapp__token-btn:hover { border-color: var(--color-strong); }
  .wapp__token-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .wapp__token-btn .wapp-avatar, .wapp__picker-list .wapp-avatar { width: 26px; height: 26px; font-size: 10px; }
  .wapp__swap-amount, .wapp__swap-out { min-width: 0; width: 100%; font: inherit; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; text-align: right; color: var(--color-strong); background: none; border: 0; }
  .wapp__swap-amount:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 8px; }
  .wapp__swap-amount::placeholder { color: var(--color-faint); }
  .wapp__swap-out { overflow-wrap: anywhere; }
  .wapp__swap-quick { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 10px; }
  .wapp__swap-shares { display: flex; gap: 6px; }
  .wapp__swap-shares .wapp__chip { padding: 4px 12px; font-size: 12px; }
  .wapp__swap-shares .wapp__chip:disabled { cursor: not-allowed; opacity: 0.5; }
  .wapp__swap-flip { justify-self: center; display: grid; place-items: center; width: 36px; height: 36px; margin: -18px 0; z-index: 1; color: var(--color-brand); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 50%; cursor: pointer; }
  .wapp__swap-flip svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wapp__swap-flip:hover { border-color: var(--color-brand); }
  .wapp__maxlink, .wapp__linkbtn { padding: 0; font: inherit; font-size: 12px; font-weight: 600; color: var(--color-brand); background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .wapp__linkbtn { font-size: inherit; font-weight: 500; }
  .wapp__maxlink:focus-visible, .wapp__linkbtn:focus-visible, .wapp__token-btn:focus-visible, .wapp__swap-flip:focus-visible, .wapp__picker-list button:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp__slip { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .wapp__slip [aria-pressed='true'] { color: #fff; background: var(--color-brand); }
  .wapp__notes { display: grid; gap: 8px; }
  .wapp__notes:empty { display: none; }
  .wapp__swap-go { width: 100%; padding: 15px 20px; font-size: 13px; }
  .wapp__swap [data-sw-actions] { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .wapp__swap [data-sw-actions] .wapp__btn--primary { flex: 1 1 100%; padding: 15px 20px; font-size: 13px; }
  .wapp__swap [data-sw-actions] .wapp__btn--primary:disabled { cursor: not-allowed; opacity: 0.55; }
  .wapp__swap-go:disabled { cursor: not-allowed; opacity: 0.55; }
  /* The token list is a dropdown under the token button that was pressed, over the rest of the card, not a block further down. */
  /* "Alerts on your phone": the card on the Favourites page that links Telegram and this browser. */
  .wapp-act__token { padding: 0; font: inherit; font-weight: 700; color: var(--color-brand); text-decoration: underline; text-underline-offset: 2px; background: none; border: 0; cursor: pointer; }
  .wapp-act__token:hover { color: var(--color-strong); }
  .wapp-act__token:disabled { cursor: progress; opacity: 0.6; }
  .wapp-pa { display: grid; gap: 10px; padding: 16px 18px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 16px; }
  .wapp-pa__title { margin: 0; font-size: 1rem; }
  .wapp-pa__rows { display: grid; gap: 8px; }
  .wapp-pa__row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .wapp-pa__row > strong { min-width: 110px; }
  .wapp-pa__row select { width: auto; min-width: 90px; padding: 7px 10px; }
  .wapp-pa__on { padding: 3px 10px; font-size: 12px; font-weight: 700; color: #0f6b3a; background: #e2f6ea; border-radius: 999px; }
  .wapp-pa__msg { color: var(--color-strong); }
  .wapp__pick-slot { position: relative; height: 0; }
  .wapp__pick-pop { position: absolute; top: 6px; left: -8px; right: -8px; z-index: 30; display: grid; gap: 8px; max-height: min(380px, 60vh); padding: 10px; overflow-y: auto; background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 16px; box-shadow: 0 18px 44px -12px rgba(10, 6, 50, 0.4); }
  .wapp__picker { position: absolute; inset: 12px; z-index: 5; display: grid; grid-template-rows: auto 1fr; gap: 10px; padding: 14px; background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 18px; box-shadow: var(--shadow-float, 0 18px 40px rgba(20, 10, 80, 0.2)); }
  .wapp__picker[hidden] { display: none; }
  /* The token list opens inside the swap card, so the card must be tall enough for it even when little else is shown. */
  .wapp__swap:has(.wapp__picker:not([hidden])) { min-height: min(520px, calc(100vh - 160px)); }
  .wapp__picker-list { display: grid; align-content: start; gap: 2px; margin: 0; padding: 0; overflow-y: auto; list-style: none; }
  .wapp__picker-list button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; font: inherit; text-align: left; color: var(--color-strong); background: none; border: 0; border-radius: 12px; cursor: pointer; }
  .wapp__picker-list button:hover { background: var(--color-brand-soft); }
  .wapp__picker-name { display: grid; min-width: 0; font-size: 11px; color: var(--color-muted); }
  .wapp__picker-name strong { font-size: 12.5px; color: var(--color-strong); }
  .wapp__picker-bal { margin-left: auto; font-size: 12px; font-variant-numeric: tabular-nums; }
  .wapp__tag { margin-left: 6px; padding: 1px 6px; font-size: 10px; font-weight: 600; border-radius: var(--radius-pill); }
  .wapp__tag--ok { color: var(--color-ok); background: rgba(27, 138, 75, 0.1); }
  .wapp__tag--warn { color: var(--color-warn); background: rgba(42, 20, 176, 0.07); }
  .wapp__trade-side { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-content: start; min-width: 0; }

  .wapp__intro { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--color-muted); max-width: 70ch; }
  .wapp__intro:empty { display: none; }
  .wapp__fineprint { padding: 4px 2px; font-size: 12px; color: var(--color-muted); }
  .wapp__fineprint > summary { cursor: pointer; font-weight: 600; color: var(--color-strong); }
  .wapp__fineprint ul { display: grid; gap: 6px; margin: 10px 0 0; padding-left: 18px; line-height: 1.5; }
  .wapp__steps { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; padding: 0; list-style: none; counter-reset: wstep; font-size: 12px; color: var(--color-muted); }
  .wapp__steps li { counter-increment: wstep; display: inline-flex; align-items: center; gap: 6px; }
  .wapp__steps li::before { content: counter(wstep); display: inline-grid; place-items: center; width: 18px; height: 18px; font-size: 11px; font-weight: 700; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 50%; }
  .wapp__more { padding: 2px 0; font-size: 12px; color: var(--color-muted); }
  .wapp__more > summary { cursor: pointer; font-weight: 600; color: var(--color-brand); }
  .wapp__more > p, .wapp__more > div { margin: 8px 0 0; line-height: 1.5; }
  .wapp__step-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .wapp__step-list li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; align-items: start; font-size: 12.5px; line-height: 1.45; }
  .wapp__step-list .wapp__step-n { display: grid; place-items: center; width: 22px; height: 22px; font-size: 12px; font-weight: 700; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 50%; }
  .wapp__step-list small { display: block; color: var(--color-muted); }
  /* The swap stays in view while the long chart and trade list scroll past it. */
  @media (min-width: 1000px) {
    [data-sw-panel='swap'] .wapp__grid--trade { align-items: start; }
    [data-sw-panel='swap'] .wapp__grid--trade > .wapp__swap { position: sticky; top: 16px; }
  }

  /* ---- Swings layout: network logos in a slim column beside the sidebar, centred tabs, a chart that fills the screen ---- */
  .wapp__rail { display: none; }
  .wapp:is([data-view='swings'], [data-view='swap']) { grid-template-columns: var(--wapp-side) 76px minmax(0, 1fr); }
  .wapp:is([data-view='swings'], [data-view='swap']) .wapp__rail { position: sticky; top: 0; z-index: 40; align-self: start; display: flex; flex-direction: column; align-items: center; gap: 10px; box-sizing: border-box; height: 100vh; padding: calc(var(--nav-height) + 16px) 0 16px; overflow-x: hidden; overflow-y: auto; background: var(--color-bg); border-right: 1px solid var(--color-border); }
  body:has(.wapp:is([data-view='swings'], [data-view='swap'])) .nav--wallet .nav__bar { padding-left: calc(var(--wapp-side, 248px) + 76px + 36px); }
  .wapp__netbtn { position: relative; display: grid; place-items: center; flex: none; width: 48px; height: 48px; padding: 0; background: var(--color-bg-alt); border: 2px solid transparent; border-radius: 50%; cursor: pointer; transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease; }
  .wapp__netbtn img { display: block; width: 36px; height: 36px; object-fit: cover; border-radius: 50%; }
  .wapp__netbtn:hover { transform: scale(1.06); box-shadow: 0 4px 14px rgba(20, 10, 80, 0.16); }
  .wapp__netbtn:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp__netbtn[aria-pressed='true'] { border-color: var(--color-brand); box-shadow: 0 0 0 3px var(--color-brand-soft); }
  .wapp__netbtn[data-off='true'] { opacity: 0.45; filter: grayscale(0.8); }
  .wapp__netbtn[data-off='true']:hover { opacity: 0.8; }
  .wapp__seg--tabs { justify-content: center; gap: 10px; }
  .wapp__seg--tabs .wapp__chip { padding: 9px 18px; font-size: 12.5px; }
  .wapp__seg--sub { justify-content: center; }
  .wapp__intro { margin-inline: auto; text-align: center; }
  /* Search box in the top bar, on the same line as the network and price chips */
  /* ---- The island: a dark pill in the top bar, in the middle by the search box, for the newest tokens ---- */
  .wapp-island { position: relative; z-index: 80; flex: 0 1 auto; width: 250px; height: 40px; margin: 0 auto; }
  .wapp-island__body { position: absolute; top: 0; left: 50%; display: grid; width: 250px; overflow: hidden; color: #fff; background: #0a0a14; border-radius: 20px; box-shadow: 0 6px 22px -8px rgba(10, 6, 50, 0.55); transform: translateX(-50%); transition: width 0.42s cubic-bezier(0.22, 1.2, 0.36, 1), border-radius 0.42s cubic-bezier(0.22, 1.2, 0.36, 1), box-shadow 0.3s ease; }
  .wapp-island.is-open .wapp-island__body { width: 392px; border-radius: 24px; box-shadow: 0 24px 60px -14px rgba(10, 6, 50, 0.6); }
  .wapp-island.is-ping .wapp-island__body { animation: wapp-island-ping 0.9s ease-out 1; }
  @keyframes wapp-island-ping { 0% { box-shadow: 0 0 0 0 rgba(120, 100, 255, 0.7); } 100% { box-shadow: 0 0 0 16px rgba(120, 100, 255, 0); } }
  .wapp-island__head { display: flex; align-items: center; gap: 8px; box-sizing: border-box; width: 100%; height: 40px; padding: 0 14px 0 14px; font: inherit; font-size: 12px; color: inherit; text-align: left; background: none; border: 0; cursor: pointer; }
  .wapp-island__head:focus-visible { outline: 2px solid #a99dff; outline-offset: -3px; border-radius: 20px; }
  .wapp-island__head.is-swap > :not(.wapp-island__dot) { animation: wapp-island-in 0.4s ease both; }
  @keyframes wapp-island-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .wapp-island__dot { flex: none; width: 8px; height: 8px; background: #4ade80; border-radius: 50%; box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.7); animation: wapp-island-pulse 1.8s ease-out infinite; }
  @keyframes wapp-island-pulse { 0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6); } 70%, 100% { box-shadow: 0 0 0 7px rgba(74, 222, 128, 0); } }
  .wapp-island__idle { overflow: hidden; color: #c9c7e6; text-overflow: ellipsis; white-space: nowrap; }
  .wapp-island__pic, .wapp-island__big { flex: none; display: grid; place-items: center; object-fit: cover; font-size: 9px; font-weight: 700; color: #fff; background: #3b2fc9; border-radius: 50%; }
  .wapp-island__pic { width: 22px; height: 22px; }
  .wapp-island__big { width: 40px; height: 40px; font-size: 12px; }
  .wapp-island__label { display: flex; flex: 1; align-items: baseline; gap: 8px; min-width: 0; overflow: hidden; white-space: nowrap; }
  .wapp-island__label strong { overflow: hidden; text-overflow: ellipsis; }
  .wapp-island__price { color: #c9c7e6; font-variant-numeric: tabular-nums; }
  .wapp-island__chain { flex: none; width: 14px; height: 14px; border-radius: 50%; }
  .wapp-island__chev { flex: none; width: 7px; height: 7px; margin-left: 2px; border: solid #c9c7e6; border-width: 0 2px 2px 0; transform: rotate(45deg) translateY(-2px); transition: transform 0.3s ease; }
  .wapp-island.is-open .wapp-island__chev { transform: rotate(-135deg) translateY(-2px); }
  .wapp-island__more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.42s cubic-bezier(0.22, 1.2, 0.36, 1); }
  .wapp-island.is-open .wapp-island__more { grid-template-rows: 1fr; }
  .wapp-island__inner { display: grid; gap: 12px; min-height: 0; padding: 0 16px; overflow: hidden; opacity: 0; transition: opacity 0.25s ease, padding 0.42s ease; }
  .wapp-island.is-open .wapp-island__inner { padding: 4px 16px 14px; opacity: 1; transition-delay: 0.08s; }
  .wapp-island__top { display: flex; align-items: center; gap: 10px; }
  .wapp-island__names { display: grid; flex: 1; min-width: 0; }
  .wapp-island__names strong { overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .wapp-island__sub { overflow: hidden; font-size: 12px; color: #b7b4dc; text-overflow: ellipsis; white-space: nowrap; }
  .wapp-island__rating { flex: none; padding: 3px 9px; font-size: 11px; font-weight: 700; color: #1a1450; background: #ece9ff; border-radius: 999px; }
  .wapp-island__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .wapp-island__stat { display: grid; gap: 2px; padding: 8px 10px; background: rgba(255, 255, 255, 0.08); border-radius: 12px; }
  .wapp-island__stat span { font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #b7b4dc; }
  .wapp-island__stat strong { font-size: 12.5px; font-variant-numeric: tabular-nums; }
  .wapp-island__actions { display: flex; align-items: center; gap: 8px; }
  .wapp-island__buy { flex: 1; height: 38px; font: inherit; font-size: 12.5px; font-weight: 700; color: #fff; background: #5a48ff; border: 0; border-radius: 999px; cursor: pointer; transition: background 0.2s ease, transform 0.15s ease; }
  .wapp-island__buy:hover { background: #6f5fff; }
  .wapp-island__buy:active { transform: scale(0.98); }
  .wapp-island__view { height: 38px; padding: 0 16px; font: inherit; font-size: 12px; font-weight: 600; color: #fff; background: rgba(255, 255, 255, 0.12); border: 0; border-radius: 999px; cursor: pointer; }
  .wapp-island__view:hover { background: rgba(255, 255, 255, 0.2); }
  .wapp-island__closed { flex: 1; font-size: 12px; color: #b7b4dc; }
  .wapp-island__foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 11px; line-height: 1.35; color: #9693c4; }
  .wapp-island__pager { display: inline-flex; flex: none; align-items: center; gap: 6px; font-variant-numeric: tabular-nums; }
  .wapp-island__step { width: 22px; height: 22px; padding: 0; font: inherit; font-size: 13px; line-height: 1; color: #fff; background: rgba(255, 255, 255, 0.12); border: 0; border-radius: 50%; cursor: pointer; }
  .wapp-island__note { margin: 0; font-size: 12px; line-height: 1.45; color: #c9c7e6; }
  @media (max-width: 1080px) { .wapp__top .wapp-island { order: 2; flex-basis: 100%; width: 100%; max-width: none; margin: 8px 0 0; } .wapp__top .wapp-island__body { width: min(250px, 100%); } .wapp__top .wapp-island.is-open .wapp-island__body { width: min(392px, 100%); } }
  @media (prefers-reduced-motion: reduce) { .wapp-island *, .wapp-island { animation: none !important; transition: none !important; } }
  .wapp-search { position: relative; flex: 1 1 auto; min-width: 200px; max-width: 560px; margin: 0 auto; }
  .wapp-search__icon { position: absolute; left: 14px; top: 50%; display: grid; color: var(--color-muted); transform: translateY(-50%); pointer-events: none; }
  .wapp-search__icon svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .wapp-search__input { box-sizing: border-box; width: 100%; height: 40px; padding: 0 14px 0 38px; font: inherit; font-size: 12.5px; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px; }
  .wapp-search__input:focus { outline: 2px solid var(--color-brand); outline-offset: 1px; }
  .wapp-search__list { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 90; display: grid; gap: 2px; max-height: min(70vh, 460px); margin: 0; padding: 6px; overflow-y: auto; list-style: none; background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 16px; box-shadow: 0 16px 40px rgba(20, 10, 80, 0.18); }
  .wapp-search__list[hidden] { display: none; }
  .wapp-search__note { padding: 10px 12px; font-size: 12px; color: var(--color-muted); }
  .wapp-search__item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; font: inherit; text-align: left; color: var(--color-strong); background: none; border: 0; border-radius: 12px; cursor: pointer; }
  .wapp-search__row[aria-selected='true'] .wapp-search__item, .wapp-search__item:hover { background: var(--color-brand-soft); }
  .wapp-search__logo { width: 28px; height: 28px; font-size: 10px; }
  .wapp-search__text { display: grid; flex: 1; min-width: 0; }
  .wapp-search__text strong { font-size: 12.5px; }
  .wapp-search__text small { overflow: hidden; font-size: 12px; color: var(--color-muted); text-overflow: ellipsis; white-space: nowrap; }
  .wapp-search__side { display: grid; justify-items: end; gap: 2px; font-size: 11px; color: var(--color-muted); }
  .wapp-search__new { padding: 1px 8px; font-size: 11px; font-weight: 700; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 999px; }
  @media (max-width: 1080px) { .wapp__top .wapp-search { order: 3; flex-basis: 100%; max-width: none; } .wapp__top { flex-wrap: wrap; } }
  @media (max-width: 960px) {
    .wapp:is([data-view='swings'], [data-view='swap']) { grid-template-columns: minmax(0, 1fr); }
    .wapp:is([data-view='swings'], [data-view='swap']) .wapp__rail { position: static; flex-direction: row; height: auto; padding: 10px 16px; overflow-x: auto; overflow-y: hidden; border-right: 0; border-bottom: 1px solid var(--color-border); }
    body:has(.wapp:is([data-view='swings'], [data-view='swap'])) .nav--wallet .nav__bar { padding-left: 16px; }
  }

  /* Swings: no page title; the tabs sit in the top bar beside the search box; the chart takes the freed space */
  .wapp:is([data-view='swings'], [data-view='swap']) .wapp__top h1 { display: none; }
  .wapp:is([data-view='swings'], [data-view='swap']) .wapp__top:not(:has(.wapp__chips, .wapp-search, .wapp__seg--tabs)) { display: none; }
  .nav__bar > .wapp__seg--tabs { flex: none; flex-wrap: nowrap; gap: 6px; margin: 0 0 0 12px; }
  .nav__bar > .wapp__seg--tabs .wapp__chip { padding: 7px 11px; font-size: 12px; white-space: nowrap; }
  body:not(:has(.wapp[data-view='swings'])) .nav__bar > .wapp__seg--tabs { display: none; }
  .nav__bar > .wapp-search { flex: 1 1 280px; min-width: 170px; max-width: 380px; margin: 0; }
  [data-sw-panel='swap'] .wapp__chart-plot { height: calc(100vh - 300px); }

  .wapp[data-view='swap'] [data-sw-tabs], .wapp[data-view='swap'] [data-sw-intro] { display: none; }

  /* ---- Pay: three ways to move money, as cards ---- */
  .wapp-pay__hub { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .wapp-pay__card { display: flex; align-items: center; gap: 14px; padding: 16px 18px; font: inherit; text-align: left; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); cursor: pointer; transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease; }
  .wapp-pay__card:hover { transform: translateY(-1px); border-color: var(--color-border-strong); }
  .wapp-pay__card:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .wapp-pay__card[aria-selected='true'] { border-color: var(--color-brand); box-shadow: 0 0 0 3px var(--color-brand-soft); }
  .wapp-pay__icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 14px; }
  .wapp-pay__icon svg { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .wapp-pay__text { display: grid; gap: 3px; min-width: 0; }
  .wapp-pay__text strong { font-size: 13px; }
  .wapp-pay__text span { font-size: 12px; line-height: 1.4; color: var(--color-muted); }
  @media (max-width: 860px) { .wapp-pay__hub { grid-template-columns: minmax(0, 1fr); } }
  /* Pay is a few forms, not a dashboard: on a wide screen it stays one readable column, centred, instead of stretching edge to edge. */
  .wapp-pay { width: 100%; max-width: 1080px; justify-self: center; }
  .wapp-pay [data-pay-panel='ramp'], .wapp-pay [data-pay-panel='transfer'] { width: 100%; max-width: 680px; justify-self: center; }
  /* The page title lines up with the centred column below it. */
  .wapp[data-view='send'] .wapp__top h1 { width: 100%; max-width: 1080px; margin-inline: auto; }
  @media (min-width: 961px) { .wapp-pay [data-pay-panel='send'] .wapp__grid--trade { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  /* The panes that are mostly text and one form keep to a readable width too. Dashboard, Markets and Shield have their own layouts. */
  .wapp__pane[data-pane='referrals'] { width: 100%; max-width: 760px; justify-self: center; }
  .wapp__pane[data-pane='activity'] { width: 100%; max-width: 1080px; justify-self: center; }
  .wapp__pane:is([data-pane='radar'], [data-pane='carbon'], [data-pane='launch'], [data-pane='safesend']) { width: 100%; max-width: 1120px; justify-self: start; }
  .wapp__pane[data-pane='launchbox'] { width: 100%; max-width: 1240px; min-width: 0; justify-self: start; }
  /* Radar is one lookup, so it sits in the middle of the page rather than against the sidebar. */
  .wapp__pane[data-pane='radar'] { justify-self: center; }
  @media (min-width: 961px) { .wapp__pane:is([data-pane='radar'], [data-pane='carbon'], [data-pane='launch'], [data-pane='safesend']) .wapp__grid--trade { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); } }

  /* ---- Swap opened over the page it was started from ---- */
  .wapp-swapdlg { position: fixed; inset: 0; z-index: 300; display: grid; place-items: start center; overflow-y: auto; padding: calc(var(--nav-height, 64px) + 12px) 16px 32px; background: rgba(15, 12, 40, 0.5); }
  .wapp-swapdlg[hidden] { display: none; }
  /* Just the swap card, centred over the dimmed page: no second panel behind it and no title. */
  .wapp-swapdlg__box { position: relative; box-sizing: border-box; width: min(440px, 100%); margin-inline: auto; }
  .wapp-swapdlg [data-swap-dialog-slot] .wapp__grid.wapp__grid--trade { grid-template-columns: minmax(0, 1fr); justify-items: stretch; }
  .wapp-swapdlg .wapp__trade-side { display: none; }
  .wapp-swapdlg .wapp__swap { width: 100%; box-shadow: 0 24px 80px rgba(10, 6, 50, 0.35); }
  .wapp-swapdlg__bar { position: absolute; top: 12px; right: 12px; z-index: 3; }
  .wapp-swapdlg__close { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; font: inherit; color: var(--color-strong); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 50%; cursor: pointer; }
  .wapp-swapdlg__close:hover { background: var(--color-brand-soft); }
  .wapp-swapdlg__close:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  body:has(.wapp-swapdlg:not([hidden])) { overflow: hidden; }

  /* ---- Find Tokens and Marketplace: a light table of tokens, one row each ---- */
  .wapp-mt__starcell, .wapp-mt__starhead { width: 28px; padding-right: 0; }
  .wapp-mt__star { padding: 2px 4px; font-size: 14px; line-height: 1; color: var(--color-muted); background: none; border: 0; border-radius: 6px; cursor: pointer; }
  .wapp-mt__star[aria-pressed='true'] { color: #d99a00; }
  .wapp-mt__star:hover { color: #d99a00; }
