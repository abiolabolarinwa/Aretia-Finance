  .wapp__swap-amount, .wapp__swap-out { min-width: 0; width: 100%; font: inherit; font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; text-align: right; color: var(--color-strong); background: none; border: 0; }
  .wapp__swap-amount:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 8px; }
  .wapp__swap-amount::placeholder { color: var(--color-faint); }
