---
import '../styles/global.css';
import { LINKS } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome · Aretia Finance</title>
    <meta name="description" content="Join the Aretia Wallet waitlist, or explore the climate-finance protocol behind ACT." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#f7efe2" />
  </head>
  <body>
    <main class="welcome">
      <a class="welcome__brand" href="/">
        <img src="/assets/logo-mark-green.png" alt="" width="24" height="24" />
        <span>Aretia</span>
      </a>

      <div class="welcome__inner">
        <h1 class="welcome__word">
          <span>Aretia</span>
          <span>Finance</span>
        </h1>
        <p class="welcome__lead">Multichain self-custody, built so every transfer funds a climate treasury.</p>

        <div class="welcome__actions">
          <a class="wbtn wbtn--solid" href={LINKS.walletWaitlist}>Join the Aretia Wallet Waitlist</a>
          <a class="wbtn wbtn--outline" href="/">Explore Aretia Finance</a>
        </div>

        <p class="welcome__note">The wallet's browser extension is in development and not yet on the Chrome Web Store.</p>
      </div>

      <div class="welcome__mark" aria-hidden="true">
        <svg viewBox="0 0 1400 420">
          <polygon points="0,420 180,320 700,420" fill="#0b3d2e" />
          <polygon points="180,320 480,90 700,420" fill="#0f6b4b" />
          <polygon points="480,90 620,230 700,420" fill="#1c8f66" />
          <polygon points="620,230 700,260 700,420" fill="#0b3d2e" />
          <polygon points="700,260 800,160 700,420" fill="#8a6620" />
          <polygon points="800,160 960,70 700,420" fill="#a07a2c" />
          <polygon points="960,70 1200,340 700,420" fill="#c79a4a" />
          <polygon points="1200,340 1400,420 700,420" fill="#0b3d2e" />
          <g fill="#fdf8ef" opacity="0.92">
            <rect x="560" y="195" width="230" height="38" rx="19" transform="rotate(26 675 214)" />
            <rect x="560" y="300" width="230" height="38" rx="19" transform="rotate(-26 675 319)" />
            <rect x="800" y="150" width="38" height="240" rx="19" transform="rotate(14 819 270)" />
          </g>
        </svg>
      </div>
    </main>
  </body>
</html>

<style>
  .welcome {
    position: relative;
    min-height: 100svh;
    background: #f7efe2;
    display: grid;
    place-items: center;
  }

  .welcome__brand {
    position: fixed;
    top: clamp(1.25rem, 3vw, 2rem);
    left: clamp(1.25rem, 3vw, 2rem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-strong);
  }
  .welcome__brand img { border-radius: 6px; }

  .welcome__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
    padding: clamp(4rem, 8vw, 6rem) var(--gutter) clamp(9rem, 14vw, 12rem);
  }

  .welcome__word {
    display: grid;
    line-height: 0.92;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-strong);
  }

  .welcome__lead {
    max-width: 30rem;
    font-size: var(--text-lead);
    /* var(--color-muted) reads 4.44:1 on this page's warm cream, just under
       AA; this shade clears 5.6:1 while staying visually "muted". */
    color: #5e5e61;
  }

  .welcome__actions {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 22rem;
    margin-top: var(--space-sm);
  }

  .wbtn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 1rem;
    transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .wbtn--solid { background: var(--color-strong); color: #fff; box-shadow: var(--shadow-soft); }
  .wbtn--outline { background: #fff; color: var(--color-strong); border: 1px solid var(--color-border-strong); }
  .wbtn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .wbtn--solid:hover { background: var(--color-brand); }
    .wbtn--outline:hover { border-color: var(--color-strong); }
  }

  .welcome__note { font-size: var(--text-micro); color: #5e5e61; max-width: 26rem; }

  .welcome__mark {
    position: fixed;
    z-index: 0;
    left: 50%;
    bottom: -3vh;
    width: max(100%, 900px);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .welcome__mark svg { display: block; width: 100%; height: auto; }
</style>
