{
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tokenomics",
      "destination": "/token",
      "permanent": false
    },
    {
      "source": "/insights",
      "destination": "/details#economics",
      "permanent": false
    },
    {
      "source": "/presale",
      "destination": "/buy",
      "permanent": false
    },
    {
      "source": "/countdown",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wallet/app",
      "destination": "/wallet",
      "permanent": false
    }
  ]
}